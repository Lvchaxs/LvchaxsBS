<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:LvchaxsBS.UI.Helpers">

    <!--
        ============ 基样式：所有按钮基于它 ============
        悬停放大 / 按下缩小由 helpers:InteractionScale 提供（全项目唯一一份交互动画实现），
        模板里只留下纯视觉结构。缩放值写在 Style 上，所以"大幅度版"可以 BasedOn 它、
        只覆盖两个数值 —— 以前是两个各自内联 90 行 Storyboard 的独立样式。
    -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="helpers:InteractionScale.HoverScale" Value="1.06"/>
        <Setter Property="helpers:InteractionScale.PressScale" Value="0.97"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        基样式（大幅度版）：只有悬停/按下的缩放更大（1.15 / 0.95），其余完全继承 BaseButtonStyle。
        目前只给顶部左侧功能栏（TopLeftBar）和顶部中间的 exe 启动按钮用 ——
        这两处的图标按钮按原来的观感保留更明显的放大效果。
        改动这套数值时注意别动到 BaseButtonStyle。
    -->
    <Style x:Key="BaseButtonStyleBigScale"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="helpers:InteractionScale.HoverScale" Value="1.15"/>
        <Setter Property="helpers:InteractionScale.PressScale" Value="0.95"/>
    </Style>

    <!-- ============ 无动画按钮（配置 / 触发键） ============ -->
    <Style x:Key="FlatButtonStyleRound6" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Gray400Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Gray700Brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PressedBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- ============ 1. 普通按钮 ============ -->
    <Style x:Key="SettingsButtonStyleRound6"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Gray400Brush}"/>
                <Setter Property="Foreground" Value="{DynamicResource Gray700Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ 2. 图标按钮 - 无边框 ============ -->
    <!-- 顶部左侧功能栏（TopLeftBar）用；按用户要求保留原来更明显的放大效果（BasedOn 用大幅度基样式） -->
    <Style x:Key="ImageButtonStyleRound6NoBorder"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyleBigScale}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ============ 3. 图标按钮 - 无边框（官服 / 国际服） ============ -->
    <Style x:Key="ImageButtonStyleRound6NoBorder115"
           TargetType="Button"
           BasedOn="{StaticResource ImageButtonStyleRound6NoBorder}"/>

    <!-- ============ 4. 图标按钮 - 有边框 ============ -->
    <Style x:Key="ImageButtonStyleRound6"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Gray400Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ 5. 标题栏按钮（最小化 / 最大化） ============ -->
    <!-- 刻意不继承 BaseButtonStyle：窗口按钮不需要那套悬停放大动画（BaseButtonStyle 为 1.06 倍），
         悬停/按下只换主题背景色（Gray200/Gray300），深浅色主题下都低调不刺眼。 -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 背景走 TemplateBinding，这样 Style 里改 Background 就能生效；
                         圆角交给外层 RootBorder.Clip 处理，保证贴着窗口圆角一起裁 -->
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Gray200Brush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Gray300Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ 6. 关闭按钮 ============ -->
    <Style x:Key="TitleBarCloseButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource TitleBarButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>