<UserControl x:Class="LvchaxsBS.UI.Controls.SliderCardControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
             xmlns:ui="clr-namespace:LvchaxsBS.UI.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="800"
             Background="Transparent">

    <!-- 配置页通用"图标 + 标题 + 滑条 + 提示 (+ 侧边数字框)"卡片 -->
    <Border Style="{StaticResource ModuleFunctionCardStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                <Image Source="{Binding Icon, ElementName=Root}"
                       Width="60" Height="60" Stretch="Uniform"/>
            </Border>

            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="13"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 标题 + 紧跟标题的自定义内容（如运行状态标签），与标题同行 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title, ElementName=Root}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <ContentPresenter Content="{Binding TitleContent, ElementName=Root}"
                                          VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="SpinLabelText" Grid.Column="2"
                               Text="{Binding SpinLabel, ElementName=Root}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="2,0,0,0"/>

                    <controls:SpinTextBoxControl x:Name="PART_SpinBox"
                                                 Grid.Column="3"
                                                 Minimum="{Binding SpinMinimum, ElementName=Root}"
                                                 Maximum="{Binding SpinMaximum, ElementName=Root}"
                                                 Step="{Binding SpinStep, ElementName=Root}"
                                                 Unit="{Binding SpinUnit, ElementName=Root}"
                                                 NumericFormat="{Binding SpinNumericFormat, ElementName=Root}"
                                                 TextBoxWidth="{Binding SpinTextBoxWidth, ElementName=Root}"
                                                 Value="{Binding SpinValue, ElementName=Root, Mode=TwoWay}"
                                                 VerticalAlignment="Center"
                                                 Margin="2,0,6,0"
                                                 ui:ToastNotifier.Message="{Binding SpinToast, ElementName=Root}"/>
                </Grid>

                <!-- 第二行滑块：右边距与第一行数字框（Margin 2,0,6,0）保持一致，
                     这样两行末尾的 ▲▼ 按钮在同一竖直线上，也不会贴着卡片右边框 -->
                <controls:SpinSliderControl x:Name="PART_Slider"
                                            Grid.Row="1"
                                            Margin="0,0,6,0"
                                            Minimum="{Binding Minimum, ElementName=Root}"
                                            Maximum="{Binding Maximum, ElementName=Root}"
                                            Step="{Binding Step, ElementName=Root}"
                                            Unit="{Binding Unit, ElementName=Root}"
                                            NumericFormat="{Binding NumericFormat, ElementName=Root}"
                                            Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
                                            Height="26"
                                            ui:ToastNotifier.Message="{Binding SliderToast, ElementName=Root}"/>

                <TextBlock Grid.Row="2"
                           Text="{Binding Hint, ElementName=Root}"
                           FontSize="12"
                           Foreground="{DynamicResource TextDisabledBrush}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
