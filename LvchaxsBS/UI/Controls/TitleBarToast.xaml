<UserControl x:Class="LvchaxsBS.UI.Controls.TitleBarToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="20" d:DesignWidth="300"
             x:Name="RootControl"
             Focusable="False">
    <Border x:Name="PART_Container"
            Background="Transparent"
            Opacity="0"
            VerticalAlignment="Center"
            HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <Grid Width="12" Height="12"
                  VerticalAlignment="Center"
                  Margin="0,0,6,0">

                <Path x:Name="PART_IconInfo"
                      Stretch="Uniform"
                      Fill="#10AC84"
                      Data="M 8,1 A 7,7 0 1 1 8,15 A 7,7 0 1 1 8,1 Z
                            M 8,4 A 0.9,0.9 0 1 1 8,5.8 A 0.9,0.9 0 1 1 8,4 Z
                            M 7.2,7 L 8.8,7 L 8.8,12 L 7.2,12 Z"/>

                <Path x:Name="PART_IconError"
                      Stretch="Uniform"
                      Visibility="Collapsed"
                      Fill="#EF4444"
                      Data="M 8,1 A 7,7 0 1 1 8,15 A 7,7 0 1 1 8,1 Z
                            M 8,4 A 0.9,0.9 0 1 1 8,5.8 A 0.9,0.9 0 1 1 8,4 Z
                            M 7.2,7 L 8.8,7 L 8.8,12 L 7.2,12 Z"/>
            </Grid>

            <TextBlock x:Name="PART_Message"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Border>
</UserControl>