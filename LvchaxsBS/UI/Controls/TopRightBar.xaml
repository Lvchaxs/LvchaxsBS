<UserControl x:Class="LvchaxsBS.UI.Controls.TopRightBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:LvchaxsBS.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="160">

    <StackPanel Orientation="Horizontal">

        <!-- 主题 -->
        <Button x:Name="ButtonTheme"
                Width="28" Height="28"
                MinWidth="28"
                Margin="0,0,4,0"
                Style="{StaticResource ImageButtonStyleRound6}"
                ui:ButtonTip.Text="切换主题"
                Click="ButtonTheme_Click">
            <Grid Width="22" Height="22">
                <Viewbox x:Name="IconSun" Width="22" Height="22">
                    <Grid Width="24" Height="24">
                        <Ellipse Width="10" Height="10"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Stroke="{DynamicResource TextSecondaryBrush}"
                                 StrokeThickness="1.5"
                                 Fill="Transparent"/>
                        <Path Data="M 12,2 L 12,5 M 12,22 L 12,19 M 2,12 L 5,12 M 22,12 L 19,12 M 5,5 L 7,7 M 19,19 L 17,17 M 19,5 L 17,7 M 5,19 L 7,17"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Grid>
                </Viewbox>

                <Viewbox x:Name="IconMoon"
                         Width="20" Height="20"
                         Visibility="Collapsed">
                    <Grid Width="24" Height="24">
                        <Path Data="M 17,4 A 9,9 0 1 0 17,20 A 8,8 0 1 1 17,4 Z"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="-45" CenterX="12" CenterY="12"/>
                                    <TranslateTransform X="-3" Y="0"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Viewbox>
            </Grid>
        </Button>

        <!-- 截图 -->
        <Button x:Name="ButtonScreenshot"
                Width="28" Height="28"
                MinWidth="28"
                Margin="0,0,4,0"
                Style="{StaticResource ImageButtonStyleRound6}"
                ui:ButtonTip.Text="截图"
                Click="ButtonScreenshot_Click">
            <Viewbox Width="20" Height="20"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Grid Width="24" Height="24">
                    <Path Data="M 3,7 L 7,7 L 9,4 L 15,4 L 17,7 L 21,7 L 21,19 L 3,19 Z"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          Fill="Transparent"/>
                    <Ellipse Width="8" Height="8"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="0,2,0,0"
                             Stroke="{DynamicResource TextSecondaryBrush}"
                             StrokeThickness="1.5"
                             Fill="Transparent"/>
                </Grid>
            </Viewbox>
        </Button>

        <!-- 开关（胶囊） -->
        <Button x:Name="ButtonToggle"
                Width="28" Height="28"
                MinWidth="28"
                Margin="0,0,4,0"
                Style="{StaticResource ImageButtonStyleRound6}"
                ui:ButtonTip.Text="功能总开关"
                Click="ButtonToggle_Click">
            <Viewbox Width="28" Height="28"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Grid Width="24" Height="24">
                    <!-- 胶囊外框（线条） -->
                    <Border x:Name="ToggleTrack"
                            Width="20" Height="12"
                            CornerRadius="5"
                            BorderBrush="{DynamicResource TextSecondaryBrush}"
                            BorderThickness="1.1"
                            Background="Transparent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    <!-- 内部圆点（线条） -->
                    <Ellipse x:Name="ToggleThumb"
                             Width="8" Height="8"
                             Stroke="{DynamicResource TextSecondaryBrush}"
                             StrokeThickness="1.1"
                             Fill="Transparent"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Margin="4,0,0,0"/>
                </Grid>
            </Viewbox>
        </Button>
        
        <!-- 重启 -->
        <Button x:Name="ButtonRestart"
                Width="28" Height="28"
                MinWidth="28"
                Style="{StaticResource ImageButtonStyleRound6}"
                ui:ButtonTip.Text="重启"
                Click="ButtonRestart_Click">
            <Viewbox Width="22" Height="22"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Grid Width="24" Height="24">
                    <Grid.RenderTransform>
                        <RotateTransform Angle="45" CenterX="12" CenterY="12"/>
                    </Grid.RenderTransform>

                    <Path Data="M 12,2 C 12,2 7,8 7,15 L 17,15 C 17,8 12,2 12,2 Z"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          Fill="Transparent"/>

                    <Path Data="M 7,12 L 4,15 L 4,18 L 7,16"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent"/>

                    <Path Data="M 17,12 L 20,15 L 20,18 L 17,16"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent"/>

                    <Path Data="M 10,17 C 10,19 11,20 12,21 C 13,20 14,19 14,17"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent"/>
                </Grid>
            </Viewbox>
        </Button>
    </StackPanel>
</UserControl>