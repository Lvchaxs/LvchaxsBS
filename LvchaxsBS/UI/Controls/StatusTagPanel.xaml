<UserControl x:Class="LvchaxsBS.UI.Controls.StatusTagPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="24" d:DesignWidth="400"
             Focusable="False">

    <!--
        运行状态标签组：匹配度 / 耗时 / 类型（结构与旧项目一致）。
        配色走主题资源（TagGreen* / TagRed* / Gray100），深浅主题都正确、切主题自动跟随；
        文字色由代码按状态切换（见 StatusTagPanel.xaml.cs 的 ApplyState）。
    -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

        <Border x:Name="ScoreBorder" Style="{StaticResource TagLabelGreenStyle}">
            <TextBlock x:Name="ScoreText"
                       Text="匹配度: --"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TagGreenFgBrush}"/>
        </Border>

        <Border x:Name="TimeBorder" Style="{StaticResource TagLabelGreenStyle}">
            <TextBlock x:Name="TimeText"
                       Text="耗时: --"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TagGreenFgBrush}"/>
        </Border>

        <Border x:Name="SourceBorder" Style="{StaticResource TagLabelGreenStyle}">
            <TextBlock x:Name="SourceText"
                       Text="类型: --"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TagGreenFgBrush}"/>
        </Border>

    </StackPanel>
</UserControl>
