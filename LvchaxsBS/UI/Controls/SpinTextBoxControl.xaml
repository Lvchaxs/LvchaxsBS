<UserControl x:Class="LvchaxsBS.UI.Controls.SpinTextBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="25" d:DesignWidth="120"
             x:Name="RootControl">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 输入框 -->
        <TextBox x:Name="PART_ValueTextBox"
                 Grid.Column="0"
                 Width="60"
                 Height="22"
                 Style="{StaticResource PublicTextBoxStyle}"
                 Padding="2,0,2,0"
                 TextAlignment="Center"
                 GotFocus="PART_ValueTextBox_GotFocus"
                 LostFocus="PART_ValueTextBox_LostFocus"
                 PreviewKeyDown="PART_ValueTextBox_PreviewKeyDown"/>

        <!-- 加减按钮 -->
        <StackPanel Grid.Column="1"
                    Orientation="Vertical"
                    VerticalAlignment="Center"
                    Margin="2,0,0,0">
            <Button x:Name="PART_UpButton"
                    Style="{StaticResource SpinButtonStyle}"
                    Content="▲"
                    Click="UpButton_Click"
                    Focusable="False"/>
            <Button x:Name="PART_DownButton"
                    Style="{StaticResource SpinButtonStyle}"
                    Content="▼"
                    Margin="0,1,0,0"
                    Click="DownButton_Click"
                    Focusable="False"/>
        </StackPanel>
    </Grid>
</UserControl>