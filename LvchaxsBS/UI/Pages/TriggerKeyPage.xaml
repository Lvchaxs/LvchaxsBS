<Page x:Class="LvchaxsBS.UI.Pages.TriggerKeyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="KeyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Gray400Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <!-- 禁用：灰化 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <StackPanel Margin="5,4,5,0">

            <!-- ============ 卡片1：键盘布局（自适应高度） ============ -->
            <Border Style="{StaticResource ModuleFunctionCardAutoStyle}">
                <ScrollViewer Style="{StaticResource CustomScrollViewer}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="0,4,0,4">
                        <Canvas Width="760" Height="245"
                                Background="Transparent"
                                Focusable="False">

                            <!-- ===== 功能键行 ===== -->
                            <Button x:Name="KeyEsc" Style="{StaticResource KeyButtonStyle}" Content="Esc" Canvas.Left="11" Canvas.Top="10" Width="40"/>
                            <Button x:Name="KeyF1" Style="{StaticResource KeyButtonStyle}" Content="F1" Canvas.Left="55" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyF2" Style="{StaticResource KeyButtonStyle}" Content="F2" Canvas.Left="93" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyF3" Style="{StaticResource KeyButtonStyle}" Content="F3" Canvas.Left="131" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyF4" Style="{StaticResource KeyButtonStyle}" Content="F4" Canvas.Left="169" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyF5" Style="{StaticResource KeyButtonStyle}" Content="F5" Canvas.Left="207" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyF6" Style="{StaticResource KeyButtonStyle}" Content="F6" Canvas.Left="245" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyF7" Style="{StaticResource KeyButtonStyle}" Content="F7" Canvas.Left="283" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyF8" Style="{StaticResource KeyButtonStyle}" Content="F8" Canvas.Left="321" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyF9" Style="{StaticResource KeyButtonStyle}" Content="F9" Canvas.Left="359" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyF10" Style="{StaticResource KeyButtonStyle}" Content="F10" Canvas.Left="397" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyF11" Style="{StaticResource KeyButtonStyle}" Content="F11" Canvas.Left="435" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyF12" Style="{StaticResource KeyButtonStyle}" Content="F12" Canvas.Left="473" Canvas.Top="10" Width="34"/>

                            <Button x:Name="KeyForward" Style="{StaticResource KeyButtonStyle}" Content="前进" Canvas.Left="529" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyBack" Style="{StaticResource KeyButtonStyle}" Content="后退" Canvas.Left="568" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyDelete" Style="{StaticResource KeyButtonStyle}" Content="Del" Canvas.Left="606" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyInsert" Style="{StaticResource KeyButtonStyle}" Content="Ins" Canvas.Left="645" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyPageUp" Style="{StaticResource KeyButtonStyle}" Content="Pg↑" Canvas.Left="685" Canvas.Top="10" Width="34"/>
                            <Button x:Name="KeyPageDown" Style="{StaticResource KeyButtonStyle}" Content="Pg↓" Canvas.Left="724" Canvas.Top="10" Width="34"/>

                            <!-- ===== 数字行 ===== -->
                            <Button x:Name="KeyTilde" Style="{StaticResource KeyButtonStyle}" Content="`~" Canvas.Left="11" Canvas.Top="50" Width="40"/>
                            <Button x:Name="KeyD1" Style="{StaticResource KeyButtonStyle}" Content="1" Canvas.Left="55" Canvas.Top="50" Width="34"/>
                            <Button x:Name="KeyD2" Style="{StaticResource KeyButtonStyle}" Content="2" Canvas.Left="93" Canvas.Top="50" Width="34"/>
                            <Button x:Name="KeyD3" Style="{StaticResource KeyButtonStyle}" Content="3" Canvas.Left="131" Canvas.Top="50" Width="34"/>
                            <Button x:Name="KeyD4" Style="{StaticResource KeyButtonStyle}" Content="4" Canvas.Left="169" Canvas.Top="50" Width="34"/>
                            <Button x:Name="KeyD5" Style="{StaticResource KeyButtonStyle}" Content="5" Canvas.Left="207" Canvas.Top="50" Width="34"/>
                            <Button x:Name="KeyD6" Style="{StaticResource KeyButtonStyle}" Content="6" Canvas.Left="245" Canvas.Top="50" Width="34"/>
                            <Button x:Name="KeyD7" Style="{StaticResource KeyButtonStyle}" Content="7" Canvas.Left="283" Canvas.Top="50" Width="34"/>
                            <Button x:Name="KeyD8" Style="{StaticResource KeyButtonStyle}" Content="8" Canvas.Left="321" Canvas.Top="50" Width="34"/>
                            <Button x:Name="KeyD9" Style="{StaticResource KeyButtonStyle}" Content="9" Canvas.Left="359" Canvas.Top="50" Width="34"/>
                            <Button x:Name="KeyD0" Style="{StaticResource KeyButtonStyle}" Content="0" Canvas.Left="397" Canvas.Top="50" Width="34"/>
                            <Button x:Name="KeyMinus" Style="{StaticResource KeyButtonStyle}" Content="-" Canvas.Left="435" Canvas.Top="50" Width="34"/>
                            <Button x:Name="KeyEquals" Style="{StaticResource KeyButtonStyle}" Content="=" Canvas.Left="473" Canvas.Top="50" Width="34"/>
                            <Button x:Name="KeyBackspace" Style="{StaticResource KeyButtonStyle}" Content="Back" Canvas.Left="511" Canvas.Top="50" Width="52"/>

                            <!-- ===== QWERTY行 ===== -->
                            <Button x:Name="KeyTab" Style="{StaticResource KeyButtonStyle}" Content="Tab" Canvas.Left="11" Canvas.Top="90" Width="44"/>
                            <Button x:Name="KeyQ" Style="{StaticResource KeyButtonStyle}" Content="Q" Canvas.Left="59" Canvas.Top="90" Width="34"/>
                            <Button x:Name="KeyW" Style="{StaticResource KeyButtonStyle}" Content="W" Canvas.Left="97" Canvas.Top="90" Width="34"/>
                            <Button x:Name="KeyE" Style="{StaticResource KeyButtonStyle}" Content="E" Canvas.Left="135" Canvas.Top="90" Width="34"/>
                            <Button x:Name="KeyR" Style="{StaticResource KeyButtonStyle}" Content="R" Canvas.Left="173" Canvas.Top="90" Width="34"/>
                            <Button x:Name="KeyT" Style="{StaticResource KeyButtonStyle}" Content="T" Canvas.Left="211" Canvas.Top="90" Width="34"/>
                            <Button x:Name="KeyY" Style="{StaticResource KeyButtonStyle}" Content="Y" Canvas.Left="249" Canvas.Top="90" Width="34"/>
                            <Button x:Name="KeyU" Style="{StaticResource KeyButtonStyle}" Content="U" Canvas.Left="287" Canvas.Top="90" Width="34"/>
                            <Button x:Name="KeyI" Style="{StaticResource KeyButtonStyle}" Content="I" Canvas.Left="325" Canvas.Top="90" Width="34"/>
                            <Button x:Name="KeyO" Style="{StaticResource KeyButtonStyle}" Content="O" Canvas.Left="363" Canvas.Top="90" Width="34"/>
                            <Button x:Name="KeyP" Style="{StaticResource KeyButtonStyle}" Content="P" Canvas.Left="401" Canvas.Top="90" Width="34"/>
                            <Button x:Name="KeyLeftBracket" Style="{StaticResource KeyButtonStyle}" Content="[" Canvas.Left="439" Canvas.Top="90" Width="34"/>
                            <Button x:Name="KeyRightBracket" Style="{StaticResource KeyButtonStyle}" Content="]" Canvas.Left="477" Canvas.Top="90" Width="34"/>
                            <Button x:Name="KeyBackslash" Style="{StaticResource KeyButtonStyle}" Content="\|" Canvas.Left="515" Canvas.Top="90" Width="48"/>

                            <!-- ===== ASDF行 ===== -->
                            <Button x:Name="KeyCapsLock" Style="{StaticResource KeyButtonStyle}" Content="Caps" Canvas.Left="11" Canvas.Top="130" Width="58"/>
                            <Button x:Name="KeyA" Style="{StaticResource KeyButtonStyle}" Content="A" Canvas.Left="73" Canvas.Top="130" Width="34"/>
                            <Button x:Name="KeyS" Style="{StaticResource KeyButtonStyle}" Content="S" Canvas.Left="111" Canvas.Top="130" Width="34"/>
                            <Button x:Name="KeyD" Style="{StaticResource KeyButtonStyle}" Content="D" Canvas.Left="149" Canvas.Top="130" Width="34"/>
                            <Button x:Name="KeyF" Style="{StaticResource KeyButtonStyle}" Content="F" Canvas.Left="187" Canvas.Top="130" Width="34"/>
                            <Button x:Name="KeyG" Style="{StaticResource KeyButtonStyle}" Content="G" Canvas.Left="225" Canvas.Top="130" Width="34"/>
                            <Button x:Name="KeyH" Style="{StaticResource KeyButtonStyle}" Content="H" Canvas.Left="263" Canvas.Top="130" Width="34"/>
                            <Button x:Name="KeyJ" Style="{StaticResource KeyButtonStyle}" Content="J" Canvas.Left="301" Canvas.Top="130" Width="34"/>
                            <Button x:Name="KeyK" Style="{StaticResource KeyButtonStyle}" Content="K" Canvas.Left="339" Canvas.Top="130" Width="34"/>
                            <Button x:Name="KeyL" Style="{StaticResource KeyButtonStyle}" Content="L" Canvas.Left="377" Canvas.Top="130" Width="34"/>
                            <Button x:Name="KeySemicolon" Style="{StaticResource KeyButtonStyle}" Content=";" Canvas.Left="415" Canvas.Top="130" Width="34"/>
                            <Button x:Name="KeyApostrophe" Style="{StaticResource KeyButtonStyle}" Content="'" Canvas.Left="453" Canvas.Top="130" Width="34"/>
                            <Button x:Name="KeyEnter" Style="{StaticResource KeyButtonStyle}" Content="Enter" Canvas.Left="491" Canvas.Top="130" Width="72"/>

                            <!-- ===== ZXCV行 ===== -->
                            <Button x:Name="KeyLeftShift" Style="{StaticResource KeyButtonStyle}" Content="Shift" Canvas.Left="11" Canvas.Top="170" Width="70"/>
                            <Button x:Name="KeyZ" Style="{StaticResource KeyButtonStyle}" Content="Z" Canvas.Left="85" Canvas.Top="170" Width="34"/>
                            <Button x:Name="KeyX" Style="{StaticResource KeyButtonStyle}" Content="X" Canvas.Left="123" Canvas.Top="170" Width="34"/>
                            <Button x:Name="KeyC" Style="{StaticResource KeyButtonStyle}" Content="C" Canvas.Left="161" Canvas.Top="170" Width="34"/>
                            <Button x:Name="KeyV" Style="{StaticResource KeyButtonStyle}" Content="V" Canvas.Left="199" Canvas.Top="170" Width="34"/>
                            <Button x:Name="KeyB" Style="{StaticResource KeyButtonStyle}" Content="B" Canvas.Left="237" Canvas.Top="170" Width="34"/>
                            <Button x:Name="KeyN" Style="{StaticResource KeyButtonStyle}" Content="N" Canvas.Left="275" Canvas.Top="170" Width="34"/>
                            <Button x:Name="KeyM" Style="{StaticResource KeyButtonStyle}" Content="M" Canvas.Left="313" Canvas.Top="170" Width="34"/>
                            <Button x:Name="KeyComma" Style="{StaticResource KeyButtonStyle}" Content="," Canvas.Left="351" Canvas.Top="170" Width="34"/>
                            <Button x:Name="KeyPeriod" Style="{StaticResource KeyButtonStyle}" Content="." Canvas.Left="389" Canvas.Top="170" Width="34"/>
                            <Button x:Name="KeySlash" Style="{StaticResource KeyButtonStyle}" Content="/" Canvas.Left="427" Canvas.Top="170" Width="34"/>
                            <Button x:Name="KeyRightShift" Style="{StaticResource KeyButtonStyle}" Content="Shift" Canvas.Left="466" Canvas.Top="170" Width="97"/>

                            <!-- ===== 底行 ===== -->
                            <Button x:Name="KeyLeftCtrl" Style="{StaticResource KeyButtonStyle}" Content="Ctrl" Canvas.Left="11" Canvas.Top="210" Width="44"/>
                            <Button x:Name="KeyLeftWin" Style="{StaticResource KeyButtonStyle}" Content="Win" Canvas.Left="59" Canvas.Top="210" Width="44"/>
                            <Button x:Name="KeyLeftAlt" Style="{StaticResource KeyButtonStyle}" Content="Alt" Canvas.Left="107" Canvas.Top="210" Width="44"/>
                            <Button x:Name="KeySpace" Style="{StaticResource KeyButtonStyle}" Content="Space" Canvas.Left="155" Canvas.Top="210" Width="226"/>
                            <Button x:Name="KeyRightAlt" Style="{StaticResource KeyButtonStyle}" Content="Alt" Canvas.Left="385" Canvas.Top="210" Width="44"/>
                            <Button x:Name="KeyRightWin" Style="{StaticResource KeyButtonStyle}" Content="Win" Canvas.Left="433" Canvas.Top="210" Width="44"/>
                            <Button x:Name="KeyRightCtrl" Style="{StaticResource KeyButtonStyle}" Content="Ctrl" Canvas.Left="481" Canvas.Top="210" Width="44"/>

                            <!-- ===== 方向键 ===== -->
                            <Button x:Name="KeyUp" Style="{StaticResource KeyButtonStyle}" Content="↑" Canvas.Left="568" Canvas.Top="170" Width="34" FontSize="12"/>
                            <Button x:Name="KeyLeft" Style="{StaticResource KeyButtonStyle}" Content="←" Canvas.Left="529" Canvas.Top="210" Width="34" FontSize="12"/>
                            <Button x:Name="KeyDown" Style="{StaticResource KeyButtonStyle}" Content="↓" Canvas.Left="568" Canvas.Top="210" Width="34" FontSize="12"/>
                            <Button x:Name="KeyRight" Style="{StaticResource KeyButtonStyle}" Content="→" Canvas.Left="607" Canvas.Top="210" Width="34" FontSize="12"/>

                            <!-- ===== 鼠标按键 ===== -->
                            <Button x:Name="MouseLeft" Style="{StaticResource KeyButtonStyle}" Content="左键" Canvas.Left="568" Canvas.Top="50" Width="34"/>
                            <Button x:Name="MouseMiddle" Style="{StaticResource KeyButtonStyle}" Content="中键" Canvas.Left="568" Canvas.Top="90" Width="34"/>
                            <Button x:Name="MouseRight" Style="{StaticResource KeyButtonStyle}" Content="右键" Canvas.Left="568" Canvas.Top="130" Width="34"/>

                            <!-- ===== 小键盘 ===== -->
                            <Button x:Name="KeyNumLock" Style="{StaticResource KeyButtonStyle}" Content="Num" Canvas.Left="607" Canvas.Top="50" Width="34" FontWeight="Bold"/>
                            <Button x:Name="KeyNumDivide" Style="{StaticResource KeyButtonStyle}" Content="/" Canvas.Left="645" Canvas.Top="50" Width="34" FontWeight="Bold"/>
                            <Button x:Name="KeyNumMultiply" Style="{StaticResource KeyButtonStyle}" Content="*" Canvas.Left="685" Canvas.Top="50" Width="34" FontWeight="Bold"/>
                            <Button x:Name="KeyNumMinus" Style="{StaticResource KeyButtonStyle}" Content="-" Canvas.Left="724" Canvas.Top="50" Width="34" FontWeight="Bold"/>

                            <Button x:Name="KeyNum7" Style="{StaticResource KeyButtonStyle}" Content="7" Canvas.Left="607" Canvas.Top="90" Width="34" FontWeight="Bold"/>
                            <Button x:Name="KeyNum8" Style="{StaticResource KeyButtonStyle}" Content="8" Canvas.Left="645" Canvas.Top="90" Width="34" FontWeight="Bold"/>
                            <Button x:Name="KeyNum9" Style="{StaticResource KeyButtonStyle}" Content="9" Canvas.Left="685" Canvas.Top="90" Width="34" FontWeight="Bold"/>
                            <Button x:Name="KeyNumPlus" Style="{StaticResource KeyButtonStyle}" Content="+" Canvas.Left="724" Canvas.Top="90" Width="34" Height="72" FontWeight="Bold"/>

                            <Button x:Name="KeyNum4" Style="{StaticResource KeyButtonStyle}" Content="4" Canvas.Left="607" Canvas.Top="130" Width="34" FontWeight="Bold"/>
                            <Button x:Name="KeyNum5" Style="{StaticResource KeyButtonStyle}" Content="5" Canvas.Left="645" Canvas.Top="130" Width="34" FontWeight="Bold"/>
                            <Button x:Name="KeyNum6" Style="{StaticResource KeyButtonStyle}" Content="6" Canvas.Left="685" Canvas.Top="130" Width="34" FontWeight="Bold"/>

                            <Button x:Name="KeyNum1" Style="{StaticResource KeyButtonStyle}" Content="1" Canvas.Left="607" Canvas.Top="170" Width="34" FontWeight="Bold"/>
                            <Button x:Name="KeyNum2" Style="{StaticResource KeyButtonStyle}" Content="2" Canvas.Left="645" Canvas.Top="170" Width="34" FontWeight="Bold"/>
                            <Button x:Name="KeyNum3" Style="{StaticResource KeyButtonStyle}" Content="3" Canvas.Left="685" Canvas.Top="170" Width="34" FontWeight="Bold"/>
                            <Button x:Name="KeyNumEnter" Style="{StaticResource KeyButtonStyle}" Content="Enter" Canvas.Left="724" Canvas.Top="170" Width="34" Height="72" FontWeight="Bold" FontSize="10"/>

                            <Button x:Name="KeyNum0" Style="{StaticResource KeyButtonStyle}" Content="0" Canvas.Left="645" Canvas.Top="210" Width="34" FontWeight="Bold"/>
                            <Button x:Name="KeyNumDecimal" Style="{StaticResource KeyButtonStyle}" Content="." Canvas.Left="685" Canvas.Top="210" Width="34" FontWeight="Bold"/>
                        </Canvas>
                    </Viewbox>
                </ScrollViewer>
            </Border>

            <!-- ============ 卡片2：说明 ============ -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}" Height="70">
                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Width="779"
                           Text="触发键单选： 各功能的启动按键 游戏中按下对应功能触发键时启动"/>
            </Border>

        </StackPanel>
    </Grid>
</Page>