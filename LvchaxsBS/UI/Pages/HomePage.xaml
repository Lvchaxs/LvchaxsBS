<Page x:Class="LvchaxsBS.UI.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="clr-namespace:LvchaxsBS.UI.Controls"
      xmlns:pages="clr-namespace:LvchaxsBS.UI.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage"
      Background="Transparent">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 触发键按钮：未设置（灰）/ 已设置（主题色），画刷全部 DynamicResource，切主题自动生效 -->
        <Style x:Key="ModuleTriggerButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyleRound6}">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasKey}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Gray100Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <!-- 卡片数据来自 ModuleRegistry（ModuleCardItem），新增模块无需改本页 -->
    <ScrollViewer Style="{StaticResource CustomScrollViewer}">
        <ItemsControl x:Name="ModuleList" Margin="5,4,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:ModuleCardItem}">

                    <Border Style="{StaticResource ModuleFunctionCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                                <Image Source="{Binding Module.IconPath}"
                                       Width="60" Height="60" Stretch="Uniform"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Module.Name}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/>

                                    <!-- 通用分辨率标签（无标签模块自动隐藏，如手柄拾取） -->
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ShowTags, Converter={StaticResource BoolToVis}}">
                                        <Border Style="{StaticResource TagLabelBlueStyle}" Width="35">
                                            <TextBlock Text="16:9" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TagBlueFgBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Style="{StaticResource TagLabelPurpleStyle}">
                                            <TextBlock Text="5120x2160" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TagPurpleFgBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource TagLabelGreenStyle}">
                                            <TextBlock Text="3440x1440" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TagGreenFgBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource TagLabelRedStyle}">
                                            <TextBlock Text="2560x1080" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TagRedFgBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding Module.Description}"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="WordEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Button Width="50" Height="28" FontSize="11" Margin="0,0,10,0"
                                        Style="{StaticResource ModuleTriggerButtonStyle}"
                                        Content="{Binding TriggerKeyText}"
                                        ui:ButtonTip.Text="{Binding TriggerKeyTooltip}"
                                        Click="TriggerKeyButton_Click"/>
                                <Button Content="配置" Width="50" Height="28" Margin="0,0,10,0"
                                        Style="{StaticResource FlatButtonStyleRound6}"
                                        Click="ConfigButton_Click"/>
                                <CheckBox Style="{StaticResource ModuleToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsChecked}"
                                          Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Page>
