<Page x:Class="LvchaxsBS.UI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
      xmlns:ui="clr-namespace:LvchaxsBS.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingsPage"
      Background="Transparent">

    <ScrollViewer Style="{StaticResource CustomScrollViewer}">
        <StackPanel Margin="5,4,0,0">

            <!-- ============ 卡片1：窗口检测 ============ -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}" Height="70">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/SettingsPage/窗口信息.png"
                               Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                            <TextBlock Text="窗口检测" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Border x:Name="ServiceTagBorder" Style="{StaticResource StatusTagStyle}">
                                <TextBlock x:Name="ServiceTagText" Text="检测：运行中" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TagGreenFgBrush}"/>
                            </Border>
                            <Border x:Name="GameTagBorder" Style="{StaticResource StatusTagStyle}">
                                <TextBlock x:Name="GameTagText" Text="游戏：已启动" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TagGreenFgBrush}"/>
                            </Border>
                            <Border x:Name="FocusTagBorder" Style="{StaticResource StatusTagStyle}">
                                <TextBlock x:Name="FocusTagText" Text="焦点：焦点内" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TagGreenFgBrush}"/>
                            </Border>
                            <Border x:Name="TopLeftTagBorder" Style="{StaticResource StatusTagStyle}">
                                <TextBlock x:Name="TopLeftTagText" Text="坐标：0, 0" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TagGreenFgBrush}"/>
                            </Border>
                            <Border x:Name="TitleTagBorder" Style="{StaticResource StatusTagStyle}">
                                <TextBlock x:Name="TitleTagText" Text="标题：原神" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TagGreenFgBrush}"/>
                            </Border>
                        </WrapPanel>

                        <TextBlock Grid.Row="1"
                                   Text="更新客户区窗口信息以及图像识别截图方法，如果所有功能识别无效选择使用另一个方法"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="截图:" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <controls:DropDownSelect x:Name="CaptureModeSelect"
                                                 Width="130"
                                                 Height="28"
                                                 SelectedIndex="0"
                                                 VerticalAlignment="Center"
                                                 ui:ToastNotifier.Message="截图方式"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 卡片2：界面检测 ============ -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}" Height="70">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/SettingsPage/窗口信息.png"
                               Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="16"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                            <TextBlock Text="界面检测" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border x:Name="DetectionTagBorder" Style="{StaticResource StatusTagStyle}">
                                <TextBlock x:Name="DetectionTagText" Text="检测：运行中" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TagGreenFgBrush}"/>
                            </Border>
                            <Border x:Name="ElapsedTagBorder" Style="{StaticResource StatusTagStyle}">
                                <TextBlock x:Name="ElapsedTagText" Text="耗时：--" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TagGreenFgBrush}"/>
                            </Border>
                            <Border x:Name="ResultTagBorder" Style="{StaticResource StatusTagStyle}">
                                <TextBlock x:Name="ResultTagText" Text="类型：未检测到" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TagGreenFgBrush}"/>
                            </Border>
                        </WrapPanel>

                        <controls:SpinSliderControl x:Name="MainWindowCheckIntervalSlider"
                                                    Grid.Row="1"
                                                    Minimum="1" Maximum="500"
                                                    Value="50" Step="1"
                                                    Unit="ms"
                                                    NumericFormat="F0"
                                                    Height="20"
                                                    ui:ToastNotifier.Message="界面检测间隔"/>

                        <TextBlock Grid.Row="2"
                                   Text="客户区窗口处于焦点时执行此处检测目标：主界面/地图界面"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ 卡片3：窗口缩放 ============ -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}" Height="70">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/SettingsPage/设备.png"
                               Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="16"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="窗口缩放" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <controls:SpinSliderControl x:Name="DpiScaleSlider"
                                                    Grid.Row="1"
                                                    Minimum="50" Maximum="175"
                                                    Value="100" Step="1"
                                                    Unit="%"
                                                    NumericFormat="F0"
                                                    Height="20"
                                                    ui:ToastNotifier.Message="窗口缩放"/>

                        <TextBlock Grid.Row="2"
                                   Text="此程序窗口的 DPI，包括窗口大小和内部所有的 UI 控件整体大小，重启生效"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ 卡片4：游戏路径 ============ -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}" Height="70">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/SettingsPage/文件夹.png"
                               Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="16"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="官服路径" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="OfficialServerPathText" Text="未设置路径" FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Text="外服路径" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="InternationalServerPathText" Text="未设置路径" FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Text="自动更新保存启动程序路径，客户区未启动时可在顶部导航栏快速启动"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ 卡片5：程序版本 ============ -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}" Height="70">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/SettingsPage/下载更新.png"
                               Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="当前版本" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource StatusTagStyle}" Margin="8,0,0,0">
                                <TextBlock x:Name="VersionText" Text="v1.0.0.0" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TagGreenFgBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="从 gitee 仓库内下载不同版本的文件进行更新"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="ClearCacheBtn" Content="重置配置" Width="70" Height="28" Margin="0,0,10,0"
                                Style="{StaticResource FlatButtonStyleRound6}"
                                Click="ClearCacheBtn_Click"/>
                        <Button x:Name="TestVersionBtn" Content="测试版本" Width="70" Height="28" Margin="0,0,10,0"
                                Style="{StaticResource FlatButtonStyleRound6}"
                                Click="TestVersionBtn_Click"/>
                        <Button x:Name="LatestVersionBtn" Content="最新版本" Width="70" Height="28"
                                Style="{StaticResource FlatButtonStyleRound6}"
                                Click="LatestVersionBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 卡片6：关于工具 ============ -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}" Height="70">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/SettingsPage/关于.png"
                   Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="15"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="关于项目" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock Grid.Row="1"
                       Text="项目使用 C#/AI/PS 等工具制作，内容包含模拟输入/图像识别/窗口交互等"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TextBlock Grid.Row="2"
                       FontSize="12"
                       Foreground="{DynamicResource TextDisabledBrush}">
                <Run Text="作者:LvchaxsBS/伴生/2163239604@qq.com/" Foreground="{DynamicResource TextDisabledBrush}"/>
                <Hyperlink NavigateUri="https://space.bilibili.com/501163575"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Foreground="#3B82F6"
                           TextDecorations="None"
                           Focusable="False">
                    <Run Text="bilibili"/>
                </Hyperlink>
                <Run Text="/" Foreground="{DynamicResource TextDisabledBrush}"/>
                <Hyperlink NavigateUri="https://gitee.com/accompanying-it/associated-with-lvchaxs"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Foreground="#3B82F6"
                           TextDecorations="None"
                           Focusable="False">
                    <Run Text="gitee"/>
                </Hyperlink>
                <Run Text="/" Foreground="{DynamicResource TextDisabledBrush}"/>
                <Hyperlink NavigateUri="https://github.com/Lvchaxs/LvchaxsBS"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Foreground="#3B82F6"
                           TextDecorations="None"
                           Focusable="False">
                    <Run Text="github"/>
                </Hyperlink>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>