<Page x:Class="LvchaxsBS.UI.Pages.GamepadTriggerKeyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="GamepadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GamepadRoundButtonStyle" TargetType="Button" BasedOn="{StaticResource GamepadButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </Page.Resources>

    <Grid>
        <StackPanel Margin="5,4,5,0">

            <!-- 卡片1：手柄布局 -->
            <Border Style="{StaticResource ModuleFunctionCardAutoStyle}">
                <ScrollViewer Style="{StaticResource CustomScrollViewer}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="0,4,0,4">
                        <Canvas Width="760" Height="245" Background="Transparent">

                            <!-- 顶部：肩键 + 扳机键 -->
                            <Button x:Name="GamepadL1" Style="{StaticResource GamepadButtonStyle}"
                                    Content="LB" Canvas.Left="50" Canvas.Top="10" Width="52"/>
                            <Button x:Name="GamepadL2" Style="{StaticResource GamepadButtonStyle}"
                                    Content="LT" Canvas.Left="50" Canvas.Top="44" Width="52"/>

                            <Button x:Name="GamepadR1" Style="{StaticResource GamepadButtonStyle}"
                                    Content="RB" Canvas.Left="658" Canvas.Top="10" Width="52"/>
                            <Button x:Name="GamepadR2" Style="{StaticResource GamepadButtonStyle}"
                                    Content="RT" Canvas.Left="658" Canvas.Top="44" Width="52"/>

                            <!-- 中间顶部 -->
                            <Button x:Name="GamepadCreate" Style="{StaticResource GamepadButtonStyle}"
                                    Content="View" Canvas.Left="300" Canvas.Top="14" Width="48" Height="26" FontSize="10"/>
                            <Button x:Name="GamepadPS" Style="{StaticResource GamepadButtonStyle}"
                                    Content="Xbox" Canvas.Left="356" Canvas.Top="14" Width="48" Height="26" FontSize="10"/>
                            <Button x:Name="GamepadOptions" Style="{StaticResource GamepadButtonStyle}"
                                    Content="Menu" Canvas.Left="412" Canvas.Top="14" Width="48" Height="26" FontSize="10"/>

                            <Button x:Name="GamepadTouchPad" Style="{StaticResource GamepadButtonStyle}"
                                    Content="触摸板" Canvas.Left="300" Canvas.Top="48" Width="76" Height="26" FontSize="10"/>
                            <Button x:Name="GamepadMic" Style="{StaticResource GamepadButtonStyle}"
                                    Content="麦克风" Canvas.Left="384" Canvas.Top="48" Width="76" Height="26" FontSize="10"/>

                            <!-- 左侧：方向键 -->
                            <TextBlock Text="方向键" Style="{StaticResource SectionTitleStyle}"
                                       Canvas.Left="132" Canvas.Top="88" HorizontalAlignment="Left"/>
                            <Button x:Name="GamepadDPadUp" Style="{StaticResource GamepadButtonStyle}"
                                    Content="↑" Canvas.Left="131" Canvas.Top="105" Width="32" Height="32" FontSize="14"/>
                            <Button x:Name="GamepadDPadDown" Style="{StaticResource GamepadButtonStyle}"
                                    Content="↓" Canvas.Left="131" Canvas.Top="173" Width="32" Height="32" FontSize="14"/>
                            <Button x:Name="GamepadDPadLeft" Style="{StaticResource GamepadButtonStyle}"
                                    Content="←" Canvas.Left="97" Canvas.Top="139" Width="32" Height="32" FontSize="14"/>
                            <Button x:Name="GamepadDPadRight" Style="{StaticResource GamepadButtonStyle}"
                                    Content="→" Canvas.Left="165" Canvas.Top="139" Width="32" Height="32" FontSize="14"/>

                            <!-- 中心：左摇杆 L3 -->
                            <TextBlock Text="左摇杆" Style="{StaticResource SectionTitleStyle}"
                                       Canvas.Left="296" Canvas.Top="110" HorizontalAlignment="Left"/>
                            <Ellipse Canvas.Left="286" Canvas.Top="129" Width="52" Height="52"
                                     Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="2"
                                     Fill="{DynamicResource CardBackgroundBrush}"/>
                            <Button x:Name="GamepadL3" Style="{StaticResource GamepadButtonStyle}"
                                    Content="L3" Canvas.Left="297" Canvas.Top="140" Width="30" Height="30" FontSize="11"/>

                            <!-- 中心：右摇杆 R3 -->
                            <TextBlock Text="右摇杆" Style="{StaticResource SectionTitleStyle}"
                                       Canvas.Left="417" Canvas.Top="110" HorizontalAlignment="Left"/>
                            <Ellipse Canvas.Left="406" Canvas.Top="129" Width="52" Height="52"
                                     Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="2"
                                     Fill="{DynamicResource CardBackgroundBrush}"/>
                            <Button x:Name="GamepadR3" Style="{StaticResource GamepadButtonStyle}"
                                    Content="R3" Canvas.Left="417" Canvas.Top="140" Width="30" Height="30" FontSize="11"/>

                            <!-- 右侧：功能键 ABXY -->
                            <TextBlock Text="功能键" Style="{StaticResource SectionTitleStyle}"
                                       Canvas.Left="634" Canvas.Top="88" HorizontalAlignment="Left"/>
                            <Button x:Name="GamepadY" Style="{StaticResource GamepadRoundButtonStyle}"
                                    Content="Y" Canvas.Left="632" Canvas.Top="105"/>
                            <Button x:Name="GamepadA" Style="{StaticResource GamepadRoundButtonStyle}"
                                    Content="A" Canvas.Left="632" Canvas.Top="173"/>
                            <Button x:Name="GamepadX" Style="{StaticResource GamepadRoundButtonStyle}"
                                    Content="X" Canvas.Left="592" Canvas.Top="139"/>
                            <Button x:Name="GamepadB" Style="{StaticResource GamepadRoundButtonStyle}"
                                    Content="B" Canvas.Left="672" Canvas.Top="139"/>

                        </Canvas>
                    </Viewbox>
                </ScrollViewer>
            </Border>

            <!-- 卡片2：说明 -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}" Height="70">
                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Width="779"
                           Text="手柄触发键单选： 直接按下手柄上的按键选中并保存，需要开启手柄拾取才能设置触发键"/>
            </Border>

        </StackPanel>
    </Grid>
</Page>