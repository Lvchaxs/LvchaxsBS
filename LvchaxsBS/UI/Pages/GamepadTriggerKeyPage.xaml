<Page x:Class="LvchaxsBS.UI.Pages.GamepadTriggerKeyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <Page.Resources>

        <!-- ============ 按键外观 ============ -->

        <!-- 基础按键：小圆角方块 -->
        <Style x:Key="GpBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆形按键（ABXY / 摇杆帽 / 系统圆键） -->
        <Style x:Key="GpRound" TargetType="Button" BasedOn="{StaticResource GpBtn}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="100">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ABXY 功能键：圆形 + 字母用 Xbox 配色（A 绿 / B 红 / X 蓝 / Y 黄） -->
        <Style x:Key="GpAB" TargetType="Button" BasedOn="{StaticResource GpRound}">
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- 肩键 / 扳机：胶囊形 -->
        <Style x:Key="GpPill" TargetType="Button" BasedOn="{StaticResource GpBtn}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="100">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 系统小按键（View / Menu / 触摸板 / 麦克风） -->
        <Style x:Key="GpMini" TargetType="Button" BasedOn="{StaticResource GpBtn}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style x:Key="GpMiniRound" TargetType="Button" BasedOn="{StaticResource GpMini}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="100">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 方向键：叠在"盘状十字"上的透明热区，默认不抢视觉 -->
        <Style x:Key="GpDPad" TargetType="Button" BasedOn="{StaticResource GpBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="100">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <!-- 用 Grid + "*" 行把可用高度交给手柄卡片：
         这样 Viewbox 拿到的是有界高度，会自动缩放到刚好放得下（之前套了 ScrollViewer，
         它给内容"无限高度"，Viewbox 就不缩放、按原始尺寸撑出页面外被裁掉）。 -->
    <Grid Margin="5,4,5,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 卡片1：手柄造型（画布已收紧到图形外接框 600x412，最大化缩放比例） -->
        <Border Grid.Row="0" Style="{StaticResource ModuleFunctionCardAutoStyle}">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="2,4,2,4">
                <Canvas Width="600" Height="412" Background="Transparent">

                    <!-- ===== 手柄外壳 =====
                         轮廓：拱形顶盖 → 圆肩外扩 → 近直两侧 → 底部两段握把 + 平滑 V 形缺口 -->
                    <Path Fill="{DynamicResource CardBackgroundBrush}"
                          Stroke="{DynamicResource BorderStrongBrush}"
                          StrokeThickness="1.5"
                          IsHitTestVisible="False"
                          Data="M 76,62
                                C 158,42 438,42 520,62
                                C 556,70 572,92 576,132
                                C 582,182 586,232 584,272
                                C 582,318 570,362 548,382
                                C 524,402 482,404 450,390
                                C 426,380 406,352 396,322
                                C 386,292 360,266 328,256
                                C 310,250 286,250 268,256
                                C 236,266 210,292 200,322
                                C 190,352 170,380 146,390
                                C 114,404 72,402 48,382
                                C 26,362 14,318 12,272
                                C 10,232 14,182 20,132
                                C 24,92 40,70 76,62 Z">
                        <Path.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.30"
                                              BlurRadius="20" ShadowDepth="7" Direction="270"/>
                        </Path.Effect>
                    </Path>

                    <!-- ===== 顶部：扳机 LT/RT（外）+ 肩键 LB/RB（内）===== -->
                    <Button x:Name="GamepadL2" Style="{StaticResource GpPill}" Content="LT"
                            Canvas.Left="20" Canvas.Top="0" Width="84" Height="28"/>
                    <Button x:Name="GamepadL1" Style="{StaticResource GpPill}" Content="LB"
                            Canvas.Left="16" Canvas.Top="30" Width="88" Height="26"/>

                    <Button x:Name="GamepadR2" Style="{StaticResource GpPill}" Content="RT"
                            Canvas.Left="492" Canvas.Top="0" Width="84" Height="28"/>
                    <Button x:Name="GamepadR1" Style="{StaticResource GpPill}" Content="RB"
                            Canvas.Left="492" Canvas.Top="30" Width="88" Height="26"/>

                    <!-- ===== 中部：View / Xbox / Menu ===== -->
                    <Button x:Name="GamepadCreate" Style="{StaticResource GpMiniRound}" Content="View"
                            Canvas.Left="200" Canvas.Top="98" Width="28" Height="28"/>
                    <Button x:Name="GamepadPS" Style="{StaticResource GpMiniRound}"
                            Canvas.Left="274" Canvas.Top="90" Width="48" Height="48"
                            ToolTip="Xbox 指南键">
                        <Path Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="2.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 3,3 L 15,15 M 15,3 L 3,15"
                              Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="GamepadOptions" Style="{StaticResource GpMiniRound}" Content="Menu"
                            Canvas.Left="368" Canvas.Top="98" Width="28" Height="28"/>

                    <!-- 触摸板 / 麦克风 -->
                    <Button x:Name="GamepadTouchPad" Style="{StaticResource GpPill}" Content="触摸板"
                            Canvas.Left="194" Canvas.Top="144" Width="100" Height="26"/>
                    <Button x:Name="GamepadMic" Style="{StaticResource GpPill}" Content="麦克风"
                            Canvas.Left="302" Canvas.Top="144" Width="100" Height="26"/>

                    <!-- ===== 左翼：左摇杆 L3（上）+ 盘状方向键（下）===== -->

                    <!-- 摇杆：外圈凹槽 + 摇杆帽 + 帽内同心圈 -->
                    <Ellipse Canvas.Left="58" Canvas.Top="94" Width="100" Height="100"
                             Fill="{DynamicResource CardBackgroundBrush}"
                             Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.5"
                             IsHitTestVisible="False"/>
                    <Button x:Name="GamepadL3" Style="{StaticResource GpRound}" Content="L3"
                            Canvas.Left="75" Canvas.Top="111" Width="66" Height="66"/>
                    <Ellipse Canvas.Left="84" Canvas.Top="120" Width="48" Height="48"
                             Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                             Opacity="0.7" Fill="Transparent"
                             IsHitTestVisible="False"/>

                    <!-- 方向键：盘状底 + 十字凸脊 + 四个热区 -->
                    <Ellipse Canvas.Left="46" Canvas.Top="212" Width="92" Height="92"
                             Fill="{DynamicResource CardBackgroundBrush}"
                             Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.5"
                             IsHitTestVisible="False"/>
                    <Path Stroke="{DynamicResource BorderStrongBrush}"
                          StrokeThickness="24"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Opacity="0.28"
                          Data="M 92,228 L 92,288 M 62,258 L 122,258"
                          IsHitTestVisible="False"/>

                    <Button x:Name="GamepadDPadUp" Style="{StaticResource GpDPad}" Content="↑"
                            Canvas.Left="77" Canvas.Top="217"/>
                    <Button x:Name="GamepadDPadDown" Style="{StaticResource GpDPad}" Content="↓"
                            Canvas.Left="77" Canvas.Top="269"/>
                    <Button x:Name="GamepadDPadLeft" Style="{StaticResource GpDPad}" Content="←"
                            Canvas.Left="51" Canvas.Top="243"/>
                    <Button x:Name="GamepadDPadRight" Style="{StaticResource GpDPad}" Content="→"
                            Canvas.Left="103" Canvas.Top="243"/>

                    <!-- ===== 右翼：ABXY（上，字母用 Xbox 配色）+ 右摇杆 R3（下）===== -->

                    <Button x:Name="GamepadY" Style="{StaticResource GpAB}"
                            Canvas.Left="468" Canvas.Top="84" Width="40" Height="40">
                        <TextBlock Text="Y" FontWeight="Bold" Foreground="#E5A50A"/>
                    </Button>
                    <Button x:Name="GamepadX" Style="{StaticResource GpAB}"
                            Canvas.Left="428" Canvas.Top="124" Width="40" Height="40">
                        <TextBlock Text="X" FontWeight="Bold" Foreground="#3080E0"/>
                    </Button>
                    <Button x:Name="GamepadB" Style="{StaticResource GpAB}"
                            Canvas.Left="508" Canvas.Top="124" Width="40" Height="40">
                        <TextBlock Text="B" FontWeight="Bold" Foreground="#E5484D"/>
                    </Button>
                    <Button x:Name="GamepadA" Style="{StaticResource GpAB}"
                            Canvas.Left="468" Canvas.Top="164" Width="40" Height="40">
                        <TextBlock Text="A" FontWeight="Bold" Foreground="#23A55A"/>
                    </Button>

                    <!-- 右摇杆 -->
                    <Ellipse Canvas.Left="446" Canvas.Top="208" Width="100" Height="100"
                             Fill="{DynamicResource CardBackgroundBrush}"
                             Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.5"
                             IsHitTestVisible="False"/>
                    <Button x:Name="GamepadR3" Style="{StaticResource GpRound}" Content="R3"
                            Canvas.Left="463" Canvas.Top="225" Width="66" Height="66"/>
                    <Ellipse Canvas.Left="472" Canvas.Top="234" Width="48" Height="48"
                             Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                             Opacity="0.7" Fill="Transparent"
                             IsHitTestVisible="False"/>

                </Canvas>
            </Viewbox>
        </Border>

        <!-- 卡片2：说明 + 当前触发键 -->
        <Border Grid.Row="1" Style="{StaticResource ModuleFunctionCardStyle}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="手柄触发键单选：直接按下手柄上的对应按键即可选中并保存（也可鼠标点击），再按一次可取消"/>

                <TextBlock x:Name="CurrentKeyText"
                           FontSize="12"
                           Margin="0,4,0,0"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           Text="当前设置：未设置"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>
