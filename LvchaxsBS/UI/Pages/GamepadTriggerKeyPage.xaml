<Page x:Class="LvchaxsBS.UI.Pages.GamepadTriggerKeyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <Page.Resources>

        <!-- 手柄上的按键：小圆角方块 -->
        <Style x:Key="GpBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 悬停 / 按下 / 选中：与各功能的键盘触发键（KeyButtonStyle）保持一致 ——
                                 悬停只加深边框（背景不动，不做成"透明感"），按下才换背景色，
                                 选中用主题蓝（PrimaryLight 底 + Primary 边 + PrimaryDark 字） -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource Gray400Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆形按键（ABXY / 摇杆按下）：带轻微落影，做出"有厚度"的层次 -->
        <Style x:Key="GpRound" TargetType="Button" BasedOn="{StaticResource GpBtn}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="100">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.18"
                                                  BlurRadius="6" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 与键盘触发键同一套：悬停只变边框、按下换背景、选中用主题蓝 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource Gray400Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 系统小按键（View / Xbox / Menu / 触摸板 / 麦克风） -->
        <Style x:Key="GpMini" TargetType="Button" BasedOn="{StaticResource GpBtn}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <!-- 方向键：叠在盘状十字上的透明热区，不再用方格拼 -->
        <Style x:Key="GpDPad" TargetType="Button" BasedOn="{StaticResource GpBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="100">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 方向键热区本身没有边框（BorderThickness=0），所以悬停给一层很淡的底色，
                                 而不是像其它按键那样只改边框；选中同样用主题蓝 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Gray100Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <!-- 用 Grid + "*" 行约束高度：Viewbox 才能拿到有界尺寸自动缩放。
         外层不能再套 ScrollViewer（它给内容无限高度，会让 Viewbox 失效、内容溢出被裁）。 -->
    <Grid Margin="5,4,5,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 卡片1：手柄造型
             画布收紧到图形外接框（664x312）：内容用一个 -60 偏移的内层 Canvas 承载，
             不用改动任何既有坐标，又能省掉缩放时的空白浪费、把手柄画得更大。 -->
        <Border Grid.Row="0" Style="{StaticResource ModuleFunctionCardAutoStyle}">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="2,4,2,4">
                <Canvas Width="664" Height="312" Background="Transparent">
                    <Canvas Canvas.Left="-60">

                        <!-- ===== 手柄外壳（纯装饰，不参与点击） ===== -->
                        <Path IsHitTestVisible="False"
                              Fill="{DynamicResource CardBackgroundBrush}"
                              Stroke="{DynamicResource BorderStrongBrush}"
                              StrokeThickness="1.5"
                              Data="M 165,58 L 615,58
                                    C 665,58 700,80 706,130
                                    C 712,185 700,250 655,278
                                    C 610,305 555,285 528,238
                                    C 505,199 455,190 390,190
                                    C 325,190 275,199 252,238
                                    C 225,285 170,305 125,278
                                    C 80,250 68,185 74,130
                                    C 80,80 115,58 165,58 Z">
                            <Path.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.32"
                                                  BlurRadius="18" ShadowDepth="6" Direction="270"/>
                            </Path.Effect>
                        </Path>

                        <!-- ===== 顶部：扳机 LT/RT（外）+ 肩键 LB/RB（内）===== -->
                        <Button x:Name="GamepadL2" Style="{StaticResource GpBtn}" Content="LT"
                                Canvas.Left="128" Canvas.Top="8" Width="76"/>
                        <Button x:Name="GamepadL1" Style="{StaticResource GpBtn}" Content="LB"
                                Canvas.Left="128" Canvas.Top="42" Width="76"/>

                        <Button x:Name="GamepadR2" Style="{StaticResource GpBtn}" Content="RT"
                                Canvas.Left="576" Canvas.Top="8" Width="76"/>
                        <Button x:Name="GamepadR1" Style="{StaticResource GpBtn}" Content="RB"
                                Canvas.Left="576" Canvas.Top="42" Width="76"/>

                        <!-- ===== 中部：系统按键 ===== -->
                        <Button x:Name="GamepadCreate" Style="{StaticResource GpMini}" Content="View"
                                Canvas.Left="292" Canvas.Top="74" Width="56"/>
                        <Button x:Name="GamepadPS" Style="{StaticResource GpMini}" Content="Xbox"
                                Canvas.Left="352" Canvas.Top="74" Width="48"/>
                        <Button x:Name="GamepadOptions" Style="{StaticResource GpMini}" Content="Menu"
                                Canvas.Left="404" Canvas.Top="74" Width="62"/>

                        <Button x:Name="GamepadTouchPad" Style="{StaticResource GpMini}" Content="触摸板"
                                Canvas.Left="286" Canvas.Top="108" Width="88"/>
                        <Button x:Name="GamepadMic" Style="{StaticResource GpMini}" Content="麦克风"
                                Canvas.Left="378" Canvas.Top="108" Width="88"/>

                        <!-- ===== 左翼：左摇杆 L3（上）+ 方向键（下）===== -->
                        <Ellipse Canvas.Left="134" Canvas.Top="84" Width="76" Height="76"
                                 Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.5"
                                 Fill="Transparent"
                                 IsHitTestVisible="False"/>
                        <Ellipse Canvas.Left="142" Canvas.Top="92" Width="60" Height="60"
                                 Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                                 Opacity="0.6" Fill="Transparent"
                                 IsHitTestVisible="False"/>
                        <Button x:Name="GamepadL3" Style="{StaticResource GpRound}" Content="L3"
                                Canvas.Left="148" Canvas.Top="98" Width="48" Height="48"/>

                        <!-- 方向键：盘状底 + 十字凸脊（原来的四个方格已去掉） -->
                        <Ellipse Canvas.Left="110" Canvas.Top="166" Width="120" Height="120"
                                 Fill="{DynamicResource CardBackgroundBrush}"
                                 Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.5"
                                 IsHitTestVisible="False"/>
                        <Path Stroke="{DynamicResource BorderStrongBrush}"
                              StrokeThickness="26"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Opacity="0.28"
                              Data="M 170,190 L 170,262 M 134,226 L 206,226"
                              IsHitTestVisible="False"/>

                        <Button x:Name="GamepadDPadUp" Style="{StaticResource GpDPad}" Content="↑"
                                Canvas.Left="155" Canvas.Top="185"/>
                        <Button x:Name="GamepadDPadDown" Style="{StaticResource GpDPad}" Content="↓"
                                Canvas.Left="155" Canvas.Top="237"/>
                        <Button x:Name="GamepadDPadLeft" Style="{StaticResource GpDPad}" Content="←"
                                Canvas.Left="129" Canvas.Top="211"/>
                        <Button x:Name="GamepadDPadRight" Style="{StaticResource GpDPad}" Content="→"
                                Canvas.Left="181" Canvas.Top="211"/>

                        <!-- ===== 右翼：功能键 ABXY（上，字母用 Xbox 配色）+ 右摇杆 R3（下）===== -->
                        <!-- 字母不再用 Xbox 配色：不设 Foreground，直接继承按钮的前景色
                             （默认 TextPrimaryBrush，选中时随样式变成 PrimaryDarkBrush） -->
                        <Button x:Name="GamepadY" Style="{StaticResource GpRound}"
                                Canvas.Left="587" Canvas.Top="71" Width="46" Height="46">
                            <TextBlock Text="Y" FontWeight="Bold"/>
                        </Button>
                        <Button x:Name="GamepadX" Style="{StaticResource GpRound}"
                                Canvas.Left="541" Canvas.Top="117" Width="46" Height="46">
                            <TextBlock Text="X" FontWeight="Bold"/>
                        </Button>
                        <Button x:Name="GamepadB" Style="{StaticResource GpRound}"
                                Canvas.Left="633" Canvas.Top="117" Width="46" Height="46">
                            <TextBlock Text="B" FontWeight="Bold"/>
                        </Button>
                        <Button x:Name="GamepadA" Style="{StaticResource GpRound}"
                                Canvas.Left="587" Canvas.Top="163" Width="46" Height="46">
                            <TextBlock Text="A" FontWeight="Bold"/>
                        </Button>

                        <Ellipse Canvas.Left="572" Canvas.Top="206" Width="76" Height="76"
                                 Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.5"
                                 Fill="Transparent"
                                 IsHitTestVisible="False"/>
                        <Ellipse Canvas.Left="582" Canvas.Top="216" Width="56" Height="56"
                                 Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                                 Opacity="0.6" Fill="Transparent"
                                 IsHitTestVisible="False"/>
                        <Button x:Name="GamepadR3" Style="{StaticResource GpRound}" Content="R3"
                                Canvas.Left="586" Canvas.Top="220" Width="48" Height="48"/>

                    </Canvas>
                </Canvas>
            </Viewbox>
        </Border>

        <!-- 卡片2：说明 + 当前触发键 -->
        <Border Grid.Row="1" Style="{StaticResource ModuleFunctionCardStyle}" Height="70">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="手柄触发键单选：直接按下手柄上的对应按键即可选中并保存（也可鼠标点击），再按一次可取消"/>

                <TextBlock x:Name="CurrentKeyText"
                           FontSize="12"
                           Margin="0,4,0,0"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           Text="当前设置：未设置"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>
