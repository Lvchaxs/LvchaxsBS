<Page x:Class="LvchaxsBS.UI.Pages.GamepadTriggerKeyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <Page.Resources>

        <!-- 握把防滑颗粒纹理（Series 手柄的标志性细节） -->
        <DrawingBrush x:Key="GpDots" TileMode="Tile"
                      Viewport="0,0,10,10" ViewportUnits="Absolute"
                      Viewbox="0,0,10,10" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#8A8A93">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="3,3" RadiusX="1.2" RadiusY="1.2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ============ 按键外观 ============ -->

        <!-- 基础按键：小圆角方块 -->
        <Style x:Key="GpBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆形按键（ABXY / 摇杆帽 / 系统圆键） -->
        <Style x:Key="GpRound" TargetType="Button" BasedOn="{StaticResource GpBtn}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="100">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ABXY 功能键：圆形 + 字母用 Xbox 配色（A 绿 / B 红 / X 蓝 / Y 黄） -->
        <Style x:Key="GpAB" TargetType="Button" BasedOn="{StaticResource GpRound}">
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- 肩键 / 扳机：胶囊形 -->
        <Style x:Key="GpPill" TargetType="Button" BasedOn="{StaticResource GpBtn}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="100">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 系统小按键（View / Menu / 触摸板 / 麦克风） -->
        <Style x:Key="GpMini" TargetType="Button" BasedOn="{StaticResource GpBtn}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style x:Key="GpMiniRound" TargetType="Button" BasedOn="{StaticResource GpMini}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="100">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 方向键：叠在"盘状十字"上的透明热区，默认不抢视觉 -->
        <Style x:Key="GpDPad" TargetType="Button" BasedOn="{StaticResource GpBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="100">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <StackPanel Margin="5,4,5,0">

            <!-- 卡片1：手柄造型 -->
            <Border Style="{StaticResource ModuleFunctionCardAutoStyle}">
                <ScrollViewer Style="{StaticResource CustomScrollViewer}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="0,6,0,6">
                        <Canvas Width="780" Height="412" Background="Transparent">

                            <!-- ===== 手柄外壳 =====
                                 轮廓：拱形顶盖 → 斜肩外扩 → 近直的两侧 → 底部两段圆润握把 + 中间缺口。
                                 同一段路径复用于下方握把纹理层（用矩形 Clip 只截取下段）。 -->
                            <Path Fill="{DynamicResource CardBackgroundBrush}"
                                  Stroke="{DynamicResource BorderStrongBrush}"
                                  StrokeThickness="1.5"
                                  IsHitTestVisible="False"
                                  Data="M 168,74
                                        C 250,46 530,46 612,74
                                        C 654,86 674,110 678,156
                                        C 682,206 684,248 680,288
                                        C 676,334 658,366 622,382
                                        C 598,394 566,400 538,392
                                        C 516,384 488,378 476,358
                                        C 468,326 466,272 456,248
                                        C 434,234 346,234 324,248
                                        C 314,272 312,326 304,358
                                        C 292,378 264,384 242,392
                                        C 214,400 182,394 158,382
                                        C 122,366 104,334 100,288
                                        C 96,248 98,206 102,156
                                        C 126,110 146,86 168,74 Z">
                                <Path.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.30"
                                                      BlurRadius="20" ShadowDepth="7" Direction="270"/>
                                </Path.Effect>
                            </Path>

                            <!-- ===== 握把防滑纹理：套用同一轮廓，再用矩形 Clip 只截取下半段 ===== -->
                            <Path Fill="{StaticResource GpDots}"
                                  Opacity="0.32"
                                  Clip="M 40,232 L 740,232 L 740,424 L 40,424 Z"
                                  IsHitTestVisible="False"
                                  Data="M 168,74
                                        C 250,46 530,46 612,74
                                        C 654,86 674,110 678,156
                                        C 682,206 684,248 680,288
                                        C 676,334 658,366 622,382
                                        C 598,394 566,400 538,392
                                        C 516,384 488,378 476,358
                                        C 468,326 466,272 456,248
                                        C 434,234 346,234 324,248
                                        C 314,272 312,326 304,358
                                        C 292,378 264,384 242,392
                                        C 214,400 182,394 158,382
                                        C 122,366 104,334 100,288
                                        C 96,248 98,206 102,156
                                        C 126,110 146,86 168,74 Z"/>

                            <!-- ===== 顶部：扳机 LT/RT（外）+ 肩键 LB/RB（内）===== -->
                            <Button x:Name="GamepadL2" Style="{StaticResource GpPill}" Content="LT"
                                    Canvas.Left="112" Canvas.Top="6" Width="84" Height="28"/>
                            <Button x:Name="GamepadL1" Style="{StaticResource GpPill}" Content="LB"
                                    Canvas.Left="108" Canvas.Top="36" Width="88" Height="26"/>

                            <Button x:Name="GamepadR2" Style="{StaticResource GpPill}" Content="RT"
                                    Canvas.Left="584" Canvas.Top="6" Width="84" Height="28"/>
                            <Button x:Name="GamepadR1" Style="{StaticResource GpPill}" Content="RB"
                                    Canvas.Left="584" Canvas.Top="36" Width="88" Height="26"/>

                            <!-- ===== 中部：View / Xbox / Menu ===== -->
                            <Button x:Name="GamepadCreate" Style="{StaticResource GpMiniRound}" Content="View"
                                    Canvas.Left="292" Canvas.Top="98" Width="28" Height="28"/>
                            <Button x:Name="GamepadPS" Style="{StaticResource GpMiniRound}"
                                    Canvas.Left="366" Canvas.Top="90" Width="48" Height="48"
                                    ToolTip="Xbox 指南键">
                                <Path Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeThickness="2.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 3,3 L 15,15 M 15,3 L 3,15"
                                      Width="18" Height="18" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="GamepadOptions" Style="{StaticResource GpMiniRound}" Content="Menu"
                                    Canvas.Left="460" Canvas.Top="98" Width="28" Height="28"/>

                            <!-- 触摸板 / 麦克风 -->
                            <Button x:Name="GamepadTouchPad" Style="{StaticResource GpPill}" Content="触摸板"
                                    Canvas.Left="286" Canvas.Top="144" Width="100" Height="26"/>
                            <Button x:Name="GamepadMic" Style="{StaticResource GpPill}" Content="麦克风"
                                    Canvas.Left="394" Canvas.Top="144" Width="100" Height="26"/>

                            <!-- ===== 左翼：左摇杆 L3（上）+ 盘状方向键（下）===== -->

                            <!-- 摇杆：外圈凹槽 + 摇杆帽 + 帽内同心圈 -->
                            <Ellipse Canvas.Left="150" Canvas.Top="94" Width="100" Height="100"
                                     Fill="{DynamicResource CardBackgroundBrush}"
                                     Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.5"
                                     IsHitTestVisible="False"/>
                            <Button x:Name="GamepadL3" Style="{StaticResource GpRound}" Content="L3"
                                    Canvas.Left="167" Canvas.Top="111" Width="66" Height="66"/>
                            <Ellipse Canvas.Left="176" Canvas.Top="120" Width="48" Height="48"
                                     Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                                     Opacity="0.7" Fill="Transparent"
                                     IsHitTestVisible="False"/>

                            <!-- 方向键：盘状底 + 十字凸脊 + 四个热区 -->
                            <Ellipse Canvas.Left="138" Canvas.Top="212" Width="92" Height="92"
                                     Fill="{DynamicResource CardBackgroundBrush}"
                                     Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.5"
                                     IsHitTestVisible="False"/>
                            <Path Stroke="{DynamicResource BorderStrongBrush}"
                                  StrokeThickness="24"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Opacity="0.28"
                                  Data="M 184,228 L 184,288 M 154,258 L 214,258"
                                  IsHitTestVisible="False"/>

                            <Button x:Name="GamepadDPadUp" Style="{StaticResource GpDPad}" Content="↑"
                                    Canvas.Left="169" Canvas.Top="217"/>
                            <Button x:Name="GamepadDPadDown" Style="{StaticResource GpDPad}" Content="↓"
                                    Canvas.Left="169" Canvas.Top="269"/>
                            <Button x:Name="GamepadDPadLeft" Style="{StaticResource GpDPad}" Content="←"
                                    Canvas.Left="143" Canvas.Top="243"/>
                            <Button x:Name="GamepadDPadRight" Style="{StaticResource GpDPad}" Content="→"
                                    Canvas.Left="195" Canvas.Top="243"/>

                            <!-- ===== 右翼：ABXY（上，字母用 Xbox 配色）+ 右摇杆 R3（下）===== -->

                            <Button x:Name="GamepadY" Style="{StaticResource GpAB}"
                                    Canvas.Left="560" Canvas.Top="84" Width="40" Height="40">
                                <TextBlock Text="Y" FontWeight="Bold" Foreground="#E5A50A"/>
                            </Button>
                            <Button x:Name="GamepadX" Style="{StaticResource GpAB}"
                                    Canvas.Left="520" Canvas.Top="124" Width="40" Height="40">
                                <TextBlock Text="X" FontWeight="Bold" Foreground="#3080E0"/>
                            </Button>
                            <Button x:Name="GamepadB" Style="{StaticResource GpAB}"
                                    Canvas.Left="600" Canvas.Top="124" Width="40" Height="40">
                                <TextBlock Text="B" FontWeight="Bold" Foreground="#E5484D"/>
                            </Button>
                            <Button x:Name="GamepadA" Style="{StaticResource GpAB}"
                                    Canvas.Left="560" Canvas.Top="164" Width="40" Height="40">
                                <TextBlock Text="A" FontWeight="Bold" Foreground="#23A55A"/>
                            </Button>

                            <!-- 右摇杆 -->
                            <Ellipse Canvas.Left="538" Canvas.Top="208" Width="100" Height="100"
                                     Fill="{DynamicResource CardBackgroundBrush}"
                                     Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.5"
                                     IsHitTestVisible="False"/>
                            <Button x:Name="GamepadR3" Style="{StaticResource GpRound}" Content="R3"
                                    Canvas.Left="555" Canvas.Top="225" Width="66" Height="66"/>
                            <Ellipse Canvas.Left="564" Canvas.Top="234" Width="48" Height="48"
                                     Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                                     Opacity="0.7" Fill="Transparent"
                                     IsHitTestVisible="False"/>

                        </Canvas>
                    </Viewbox>
                </ScrollViewer>
            </Border>

            <!-- 卡片2：说明 + 当前触发键 -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}" Height="70">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="手柄触发键单选：直接按下手柄上的对应按键即可选中并保存（也可鼠标点击），再按一次可取消"/>

                    <TextBlock x:Name="CurrentKeyText"
                               FontSize="12"
                               Margin="0,4,0,0"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               Text="当前设置：未设置"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Page>
