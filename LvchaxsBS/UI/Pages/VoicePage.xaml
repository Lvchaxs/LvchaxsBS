<Page x:Class="LvchaxsBS.UI.Pages.VoicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
      xmlns:ui="clr-namespace:LvchaxsBS.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="VoicePage"
      Background="Transparent">

    <Grid Margin="5,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource ModuleFunctionCardStyle}"
                Height="70"
                Margin="0,0,6,8">
            <StackPanel Margin="10,4" VerticalAlignment="Center">

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="字幕悬浮窗"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <controls:SpinSliderControl x:Name="SubtitleOpacitySlider"
                                                Grid.Column="1"
                                                Minimum="0" Maximum="100"
                                                Value="80" Step="1"
                                                Unit="%" NumericFormat="F0"
                                                VerticalAlignment="Center" Height="26"
                                                ui:ToastNotifier.Message="字幕悬浮窗"/>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
               Text="列表排序："
               FontSize="11"
               Foreground="{DynamicResource TextSecondaryBrush}"
               VerticalAlignment="Center"/>

                    <controls:DropDownSelect x:Name="SortFieldSelect"
                             Grid.Column="1"
                             Width="80"
                             Height="20"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"
                             ui:ToastNotifier.Message="排序字段"/>

                    <controls:DropDownSelect x:Name="SortOrderSelect"
                             Grid.Column="2"
                             Width="70"
                             Height="20"
                             VerticalAlignment="Center"
                             Margin="0,0,20,0"
                             ui:ToastNotifier.Message="排序方向"/>

                    <TextBlock Grid.Column="3"
               Text="角色名搜索："
               FontSize="11"
               Foreground="{DynamicResource TextSecondaryBrush}"
               VerticalAlignment="Center"/>

                    <TextBox x:Name="SearchBox"
             Grid.Column="4"
             Width="200"
             Height="20"
             VerticalAlignment="Center"
             Style="{StaticResource PublicTextBoxStyle}"/>

                    <TextBlock x:Name="StatsText"
               Grid.Column="5"
               FontSize="11"
               Foreground="{DynamicResource TextSecondaryBrush}"
               VerticalAlignment="Center"
               Margin="10,0,0,0"/>

                    <Button x:Name="OpenVoiceFolderBtn"
            Grid.Column="6"
            Style="{StaticResource FolderIconButtonStyle}"
            HorizontalAlignment="Right"
            Margin="0,0,30,0"
            controls:ButtonTip.Text="打开文件夹"
            Click="OpenVoiceFolderBtn_Click"/>

                    <Button x:Name="RefreshButton"
            Grid.Column="6"
            Style="{StaticResource RefreshIconButtonStyle}"
            HorizontalAlignment="Right"
            controls:ButtonTip.Text="刷新"
            Click="RefreshButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Style="{StaticResource CustomScrollViewer}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Border x:Name="KongCard"
                        Style="{StaticResource ModuleFunctionCardAutoStyle}">
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="48" Height="48"
                                CornerRadius="24"
                                ClipToBounds="True"
                                Background="{DynamicResource Gray100Brush}"
                                Margin="0,0,8,0">
                            <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/Voice/Pictures/空.png"
                                   Width="48" Height="48"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="空"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <Border Grid.Column="2"
                                Background="{DynamicResource Gray200Brush}"
                                CornerRadius="3"
                                Padding="4,1"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0">
                            <TextBlock x:Name="KongCountText"
                                       Text="0"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>

                        <WrapPanel x:Name="KongTagPanel"
                                   Grid.Column="3"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border x:Name="YingCard"
                        Style="{StaticResource ModuleFunctionCardAutoStyle}">
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="48" Height="48"
                                CornerRadius="24"
                                ClipToBounds="True"
                                Background="{DynamicResource Gray100Brush}"
                                Margin="0,0,8,0">
                            <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/Voice/Pictures/荧.png"
                                   Width="48" Height="48"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="荧"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <Border Grid.Column="2"
                                Background="{DynamicResource Gray200Brush}"
                                CornerRadius="3"
                                Padding="4,1"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0">
                            <TextBlock x:Name="YingCountText"
                                       Text="0"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>

                        <WrapPanel x:Name="YingTagPanel"
                                   Grid.Column="3"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="DynamicCharacterPanel"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>