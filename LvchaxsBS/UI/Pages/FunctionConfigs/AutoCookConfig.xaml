<Page x:Class="LvchaxsBS.UI.Pages.FunctionConfigs.AutoCookConfig"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
      xmlns:ui="clr-namespace:LvchaxsBS.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <ScrollViewer Style="{StaticResource CustomScrollViewer}">
        <StackPanel Margin="5,4,0,0">

            <!-- 卡片1：烹饪检测间隔 -->
            <controls:SliderCardControl x:Name="AutoCookIntervalCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/自动烹饪.png"
                                        Title="烹饪检测间隔"
                                        Hint="QTE以外的检测部分每次检测的间隔"
                                        Minimum="1" Maximum="500" Step="1"
                                        Unit="ms" NumericFormat="F0"
                                        SliderToast="烹饪检测间隔"
                                        ValueChanged="AutoCookIntervalSlider_ValueChanged"
                                        SpinLabel="匹配度:"
                                        SpinMinimum="0" SpinMaximum="1" SpinStep="0.01"
                                        SpinNumericFormat="F2"
                                        SpinToast="匹配度"
                                        SpinValueChanged="DetectThresholdSpinBox_ValueChanged">
                                        <!-- 运行状态标签（与标题同行）-->
                                        <controls:SliderCardControl.TitleContent>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:StatusTagPanel Margin="8,0,0,0"
                                                                         ScoreLabel="匹配度"
                                                                         TimeLabel="耗时"
                                                                         SourceLabel="类型"/>
                                            </StackPanel>
                                        </controls:SliderCardControl.TitleContent>
            </controls:SliderCardControl>

            <!-- 卡片2：一般品质判定 -->
            <controls:SliderCardControl x:Name="NormalJudgeCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/自动烹饪.png"
                                        Title="一般品质目标区域内判定位置"
                                        Hint="QTE中获得一般品质左侧米黄色判断区域范围"
                                        Minimum="-50" Maximum="100" Step="1"
                                        Unit="%" NumericFormat="F0"
                                        SliderToast="一般品质判定位置"
                                        ValueChanged="NormalJudgePercentSlider_ValueChanged"
                                        SpinLabel="二值化容差:"
                                        SpinMinimum="0" SpinMaximum="255" SpinStep="1"
                                        SpinNumericFormat="F0"
                                        SpinToast="一般二值化容差"
                                        SpinValueChanged="NormalBinarizeToleranceSpinBox_ValueChanged"/>

            <!-- 卡片3：完美品质判定 -->
            <controls:SliderCardControl x:Name="PerfectJudgeCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/自动烹饪.png"
                                        Title="完美品质目标区域内判定位置"
                                        Hint="QTE中获得完美品质黄色判断区域范围"
                                        Minimum="-50" Maximum="100" Step="1"
                                        Unit="%" NumericFormat="F0"
                                        SliderToast="完美品质判定位置"
                                        ValueChanged="PerfectJudgePercentSlider_ValueChanged"
                                        SpinLabel="二值化容差:"
                                        SpinMinimum="0" SpinMaximum="255" SpinStep="1"
                                        SpinNumericFormat="F0"
                                        SpinToast="完美二值化容差"
                                        SpinValueChanged="PerfectBinarizeToleranceSpinBox_ValueChanged"/>

            <!-- 卡片4：自动清药（三联动下拉，特殊布局） -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/自动烹饪.png"
                               Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="自动清药"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,6,0"/>
                            <Border Style="{StaticResource TagLabelBlueStyle}" Width="35">
                                <TextBlock Text="16:9" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TagBlueFgBrush}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource TagLabelPurpleStyle}">
                                <TextBlock Text="5120x2160" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TagPurpleFgBrush}"/>
                            </Border>
                            <Border Style="{StaticResource TagLabelGreenStyle}">
                                <TextBlock Text="3440x1440" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TagGreenFgBrush}"/>
                            </Border>
                            <Border Style="{StaticResource TagLabelRedStyle}">
                                <TextBlock Text="2560x1080" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TagRedFgBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="0,2,0,0">

                            <controls:DropDownSelect x:Name="MedicineTypeSelect"
                         Width="77" Height="22" SelectedIndex="0"
                         DropDirection="1"
                         ui:ToastNotifier.Message="药品类型"/>

                            <controls:DropDownSelect x:Name="StarLevelSelect"
                         Width="88" Height="22" Margin="6,0,0,0" SelectedIndex="0"
                         DropDirection="1"
                         ui:ToastNotifier.Message="星级"/>

                            <controls:DropDownSelect x:Name="ItemSelect"
                         Width="130" Height="22" Margin="6,0,0,0" SelectedIndex="0"
                         DropDirection="1"
                         ui:ToastNotifier.Message="物品"/>

                            <TextBlock Text="清理数量:"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>

                            <controls:SpinTextBoxControl x:Name="MedicineTotalLimitSpinBox"
                                                         Minimum="1" Maximum="2000"
                                                         Step="1"
                                                         Unit="" NumericFormat="F0"
                                                         TextBoxWidth="50"
                                                         VerticalAlignment="Center"
                                                         Margin="2,0,0,0"
                                                         ValueChanged="MedicineTotalLimitSpinBox_ValueChanged"
                                                         ui:ToastNotifier.Message="清理数量"/>

                            <TextBlock Text="识别间隔:"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>

                            <controls:SpinTextBoxControl x:Name="MedicineIntervalSpinBox"
                                                         Minimum="1" Maximum="500"
                                                         Step="1"
                                                         Unit="ms" NumericFormat="F0"
                                                         TextBoxWidth="50"
                                                         VerticalAlignment="Center"
                                                         Margin="2,0,0,0"
                                                         ValueChanged="MedicineIntervalSpinBox_ValueChanged"
                                                         ui:ToastNotifier.Message="清药间隔"/>

                            <TextBlock Text="粗匹配:"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>

                            <controls:SpinTextBoxControl x:Name="MedicineScaleFactorSpinBox"
                                                         Minimum="1" Maximum="5"
                                                         Step="1"
                                                         Unit="" NumericFormat="F0"
                                                         TextBoxWidth="38"
                                                         VerticalAlignment="Center"
                                                         Margin="2,0,0,0"
                                                         ValueChanged="MedicineScaleFactorSpinBox_ValueChanged"
                                                         ui:ToastNotifier.Message="清药粗匹配"
                                                         controls:ButtonTip.Text="1 = 原图匹配误差最小；数值越大识别速度会更快但误差会增加。(先缩放粗略匹配到目标后再对原截图相同位置进行一次精确匹配)"/>
                            
                            <TextBlock Text="匹配度:"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>

                            <controls:SpinTextBoxControl x:Name="MedicineDetectThresholdSpinBox"
                                                         Minimum="0" Maximum="1"
                                                         Step="0.01"
                                                         Unit="" NumericFormat="F2"
                                                         TextBoxWidth="45"
                                                         VerticalAlignment="Center"
                                                         Margin="2,0,0,0"
                                                         ValueChanged="MedicineDetectThresholdSpinBox_ValueChanged"
                                                         ui:ToastNotifier.Message="清药匹配度"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
