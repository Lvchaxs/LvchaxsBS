<Page x:Class="LvchaxsBS.UI.Pages.FunctionConfigs.QuickTeleportConfig"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
      xmlns:ui="clr-namespace:LvchaxsBS.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <Page.Resources>
        <!-- 地区触发键按钮：未设置=灰、已设置=主题色（观感与首页卡片的触发键按钮一致） -->
        <Style x:Key="QuickMapKeyButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyleRound6}">
            <Setter Property="Background" Value="{DynamicResource Gray100Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="未设置">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource CustomScrollViewer}">
        <StackPanel Margin="5,4,0,0">

            <!-- 卡片0：运行状态 + 三个参数 + 复选框
                 （左：两行状态标签；中：三行参数，靠右；右：三行复选框）-->
            <Border Style="{StaticResource ModuleFunctionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：两行标签（第一行右下角，第二行右侧列表）-->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="12,0,0,0">
                        <controls:StatusTagPanel x:Name="RightCornerPanel"
                                                 ScoreLabel="右下角匹配度"
                                                 TimeLabel="识别耗时"
                                                 SourceLabel="识别类型"
                                                 CountLabel="识别次数"
                                                 ShowCount="True"/>
                        <controls:StatusTagPanel x:Name="RightListPanel" Margin="0,6,0,0"
                                                 ScoreLabel="右列表匹配度"
                                                 TimeLabel="识别耗时"
                                                 SourceLabel="识别类型"
                                                 CountLabel="识别次数"
                                                 ShowCount="True"/>
                    </StackPanel>

                    <!-- 中间：三行参数（一行一个：右下角匹配度 / 右列表匹配度 / 右侧列表粗匹配），
                         和复选框一样靠右，右边留 12 的间距（与复选框列同一套边距）。
                         CompactHeight="20"：行高压到 20（原本 22）、行间距 3，
                         三行共 66，正好装进卡片固定高度 70 里（卡片样式 Height=70，不会撑高）。 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Margin="12,0,12,0">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="右下角匹配度:"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <controls:SpinTextBoxControl x:Name="RightCornerThresholdSpinBox"
                                                         Minimum="0" Maximum="1"
                                                         Step="0.01"
                                                         NumericFormat="F2"
                                                         TextBoxWidth="45"
                                                         CompactHeight="20"
                                                         VerticalAlignment="Center"
                                                         Margin="4,0,0,0"
                                                         ValueChanged="DetectThresholdSpinBox_ValueChanged"
                                                         ui:ToastNotifier.Message="右下角匹配度"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,3">
                            <TextBlock Text="右列表匹配度:"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <controls:SpinTextBoxControl x:Name="RightListThresholdSpinBox"
                                                         Minimum="0" Maximum="1"
                                                         Step="0.01"
                                                         NumericFormat="F2"
                                                         TextBoxWidth="45"
                                                         CompactHeight="20"
                                                         VerticalAlignment="Center"
                                                         Margin="4,0,0,0"
                                                         ValueChanged="RightListThresholdSpinBox_ValueChanged"
                                                         ui:ToastNotifier.Message="右列表匹配度"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                            <TextBlock Text="右侧列表粗匹配:"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <controls:SpinTextBoxControl x:Name="RightListScaleFactorSpinBox"
                                                         Minimum="1" Maximum="5"
                                                         Step="1"
                                                         NumericFormat="F0"
                                                         TextBoxWidth="40"
                                                         CompactHeight="20"
                                                         VerticalAlignment="Center"
                                                         Margin="4,0,0,0"
                                                         ValueChanged="RightListScaleFactorSpinBox_ValueChanged"
                                                         ui:ToastNotifier.Message="右侧列表粗匹配"
                                                         controls:ButtonTip.Text="1 = 原图匹配误差最小；数值越大识别速度会更快但误差会增加。(先缩放粗略匹配到目标后再对原截图相同位置进行一次精确匹配)"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 右侧：三行复选框 -->
                    <!-- 文案直接写在 CheckBox 的 Content 上（和"新版本自动更新"一样），
                         这样点文字就能勾选；常驻只显示前六个字，完整说明走悬停标签 -->
                    <!-- 靠右并且不横向拉伸：宽度只包住"勾选框 + 文字"，
                         否则整片右侧空白都属于复选框，鼠标扫过空白也会弹悬停标签 -->
                    <!-- 行高/行间距与左侧三行参数保持一致（20 / 3），两列逐行对齐，看起来不挤 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Margin="0,0,12,0">
                        <CheckBox x:Name="EnableListRecognition"
                                  Content="右侧列表识别"
                                  Style="{StaticResource PurpleCheckBoxStyle}"
                                  FontSize="11"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Height="20"
                                  Margin="0,0,0,0"
                                  Checked="EnableListRecognition_Changed"
                                  Unchecked="EnableListRecognition_Changed"
                                  ui:ToastNotifier.Message="右侧列表识别"
                                  controls:ButtonTip.Text="执行时也对右侧列表也进行识别包含/神像/秘境/宅邸/列车/临时锚点..."/>

                        <CheckBox x:Name="DisableAbyssFilter"
                                  Content="深渊剧诗过滤"
                                  Style="{StaticResource PurpleCheckBoxStyle}"
                                  FontSize="11"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Height="20"
                                  Margin="0,3,0,3"
                                  Checked="DisableAbyssFilter_Changed"
                                  Unchecked="DisableAbyssFilter_Changed"
                                  ui:ToastNotifier.Message="深渊剧诗过滤"
                                  controls:ButtonTip.Text="左键触发键时点击地图右上角深渊和剧诗区域时不执行传送"/>

                        <CheckBox x:Name="EnableRightClickCancel"
                                  Content="右键取消传送"
                                  Style="{StaticResource PurpleCheckBoxStyle}"
                                  FontSize="11"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Height="20"
                                  Margin="0,0,0,0"
                                  Checked="EnableRightClickCancel_Changed"
                                  Unchecked="EnableRightClickCancel_Changed"
                                  ui:ToastNotifier.Message="右键取消传送"
                                  controls:ButtonTip.Text="左键触发键时可以通过按下右键临时禁用传送"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 卡片1：传送延迟检测 -->
            <controls:SliderCardControl x:Name="QuickTeleportDelayCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/快速传送.png"
                                        Title="传送延迟检测"
                                        Hint="地图界面中 按下触发键后等待右下角/右侧列表UI出现后再执行的延迟"
                                        Minimum="0" Maximum="200" Step="1"
                                        Unit="ms" NumericFormat="F0"
                                        SliderToast="传送延迟检测"
                                        ValueChanged="QuickTeleportDelaySlider_ValueChanged"/>

            <!-- 卡片2：传送检测时长 -->
            <controls:SliderCardControl x:Name="RightListDelayCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/快速传送.png"
                                        Title="传送检测时长"
                                        Hint="触发后持续循环检测右下角+右侧列表，任意一个检测到直接命中"
                                        Minimum="0" Maximum="500" Step="1"
                                        Unit="ms" NumericFormat="F0"
                                        SliderToast="传送检测时长"
                                        ValueChanged="RightListDelaySlider_ValueChanged"/>

            <!-- 卡片3：右侧列表点击延迟 -->
            <controls:SliderCardControl x:Name="RightListClickDelayCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/快速传送.png"
                                        Title="右侧列表点击延迟"
                                        Hint="循环检测中如果检测到的是右侧列表中的目标时 先等待此处设置的延迟 之后再点击列表中检测到的目标位置"
                                        Minimum="0" Maximum="500" Step="1"
                                        Unit="ms" NumericFormat="F0"
                                        SliderToast="右侧列表点击延迟"
                                        ValueChanged="RightListClickDelaySlider_ValueChanged"/>

            <!-- 卡片4：右侧列表F键延迟 + 秘境F延迟（双滑条，特殊布局） -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/快速传送.png"
                               Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="13"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="右侧列表F键延迟+右侧列表秘境F延迟"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <controls:SpinSliderControl x:Name="RightListFKeyDelaySlider"
                                                        Grid.Column="0"
                                                        Minimum="0" Maximum="500"
                                                        Step="1"
                                                        Unit="ms" NumericFormat="F0"
                                                        Height="26"
                                                        Margin="0,0,10,0"
                                                        ValueChanged="RightListFKeyDelaySlider_ValueChanged"
                                                        ui:ToastNotifier.Message="右侧列表F键延迟"/>

                            <controls:SpinSliderControl x:Name="RightListAbyssFKeyDelaySlider"
                                                        Grid.Column="1"
                                                        Minimum="0" Maximum="500"
                                                        Step="1"
                                                        Unit="ms" NumericFormat="F0"
                                                        Height="26"
                                                        Margin="10,0,6,0"
                                                        ValueChanged="RightListAbyssFKeyDelaySlider_ValueChanged"
                                                        ui:ToastNotifier.Message="秘境F键延迟"/>
                        </Grid>

                        <TextBlock Grid.Row="2"
                                   Text="上一步延迟点击列表中的目标后 再次等待此处左侧延迟 之后按下F"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ==================== 快速切图 ==================== -->
            <!-- 来自旧版「快速切图」：地图界面里按地区触发键，直接把地图切到那个地区。
                 唯一变化：去掉了旧版"按开图键后 10 秒内有效"的时间窗。
                 布局：4 列 × 4 行（第一行 = 蒙德/璃月/渊下宫/层岩巨渊）。 -->

            <!-- 卡片5：各地区触发键 -->
            <Border Style="{StaticResource ModuleFunctionCardAutoStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}"
                            VerticalAlignment="Top" Margin="5,10,12,0">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/快速传送.png"
                               Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,10,12,10">
                        <Grid>
                            <TextBlock Text="快速切图"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <!-- 两个开关上下排：「启用快速切图」在上，「启用切图识别」紧贴其下（用户指定位置） -->
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <CheckBox x:Name="EnableQuickMapSwitch"
                                          Content="启用快速切图"
                                          Style="{StaticResource PurpleCheckBoxStyle}"
                                          FontSize="11"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          HorizontalAlignment="Right"
                                          Checked="EnableQuickMapSwitch_Changed"
                                          Unchecked="EnableQuickMapSwitch_Changed"/>
                                <CheckBox x:Name="EnableCutRecognition"
                                          Content="启用切图识别"
                                          Style="{StaticResource PurpleCheckBoxStyle}"
                                          FontSize="11"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          HorizontalAlignment="Right"
                                          Margin="0,5,0,0"
                                          Checked="EnableCutRecognition_Changed"
                                          Unchecked="EnableCutRecognition_Changed"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="在地图界面按下对应地区的触发键即执行快速切图；取消勾选「启用切图识别」则按下后直接执行，不做画面识别"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>

                        <UniformGrid Columns="4" Margin="0,8,0,0">
                            <Border Margin="0,3,10,3"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="蒙德" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="QuickMapKeyMondstadt" Grid.Column="1" Tag="Mondstadt"
                                            MinWidth="50" MaxWidth="120" Height="24"
                                            Style="{StaticResource QuickMapKeyButtonStyle}"
                                            Click="QuickMapKey_Click">
                                                <TextBlock Text="未设置" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                </Grid>
                            </Border>
                            <Border Margin="0,3,10,3"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="璃月" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="QuickMapKeyLiyue" Grid.Column="1" Tag="Liyue"
                                            MinWidth="50" MaxWidth="120" Height="24"
                                            Style="{StaticResource QuickMapKeyButtonStyle}"
                                            Click="QuickMapKey_Click">
                                                <TextBlock Text="未设置" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                </Grid>
                            </Border>
                            <Border Margin="0,3,10,3"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="渊下宫" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="QuickMapKeyEnkanomiya" Grid.Column="1" Tag="Enkanomiya"
                                            MinWidth="50" MaxWidth="120" Height="24"
                                            Style="{StaticResource QuickMapKeyButtonStyle}"
                                            Click="QuickMapKey_Click">
                                                <TextBlock Text="未设置" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                </Grid>
                            </Border>
                            <Border Margin="0,3,10,3"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="层岩巨渊" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="QuickMapKeyChasm" Grid.Column="1" Tag="Chasm"
                                            MinWidth="50" MaxWidth="120" Height="24"
                                            Style="{StaticResource QuickMapKeyButtonStyle}"
                                            Click="QuickMapKey_Click">
                                                <TextBlock Text="未设置" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                </Grid>
                            </Border>
                            <Border Margin="0,3,10,3"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="稻妻" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="QuickMapKeyInazuma" Grid.Column="1" Tag="Inazuma"
                                            MinWidth="50" MaxWidth="120" Height="24"
                                            Style="{StaticResource QuickMapKeyButtonStyle}"
                                            Click="QuickMapKey_Click">
                                                <TextBlock Text="未设置" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                </Grid>
                            </Border>
                            <Border Margin="0,3,10,3"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="须弥" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="QuickMapKeySumeru" Grid.Column="1" Tag="Sumeru"
                                            MinWidth="50" MaxWidth="120" Height="24"
                                            Style="{StaticResource QuickMapKeyButtonStyle}"
                                            Click="QuickMapKey_Click">
                                                <TextBlock Text="未设置" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                </Grid>
                            </Border>
                            <Border Margin="0,3,10,3"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="旧日之海" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="QuickMapKeySeaOfBygoneEras" Grid.Column="1" Tag="SeaOfBygoneEras"
                                            MinWidth="50" MaxWidth="120" Height="24"
                                            Style="{StaticResource QuickMapKeyButtonStyle}"
                                            Click="QuickMapKey_Click">
                                                <TextBlock Text="未设置" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                </Grid>
                            </Border>
                            <Border Margin="0,3,10,3"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="远古圣山" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="QuickMapKeyAncientSacredMountain" Grid.Column="1" Tag="AncientSacredMountain"
                                            MinWidth="50" MaxWidth="120" Height="24"
                                            Style="{StaticResource QuickMapKeyButtonStyle}"
                                            Click="QuickMapKey_Click">
                                                <TextBlock Text="未设置" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                </Grid>
                            </Border>
                            <Border Margin="0,3,10,3"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="枫丹" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="QuickMapKeyFontaine" Grid.Column="1" Tag="Fontaine"
                                            MinWidth="50" MaxWidth="120" Height="24"
                                            Style="{StaticResource QuickMapKeyButtonStyle}"
                                            Click="QuickMapKey_Click">
                                                <TextBlock Text="未设置" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                </Grid>
                            </Border>
                            <Border Margin="0,3,10,3"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="纳塔" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="QuickMapKeyNatlan" Grid.Column="1" Tag="Natlan"
                                            MinWidth="50" MaxWidth="120" Height="24"
                                            Style="{StaticResource QuickMapKeyButtonStyle}"
                                            Click="QuickMapKey_Click">
                                                <TextBlock Text="未设置" FontSize="11"
