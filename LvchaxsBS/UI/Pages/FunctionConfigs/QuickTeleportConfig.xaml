<Page x:Class="LvchaxsBS.UI.Pages.FunctionConfigs.QuickTeleportConfig"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
      xmlns:ui="clr-namespace:LvchaxsBS.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <ScrollViewer Style="{StaticResource CustomScrollViewer}">
        <StackPanel Margin="5,4,0,0">

            <!-- 卡片0：运行状态 + 复选框（左侧两行标签，右侧三行复选框）-->
            <Border Style="{StaticResource ModuleFunctionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：两行标签（第一行右下角，第二行右侧列表）-->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="12,0,0,0">
                        <controls:StatusTagPanel x:Name="RightCornerPanel"
                                                 ScoreLabel="右下角匹配度"
                                                 TimeLabel="识别耗时"
                                                 SourceLabel="识别类型"
                                                 CountLabel="识别次数"
                                                 ShowCount="True"/>
                        <controls:StatusTagPanel x:Name="RightListPanel" Margin="0,6,0,0"
                                                 ScoreLabel="右列表匹配度"
                                                 TimeLabel="识别耗时"
                                                 SourceLabel="识别类型"
                                                 CountLabel="识别次数"
                                                 ShowCount="True"/>
                    </StackPanel>

                    <!-- 右侧：三行复选框 -->
                    <!-- 文案直接写在 CheckBox 的 Content 上（和"新版本自动更新"一样），
                         这样点文字就能勾选；常驻只显示前六个字，完整说明走悬停标签 -->
                    <!-- 靠右并且不横向拉伸：宽度只包住"勾选框 + 文字"，
                         否则整片右侧空白都属于复选框，鼠标扫过空白也会弹悬停标签 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Margin="12,0,12,0">
                        <CheckBox x:Name="EnableListRecognition"
                                  Content="右侧列表识别"
                                  Style="{StaticResource PurpleCheckBoxStyle}"
                                  FontSize="11"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="0,1,0,1"
                                  Checked="EnableListRecognition_Changed"
                                  Unchecked="EnableListRecognition_Changed"
                                  ui:ToastNotifier.Message="右侧列表识别"
                                  controls:ButtonTip.Text="执行时也对右侧列表也进行识别包含/神像/秘境/宅邸/列车/临时锚点..."/>

                        <CheckBox x:Name="DisableAbyssFilter"
                                  Content="深渊剧诗过滤"
                                  Style="{StaticResource PurpleCheckBoxStyle}"
                                  FontSize="11"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="0,1,0,1"
                                  Checked="DisableAbyssFilter_Changed"
                                  Unchecked="DisableAbyssFilter_Changed"
                                  ui:ToastNotifier.Message="深渊剧诗过滤"
                                  controls:ButtonTip.Text="左键触发键时点击地图右上角深渊和剧诗区域时不执行传送"/>

                        <CheckBox x:Name="EnableRightClickCancel"
                                  Content="右键取消传送"
                                  Style="{StaticResource PurpleCheckBoxStyle}"
                                  FontSize="11"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="0,1,0,1"
                                  Checked="EnableRightClickCancel_Changed"
                                  Unchecked="EnableRightClickCancel_Changed"
                                  ui:ToastNotifier.Message="右键取消传送"
                                  controls:ButtonTip.Text="左键触发键时可以通过按下右键临时禁用传送"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 卡片1：传送延迟检测 -->
            <controls:SliderCardControl x:Name="QuickTeleportDelayCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/快速传送.png"
                                        Title="传送延迟检测"
                                        Hint="地图界面中 按下触发键后等待右下角/右侧列表UI出现后再执行的延迟"
                                        Minimum="0" Maximum="200" Step="1"
                                        Unit="ms" NumericFormat="F0"
                                        SliderToast="传送延迟检测"
                                        ValueChanged="QuickTeleportDelaySlider_ValueChanged"
                                        SpinLabel="右下角匹配度:"
                                        SpinMinimum="0" SpinMaximum="1" SpinStep="0.01"
                                        SpinNumericFormat="F2"
                                        SpinToast="右下角匹配度"
                                        SpinValueChanged="DetectThresholdSpinBox_ValueChanged"/>

            <!-- 卡片2：传送检测时长 -->
            <controls:SliderCardControl x:Name="RightListDelayCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/快速传送.png"
                                        Title="传送检测时长"
                                        Hint="触发后持续循环检测右下角+右侧列表，任意一个检测到直接命中"
                                        Minimum="0" Maximum="500" Step="1"
                                        Unit="ms" NumericFormat="F0"
                                        SliderToast="传送检测时长"
                                        ValueChanged="RightListDelaySlider_ValueChanged"
                                        Spin2Label="粗匹配:"
                                        Spin2Minimum="1" Spin2Maximum="10" Spin2Step="1"
                                        Spin2NumericFormat="F0"
                                        Spin2Toast="右列表粗匹配"
                                        Spin2Tip="粗匹配档位：1 = 不缩放（关闭粗匹配，原图直跑，最准最慢）；数值越大越快，但模板越糊、位置误差越大，过大可能匹配不到。建议 4-6"
                                        Spin2ValueChanged="RightListScaleFactorSpinBox_ValueChanged"
                                        SpinLabel="右列表匹配度:"
                                        SpinMinimum="0" SpinMaximum="1" SpinStep="0.01"
                                        SpinNumericFormat="F2"
                                        SpinToast="右列表匹配度"
                                        SpinValueChanged="RightListThresholdSpinBox_ValueChanged"/>

            <!-- 卡片3：右侧列表点击延迟 -->
            <controls:SliderCardControl x:Name="RightListClickDelayCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/快速传送.png"
                                        Title="右侧列表点击延迟"
                                        Hint="循环检测中如果检测到的是右侧列表中的目标时 先等待此处设置的延迟 之后再点击列表中检测到的目标位置"
                                        Minimum="0" Maximum="500" Step="1"
                                        Unit="ms" NumericFormat="F0"
                                        SliderToast="右侧列表点击延迟"
                                        ValueChanged="RightListClickDelaySlider_ValueChanged"/>

            <!-- 卡片4：右侧列表F键延迟 + 秘境F延迟（双滑条，特殊布局） -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/快速传送.png"
                               Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="13"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="右侧列表F键延迟+右侧列表秘境F延迟"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <controls:SpinSliderControl x:Name="RightListFKeyDelaySlider"
                                                        Grid.Column="0"
                                                        Minimum="0" Maximum="500"
                                                        Step="1"
                                                        Unit="ms" NumericFormat="F0"
                                                        Height="26"
                                                        Margin="0,0,10,0"
                                                        ValueChanged="RightListFKeyDelaySlider_ValueChanged"
                                                        ui:ToastNotifier.Message="右侧列表F键延迟"/>

                            <controls:SpinSliderControl x:Name="RightListAbyssFKeyDelaySlider"
                                                        Grid.Column="1"
                                                        Minimum="0" Maximum="500"
                                                        Step="1"
                                                        Unit="ms" NumericFormat="F0"
                                                        Height="26"
                                                        Margin="10,0,6,0"
                                                        ValueChanged="RightListAbyssFKeyDelaySlider_ValueChanged"
                                                        ui:ToastNotifier.Message="秘境F键延迟"/>
                        </Grid>

                        <TextBlock Grid.Row="2"
                                   Text="上一步延迟点击列表中的目标后 再次等待此处左侧延迟 之后按下F"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
