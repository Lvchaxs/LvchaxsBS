<Page x:Class="LvchaxsBS.UI.Pages.FunctionConfigs.FishingAssistConfig"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
      xmlns:ui="clr-namespace:LvchaxsBS.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <ScrollViewer Style="{StaticResource CustomScrollViewer}">
        <StackPanel Margin="5,4,0,0">

            <controls:SliderCardControl x:Name="FishingAssistCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/钓鱼辅助.png"
                                        Title="鱼竿状态检测间隔"
                                        Hint="右下角鼠标左键部分的 未抛竿/已抛竿/已上钩 三种状态图标的检测间隔"
                                        Minimum="1" Maximum="500" Step="1"
                                        Unit="ms" NumericFormat="F0"
                                        SliderToast="鱼竿状态检测间隔"
                                        ValueChanged="FishingAssistIntervalSlider_ValueChanged"
                                        SpinLabel="匹配度:"
                                        SpinMinimum="0" SpinMaximum="1" SpinStep="0.01"
                                        SpinNumericFormat="F2"
                                        SpinToast="匹配度"
                                        SpinValueChanged="DetectThresholdSpinBox_ValueChanged">
                                        <!-- 运行状态标签（与标题同行）-->
                                        <controls:SliderCardControl.TitleContent>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:StatusTagPanel Margin="8,0,0,0"
                                                                         ScoreLabel="匹配度"
                                                                         TimeLabel="耗时"
                                                                         SourceLabel="类型"/>
                                            </StackPanel>
                                        </controls:SliderCardControl.TitleContent>
            </controls:SliderCardControl>

            <controls:SliderCardControl x:Name="TensionCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/钓鱼辅助.png"
                                        Title="张力区检测间隔"
                                        Hint="游戏内上方类似QTE的持续控制滑块保持在绿色区域内的检测间隔"
                                        Minimum="1" Maximum="500" Step="1"
                                        Unit="ms" NumericFormat="F0"
                                        SliderToast="张力区检测间隔"
                                        ValueChanged="TensionIntervalSlider_ValueChanged"
                                        SpinLabel="二值化容差:"
                                        SpinMinimum="0" SpinMaximum="50" SpinStep="1"
                                        SpinNumericFormat="F0"
                                        SpinToast="张力区二值化容差"
                                        SpinValueChanged="TensionToleranceSpinBox_ValueChanged">
                                        <!-- 张力区状态标签（与标题同行）-->
                                        <controls:SliderCardControl.TitleContent>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:StatusTagPanel Margin="8,0,0,0"
                                                                         ScoreLabel="匹配度"
                                                                         TimeLabel="耗时"
                                                                         SourceLabel="类型"/>
                                            </StackPanel>
                                        </controls:SliderCardControl.TitleContent>
            </controls:SliderCardControl>

            <controls:SliderCardControl x:Name="JudgmentLineCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/钓鱼辅助.png"
                                        Title="判定线位置"
                                        Hint="上钩后的上方绿色区域范围内用百分比位置设定一个位置"
                                        Minimum="1" Maximum="100" Step="1"
                                        Unit="%" NumericFormat="F0"
                                        SliderToast="判定线位置"
                                        ValueChanged="JudgmentLineSlider_ValueChanged"/>

        </StackPanel>
    </ScrollViewer>
</Page>
