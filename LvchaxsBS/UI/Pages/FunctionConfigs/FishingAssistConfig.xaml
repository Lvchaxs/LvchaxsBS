<Page x:Class="LvchaxsBS.UI.Pages.FunctionConfigs.FishingAssistConfig"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
      xmlns:ui="clr-namespace:LvchaxsBS.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <ScrollViewer Style="{StaticResource CustomScrollViewer}">
        <StackPanel Margin="5,4,0,0">

            <!-- 卡片1：鱼竿状态检测间隔 -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/钓鱼辅助.png"
                               Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="13"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="鱼竿状态检测间隔"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="匹配度:"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <controls:SpinTextBoxControl x:Name="DetectThresholdSpinBox"
                                                         Grid.Column="3"
                                                         Minimum="0" Maximum="1"
                                                         Step="0.01"
                                                         Unit="" NumericFormat="F2"
                                                         TextBoxWidth="45"
                                                         VerticalAlignment="Center"
                                                         Margin="2,0,6,0"
                                                         ValueChanged="DetectThresholdSpinBox_ValueChanged"
                                                         ui:ToastNotifier.Message="匹配度"/>
                        </Grid>

                        <controls:SpinSliderControl x:Name="FishingAssistIntervalSlider"
                                                    Grid.Row="1"
                                                    Minimum="1" Maximum="500"
                                                    Step="1"
                                                    Unit="ms" NumericFormat="F0"
                                                    Height="26"
                                                    ValueChanged="FishingAssistIntervalSlider_ValueChanged"
                                                    ui:ToastNotifier.Message="鱼竿状态检测间隔"/>

                        <TextBlock Grid.Row="2"
                                   Text="右下角鼠标左键部分的 未抛竿/已抛竿/已上钩 三种状态图标的检测间隔"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 卡片2：张力区检测间隔 -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/钓鱼辅助.png"
                               Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="13"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="张力区检测间隔"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="二值化容差:"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <controls:SpinTextBoxControl x:Name="TensionToleranceSpinBox"
                                                         Grid.Column="3"
                                                         Minimum="0" Maximum="50"
                                                         Step="1"
                                                         Unit="" NumericFormat="F0"
                                                         TextBoxWidth="45"
                                                         VerticalAlignment="Center"
                                                         Margin="2,0,6,0"
                                                         ValueChanged="TensionToleranceSpinBox_ValueChanged"
                                                         ui:ToastNotifier.Message="张力区二值化容差"/>
                        </Grid>

                        <controls:SpinSliderControl x:Name="TensionIntervalSlider"
                                                    Grid.Row="1"
                                                    Minimum="1" Maximum="500"
                                                    Step="1"
                                                    Unit="ms" NumericFormat="F0"
                                                    Height="26"
                                                    ValueChanged="TensionIntervalSlider_ValueChanged"
                                                    ui:ToastNotifier.Message="张力区检测间隔"/>

                        <TextBlock Grid.Row="2"
                                   Text="游戏内上方类似QTE的持续控制滑块保持在绿色区域内的检测间隔"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 卡片3：判定线位置 -->
            <Border Style="{StaticResource ModuleFunctionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/钓鱼辅助.png"
                               Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="13"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="判定线位置"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <controls:SpinSliderControl x:Name="JudgmentLineSlider"
                                                    Grid.Row="1"
                                                    Minimum="1" Maximum="100"
                                                    Step="1"
                                                    Unit="%" NumericFormat="F0"
                                                    Height="26"
                                                    ValueChanged="JudgmentLineSlider_ValueChanged"
                                                    ui:ToastNotifier.Message="判定线位置"/>

                        <TextBlock Grid.Row="2"
                                   Text="上钩后的上方绿色区域范围内用百分比位置设定一个位置"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>