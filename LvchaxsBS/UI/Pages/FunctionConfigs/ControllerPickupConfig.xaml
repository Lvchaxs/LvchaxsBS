<Page x:Class="LvchaxsBS.UI.Pages.FunctionConfigs.ControllerPickupConfig"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
      xmlns:ui="clr-namespace:LvchaxsBS.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <ScrollViewer Style="{StaticResource CustomScrollViewer}">
        <StackPanel Margin="5,4,0,0">

            <Border Style="{StaticResource ModuleFunctionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconBorderStyle}" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/手柄拾取.png"
                               Width="60" Height="60" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="13"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="触发后等待点击左键的延迟"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <controls:SpinSliderControl x:Name="TriggerDelaySlider"
                                                    Grid.Row="1"
                                                    Minimum="0" Maximum="500"
                                                    Step="1"
                                                    Unit="ms" NumericFormat="F0"
                                                    Height="26"
                                                    ValueChanged="TriggerDelaySlider_ValueChanged"
                                                    ui:ToastNotifier.Message="触发延迟"/>

                        <TextBlock Grid.Row="2"
                                   Text="按下手柄上面的触发键后等待此处延迟之后再执行一次左键点击"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>