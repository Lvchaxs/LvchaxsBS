<Page x:Class="LvchaxsBS.UI.Pages.FunctionConfigs.ControllerPickupConfig"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
      xmlns:ui="clr-namespace:LvchaxsBS.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <ScrollViewer Style="{StaticResource CustomScrollViewer}">
        <StackPanel Margin="5,4,0,0">

            <controls:SliderCardControl x:Name="TriggerDelayCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/手柄拾取.png"
                                        Title="触发后等待点击左键的延迟"
                                        Hint="按下手柄上面的触发键后等待此处延迟之后再执行一次左键点击"
                                        Minimum="0" Maximum="500" Step="1"
                                        Unit="ms" NumericFormat="F0"
                                        SliderToast="触发延迟"
                                        ValueChanged="TriggerDelaySlider_ValueChanged"/>

        </StackPanel>
    </ScrollViewer>
</Page>
