<Page x:Class="LvchaxsBS.UI.Pages.FunctionConfigs.StoryDialogueConfig"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
      xmlns:ui="clr-namespace:LvchaxsBS.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <ScrollViewer Style="{StaticResource CustomScrollViewer}">
        <StackPanel Margin="5,4,0,0">

            <controls:SliderCardControl x:Name="StoryDialogueCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/剧情对话.png"
                                        Title="剧情检测间隔"
                                        Hint="运行中持续检测对话中的左上角隐藏图标的检测间隔"
                                        Minimum="1" Maximum="1000" Step="1"
                                        Unit="ms" NumericFormat="F0"
                                        SliderToast="剧情检测间隔"
                                        ValueChanged="StoryDialogueIntervalSlider_ValueChanged"
                                        SpinLabel="匹配度:"
                                        SpinMinimum="0" SpinMaximum="1" SpinStep="0.01"
                                        SpinNumericFormat="F2"
                                        SpinToast="匹配度"
                                        SpinValueChanged="DetectThresholdSpinBox_ValueChanged">
                                        <!-- 运行状态标签（与标题同行）-->
                                        <controls:SliderCardControl.TitleContent>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:StatusTagPanel Margin="8,0,0,0"
                                                                         ScoreLabel="匹配度"
                                                                         TimeLabel="耗时"
                                                                         SourceLabel="类型"/>
                                            </StackPanel>
                                        </controls:SliderCardControl.TitleContent>
            </controls:SliderCardControl>

            <controls:SliderCardControl x:Name="FKeyIntervalCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/剧情对话.png"
                                        Title="每次按下F键的循环间隔"
                                        Hint="F循环中每次按下一次F后等待的间隔"
                                        Minimum="1" Maximum="500" Step="1"
                                        Unit="ms" NumericFormat="F0"
                                        SliderToast="F键循环间隔"
                                        ValueChanged="FKeyIntervalSlider_ValueChanged"/>

        </StackPanel>
    </ScrollViewer>
</Page>
