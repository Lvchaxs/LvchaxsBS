<Page x:Class="LvchaxsBS.UI.Pages.FunctionConfigs.AutoLumberConfig"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
      xmlns:ui="clr-namespace:LvchaxsBS.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent">

    <ScrollViewer Style="{StaticResource CustomScrollViewer}">
        <StackPanel Margin="5,4,0,0">

            <controls:SliderCardControl x:Name="AutoLumberCard"
                                        Icon="pack://application:,,,/LvchaxsBS;component/UI/Assets/Images/自动伐木.png"
                                        Title="伐木检测间隔"
                                        Hint="运行中检测 小道具按下Z/获得/ESC打开派蒙菜单 的间隔"
                                        Minimum="1" Maximum="1000" Step="1"
                                        Unit="ms" NumericFormat="F0"
                                        SliderToast="伐木检测间隔"
                                        ValueChanged="AutoLumberIntervalSlider_ValueChanged"
                                        SpinLabel="匹配度:"
                                        SpinMinimum="0" SpinMaximum="1" SpinStep="0.01"
                                        SpinNumericFormat="F2"
                                        SpinToast="匹配度"
                                        SpinValueChanged="DetectThresholdSpinBox_ValueChanged">
                                        <!-- 运行状态标签（与标题同行）-->
                                        <controls:SliderCardControl.TitleContent>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:StatusTagPanel Margin="8,0,0,0"
                                                                         ScoreLabel="匹配度"
                                                                         TimeLabel="耗时"
                                                                         SourceLabel="类型"/>
                                            </StackPanel>
                                        </controls:SliderCardControl.TitleContent>
            </controls:SliderCardControl>

        </StackPanel>
    </ScrollViewer>
</Page>
