<Window x:Class="LvchaxsBS.UI.Dialogs.LicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LvchaxsBS.UI.Dialogs"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="400"
        ShowInTaskbar="False"
        Focusable="False"
        KeyboardNavigation.IsTabStop="False"
        Title="开源许可">
    <!-- 与 ConfirmDialog 同一套：顶部标题栏 + 内容 + 底部按钮栏。
         背景用 PopupBackgroundBrush（浮层专用、始终不透明）。 -->
    <Border Background="{DynamicResource PopupBackgroundBrush}"
            CornerRadius="10"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- ===== 顶部：标题栏 ===== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource DialogHeaderBackgroundBrush}"
                    CornerRadius="10,10,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="开源许可"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ===== 中间：内容 ===== -->
            <ScrollViewer Grid.Row="1"
                          MaxHeight="252"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,14,14,14">
                <TextBlock x:Name="LicenseText"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="19"/>
            </ScrollViewer>

            <!-- ===== 底部：按钮栏 ===== -->
            <Border Grid.Row="2"
                    Background="{DynamicResource DialogHeaderBackgroundBrush}"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Button x:Name="ViewFullBtn"
                            MinWidth="112" Height="30"
                            Margin="0,0,8,0"
                            Padding="10,0"
                            Style="{StaticResource SettingsButtonStyleRound6}"
                            Click="ViewFullBtn_Click">
                        <TextBlock Text="查看完整许可证" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="CloseBtn"
                            MinWidth="80" Height="30"
                            Padding="10,0"
                            Style="{StaticResource SettingsButtonStyleRound6}"
                            Click="CloseBtn_Click">
                        <TextBlock Text="关闭" VerticalAlignment="Center"/>
                    </Button>

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
