<Window x:Class="LvchaxsBS.UI.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LvchaxsBS.UI.Dialogs"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="380"
        ShowInTaskbar="False"
        Focusable="False"
        KeyboardNavigation.IsTabStop="False"
        Title="ConfirmDialog">
    <!-- 统一成「顶部标题栏 + 内容 + 底部按钮栏」三段式（与 UID 的 AddEditGroupWindow 同一套布局）。
         背景用 PopupBackgroundBrush 而不是 CardBackgroundBrush：
         卡片色会被「个性化 → 卡片透明度」覆盖成带 alpha 的画刷，
         弹窗跟着变透明就看不清了；这个键专供浮层、始终不透明。 -->
    <Border Background="{DynamicResource PopupBackgroundBrush}"
            CornerRadius="10"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- ===== 顶部：标题栏（灰底 + 下边框 + 居中标题 + 右上关闭） ===== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource DialogHeaderBackgroundBrush}"
                    CornerRadius="10,10,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Text="确认"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ===== 中间：内容 ===== -->
            <StackPanel Grid.Row="1" Margin="20,16,20,14">

                <TextBlock x:Name="MessageText"
                           Text="确定要执行此操作吗？"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,0,0,16"/>

                <!-- 附加内容区（如「新版本改动」）：默认隐藏，由调用处 SetExtraContent 填充。
                     用边框而不是填充背景 —— 避免被「卡片透明度」影响、与浮层底色保持一致。 -->
                <Border x:Name="ExtraContentBorder"
                        Visibility="Collapsed"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <ScrollViewer MaxHeight="190"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="10,8,6,8">
                        <StackPanel>
                            <TextBlock x:Name="ExtraTitleText"
                                       Text=""
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="ExtraContentText"
                                       Text=""
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="19"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- ===== 底部：按钮栏（灰底 + 上边框；左侧通用复选框、右侧按钮组） ===== -->
            <Border Grid.Row="2"
                    Background="{DynamicResource DialogHeaderBackgroundBrush}"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <!-- 通用复选框：默认显示，文案/初始值由调用处覆盖 -->
                    <CheckBox x:Name="OptionCheckBox"
                              Content=""
                              Style="{StaticResource PurpleCheckBoxStyle}"
                              Visibility="Visible"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button x:Name="OkBtn"
                                MinWidth="80" Height="30"
                                Margin="0,0,8,0"
                                Padding="10,0"
                                Style="{StaticResource SettingsButtonStyleRound6}"
                                Click="OkBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓"
                                           Foreground="{DynamicResource TagGreenFgBrush}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"/>
                                <TextBlock x:Name="OkText" Text="确认" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="CancelBtn"
                                MinWidth="80" Height="30"
                                Padding="10,0"
                                Style="{StaticResource SettingsButtonStyleRound6}"
                                Click="CancelBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕"
                                           Foreground="{DynamicResource TagRedFgBrush}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"/>
                                <TextBlock x:Name="CancelText" Text="取消" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
