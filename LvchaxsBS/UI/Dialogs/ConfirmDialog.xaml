<Window x:Class="LvchaxsBS.UI.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LvchaxsBS.UI.Dialogs"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="360"
        ShowInTaskbar="False"
        Focusable="False"
        KeyboardNavigation.IsTabStop="False"
        Title="ConfirmDialog">
    <!-- 背景用 PopupBackgroundBrush 而不是 CardBackgroundBrush：
         卡片色会被「个性化 → 卡片透明度」覆盖成带 alpha 的画刷，
         弹窗跟着变透明就看不清了；这个键专供浮层、始终不透明。 -->
    <Border Background="{DynamicResource PopupBackgroundBrush}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="20,18,20,16">

            <TextBlock x:Name="TitleText"
                       Text="确认"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="MessageText"
                       Text="确定要执行此操作吗？"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,20"/>

            <!-- 附加内容区（如「新版本改动」）：默认隐藏，由调用处 SetExtraContent 填充。
                 用边框而不是填充背景 —— 避免被「卡片透明度」影响、与浮层底色保持一致。 -->
            <Border x:Name="ExtraContentBorder"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,18">
                <ScrollViewer MaxHeight="190"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10,8,6,8">
                    <StackPanel>
                        <TextBlock x:Name="ExtraTitleText"
                                   Text=""
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="ExtraContentText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="19"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 通用复选框：默认显示，文案/初始值由调用处覆盖 -->
                <CheckBox x:Name="OptionCheckBox"
                          Grid.Column="0"
                          Content=""
                          Style="{StaticResource PurpleCheckBoxStyle}"
                          Visibility="Visible"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button x:Name="OkBtn"
                            MinWidth="80" Height="30"
                            Margin="0,0,8,0"
                            Padding="10,0"
                            Style="{StaticResource SettingsButtonStyleRound6}"
                            Click="OkBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓"
                                       Foreground="{DynamicResource TagGreenFgBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <TextBlock Text="确认" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CancelBtn"
                            MinWidth="80" Height="30"
                            Padding="10,0"
                            Style="{StaticResource SettingsButtonStyleRound6}"
                            Click="CancelBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕"
                                       Foreground="{DynamicResource TagRedFgBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <TextBlock Text="取消" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
