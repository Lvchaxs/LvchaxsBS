<Window x:Class="LvchaxsBS.UI.Dialogs.ChangelogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LvchaxsBS.UI.Dialogs"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="440"
        ShowInTaskbar="False"
        Focusable="False"
        KeyboardNavigation.IsTabStop="False"
        Title="当前版本改动">
    <!-- 与 ConfirmDialog / LicenseDialog 同一套：顶部标题栏 + 内容 + 底部按钮栏。
         背景用 PopupBackgroundBrush（浮层专用、始终不透明）。 -->
    <Border Background="{DynamicResource PopupBackgroundBrush}"
            CornerRadius="10"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- ===== 顶部：标题栏 ===== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource DialogHeaderBackgroundBrush}"
                    CornerRadius="10,10,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Text="当前版本改动"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ===== 中间：内容 ===== -->
            <ScrollViewer Grid.Row="1"
                          MaxHeight="300"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,14,14,14">
                <TextBlock x:Name="ChangelogText"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="19"/>
            </ScrollViewer>

            <!-- ===== 底部：按钮栏 ===== -->
            <Border Grid.Row="2"
                    Background="{DynamicResource DialogHeaderBackgroundBrush}"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Button x:Name="CloseBtn"
                        MinWidth="80" Height="30"
                        Padding="10,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource SettingsButtonStyleRound6}"
                        Click="CloseBtn_Click">
                    <TextBlock Text="关闭"  VerticalAlignment="Center"/>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
