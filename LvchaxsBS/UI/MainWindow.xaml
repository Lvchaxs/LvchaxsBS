<Window x:Class="LvchaxsBS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
        mc:Ignorable="d"
        Title="LvchaxsBS"
        Height="580" Width="1000"
        MinHeight="300" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        KeyboardNavigation.IsTabStop="False"
        KeyboardNavigation.TabNavigation="None"
        Icon="/UI/Assets/Images/派蒙.ico"
        PreviewMouseDown="Window_PreviewMouseDown"
        StateChanged="Window_StateChanged">

    <Border x:Name="RootBorder"
            Background="{DynamicResource AppBackgroundBrush}"
            CornerRadius="8"
            BorderThickness="0"
            SizeChanged="RootBorder_SizeChanged"
            RenderTransformOrigin="0,0">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="RootScaleTransform" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ 壁纸层（主题底色之上、所有内容之下） ============ -->
            <!-- 透明度走 Image.Opacity；模糊走 BlurEffect；缩放/旋转/位移走 TransformGroup -->
            <Image x:Name="WallpaperImage"
                   Grid.Row="0"
                   Grid.RowSpan="4"
                   Stretch="Uniform"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5">
                <Image.Effect>
                    <BlurEffect x:Name="WallpaperBlurEffect"
                                Radius="0"
                                KernelType="Gaussian"
                                RenderingBias="Performance"/>
                </Image.Effect>
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="WallpaperScale" ScaleX="1" ScaleY="1"/>
                        <RotateTransform x:Name="WallpaperRotate" Angle="0"/>
                        <TranslateTransform x:Name="WallpaperTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- ============ 标题栏 ============ -->
            <Border Grid.Row="0"
                    x:Name="TitleBarBorder"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">

                        <Image Source="/UI/Assets/Images/派蒙.ico"
                               Width="20" Height="20"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>

                        <TextBlock Text="Lvchaxs伴生"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <!-- Toast 消息 -->
                        <controls:TitleBarToast x:Name="TitleBarToast"
                                                Margin="20,0,0,0"
                                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Column="1"/>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- 注意：这里不要内联 Background/Foreground，
                             局部值优先级高于样式触发器，会把悬停变色压掉 -->
                        <Button x:Name="MinimizeButton"
                                Content="─"
                                FontSize="14"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton"
                                Content="☐"
                                FontSize="12"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="MaximizeButton_Click"/>
                        <Button x:Name="CloseButton"
                                Content="✕"
                                FontSize="12"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 文字标题行 ============ -->
            <Border Grid.Row="1"
                    Margin="10,2,10,2"
                    Background="Transparent"
                    FocusVisualStyle="{x:Null}">
                <TextBlock x:Name="TitleTextBlock"
                           Text="才识是年岁的冠冕，正如思念是我们共度的时间。"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>

            <!-- ============ 顶部按钮栏 ============ -->
            <Grid Grid.Row="2" Margin="10,4,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:TopLeftBar x:Name="TopLeft"
                                     Grid.Column="0"
                                     VerticalAlignment="Center"/>

                <controls:TopCenterBar x:Name="TopCenter"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       Margin="10,0,10,0"/>

                <controls:TopRightBar x:Name="TopRight"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"/>
            </Grid>

            <!-- ============ 内容区 ============ -->
            <Frame x:Name="MainFrame"
                   Grid.Row="3"
                   NavigationUIVisibility="Hidden"
                   FocusVisualStyle="{x:Null}"
                   Margin="5,0,5,10"/>

            <!-- ============ 主题切换迷雾过渡层 ============ -->
            <controls:ThemeFogOverlay x:Name="ThemeFog"
                                      Grid.Row="0"
                                      Grid.RowSpan="4"
                                      Panel.ZIndex="99"/>
        </Grid>
    </Border>
</Window>