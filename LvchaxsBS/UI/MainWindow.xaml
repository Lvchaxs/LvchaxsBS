<Window x:Class="LvchaxsBS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LvchaxsBS.UI.Controls"
        xmlns:ui="clr-namespace:LvchaxsBS.UI.Controls"
        mc:Ignorable="d"
        Title="LvchaxsBS"
        Height="580" Width="1000"
        MinHeight="300" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        KeyboardNavigation.IsTabStop="False"
        KeyboardNavigation.TabNavigation="None"
        Icon="/UI/Assets/Images/派蒙.ico"
        PreviewMouseDown="Window_PreviewMouseDown"
        StateChanged="Window_StateChanged">

    <Border x:Name="RootBorder"
            Background="{DynamicResource AppBackgroundBrush}"
            CornerRadius="8"
            BorderThickness="0"
            SizeChanged="RootBorder_SizeChanged"
            RenderTransformOrigin="0,0">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="RootScaleTransform" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ 壁纸层（主题底色之上、所有内容之下） ============ -->
            <!-- 透明度走 Image.Opacity；模糊走 BlurEffect；缩放/旋转/位移走 TransformGroup -->
            <!-- ★ BitmapScalingMode 用 LowQuality（=Linear）而不是 HighQuality：
                 本窗口 AllowsTransparency，走的是软件渲染，HighQuality(Fant) 每帧对整窗大图做
                 高质量重采样非常贵（拖窗口 / 缩放 / 位移时最明显）；壁纸是照片，
                 放大时 Linear 与 Fant 肉眼几乎无差，但快一个档。模糊开启时更是看不出区别。 -->
            <Image x:Name="WallpaperImage"
                   Grid.Row="0"
                   Grid.RowSpan="4"
                   Stretch="Uniform"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="LowQuality"
                   RenderTransformOrigin="0.5,0.5">
                <Image.Effect>
                    <BlurEffect x:Name="WallpaperBlurEffect"
                                Radius="0"
                                KernelType="Gaussian"
                                RenderingBias="Performance"/>
                </Image.Effect>
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="WallpaperScale" ScaleX="1" ScaleY="1"/>
                        <RotateTransform x:Name="WallpaperRotate" Angle="0"/>
                        <TranslateTransform x:Name="WallpaperTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- ============ 标题栏 ============ -->
            <Border Grid.Row="0"
                    x:Name="TitleBarBorder"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">

                        <Image Source="/UI/Assets/Images/派蒙.ico"
                               Width="20" Height="20"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>

                        <TextBlock x:Name="AppTitleText"
                                   Text="Lvchaxs伴生"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <!-- ===== UID 模式专用（内容区显示账号管理时才出现，见 SetUidTitleMode）=====
                             标题后缀「_UID」+ 账号管理的「使用说明」入口。
                             原来那个「!」按钮画在模块自己的页面上，现在统一放到标题栏这里。 -->
                        <TextBlock x:Name="UidTitleSuffix"
                                   Text="_UID"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>

                        <Button x:Name="UidHelpButton"
                                Width="20" Height="20"
                                Margin="6,0,0,0"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Click="UidHelpButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <!-- 圆形底 + 感叹号，配色走主题主色，深浅色下都清晰 -->
                                        <Ellipse x:Name="circleBackground"
                                                 Width="18" Height="18"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="#3B82F6" Opacity="0.16"/>
                                            </Ellipse.Fill>
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <TextBlock Text="!"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="circleBackground" Property="Opacity" Value="1"/>
                                            <Setter TargetName="circleBackground" Property="Fill">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="#3B82F6" Opacity="0.3"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="circleBackground" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Toast 消息 -->
                        <controls:TitleBarToast x:Name="TitleBarToast"
                                                Margin="20,0,0,0"
                                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Column="1"/>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- 注意：这里不要内联 Background/Foreground，
                             局部值优先级高于样式触发器，会把悬停变色压掉 -->
                        <Button x:Name="MinimizeButton"
                                Content="─"
                                FontSize="14"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton"
                                Content="☐"
                                FontSize="12"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="MaximizeButton_Click"/>
                        <!-- 关闭按钮：上面是 ✕，底部一行小字提示 Ctrl+F12 也是关闭快捷键 -->
                        <Button x:Name="CloseButton"
                                Width="48"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                Click="CloseButton_Click">
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="✕"
                                           FontSize="12"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Ctrl+F12"
                                           FontSize="8"
                                           Margin="0,-1,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 文字标题行 ============
                 ★ x:Name 是给「内容页全屏」用的：编辑类页面进来时整行收掉（见 cs 的 SetContentFullScreen）。 -->
            <Border x:Name="TitleRow"
                    Grid.Row="1"
                    Margin="10,2,10,2"
                    Background="Transparent"
                    FocusVisualStyle="{x:Null}">
                <TextBlock x:Name="TitleTextBlock"
                           Text="才识是年岁的冠冕，正如思念是我们共度的时间。"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>

            <!-- ============ 顶部按钮栏（全屏时整行收掉） ============ -->
            <Grid x:Name="TopButtonBar" Grid.Row="2" Margin="10,4,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:TopLeftBar x:Name="TopLeft"
                                     Grid.Column="0"
                                     VerticalAlignment="Center"/>

                <controls:TopCenterBar x:Name="TopCenter"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       Margin="10,0,10,0"/>

                <controls:TopRightBar x:Name="TopRight"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"/>
            </Grid>

            <!-- ============ 内容区 ============ -->
            <Frame x:Name="MainFrame"
                   Grid.Row="3"
                   NavigationUIVisibility="Hidden"
                   FocusVisualStyle="{x:Null}"
                   Margin="5,0,5,10"/>

            <!-- ============ 主题切换迷雾过渡层 ============ -->
            <controls:ThemeFogOverlay x:Name="ThemeFog"
                                      Grid.Row="0"
                                      Grid.RowSpan="4"
                                      Panel.ZIndex="99"/>

            <!-- ============ 全局模态层（遮罩 + 模态内容） ============
                 遮罩必须盖住整个窗口（含顶部栏）：只压暗内容区会很难看。
                 结构上「先遮罩、再 ModalHost」，各来源的模态框放进 ModalHost，
                 就自然浮在遮罩之上——包括 UID 模块的页内模态框（由宿主代为承载）。
                 使用方式见 Services/ModalOverlayService.cs。 -->
            <Grid x:Name="ModalLayer"
                  Grid.Row="0"
                  Grid.RowSpan="4"
                  Panel.ZIndex="500"
                  Visibility="Collapsed"
                  Focusable="False">
                <Border x:Name="ModalMask"
                        Background="#000000"
                        Opacity="0"
                        Focusable="False"/>
                <Grid x:Name="ModalHost"
                      Focusable="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>