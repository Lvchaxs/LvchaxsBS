<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<Version>1.0.3.4</Version>
		<AssemblyVersion>1.0.3.4</AssemblyVersion>
		<FileVersion>1.0.3.4</FileVersion>

		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

		<ApplicationIcon>UI\Assets\Images\派蒙.ico</ApplicationIcon>

		<!-- 许可证元数据：写进生成的 exe / dll 属性，与仓库根目录的 LICENSE 保持一致 -->
		<Copyright>Copyright (C) 2026 Lvchaxs</Copyright>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.Drawing.Common" Version="8.0.0" />
	</ItemGroup>

	<!--
		共享基础库：图片资源 + 坐标管理 / 模板加载 / 截图 / 匹配 / 模拟输入
		（源码工程见同级目录 LvchaxsBS_Resources，UID 模块后续也引用它）。
		★ 它是可选组件：dll 不在 exe 同目录时主程序照常启动 —— 图片留空、
		  图像识别与模拟点击停用，但 UI 交互与配置修改正常（见 Services/SharedComponent.cs）。
	-->
	<ItemGroup>
		<ProjectReference Include="..\LvchaxsBS_Resources\LvchaxsBS_Resources.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="UI\Assets\Images\**\*.png" />
		<Resource Include="UI\Assets\Images\**\*.ico" />
		<Resource Include="UI\Assets\Images\**\*.jpg" />
		<Resource Include="UI\Assets\Images\**\*.jpeg" />

		<!--
			图片资源（UI 图标 + 图像识别模板）都在共享库工程
			..\LvchaxsBS_Resources\Resources\ 下，编译进 LvchaxsBS_Resources.dll。
			代码里统一用 Core\AssetLocator.cs 拼路径，不要再往宿主工程里加图片。
		-->
	</ItemGroup>

</Project>