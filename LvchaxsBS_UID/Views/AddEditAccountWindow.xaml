<Window x:Class="LvchaxsBS_UID.Views.AddEditAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LvchaxsBS_UID.Views"
        xmlns:ui="clr-namespace:LvchaxsBS_UID.Utils.UI"
        mc:Ignorable="d"
        Title="账号管理"
        Width="640"
        Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        BorderThickness="0">

    <Window.Effect>
        <DropShadowEffect Color="#1F000000" 
                          Direction="315" 
                          ShadowDepth="3" 
                          Opacity="0.1" 
                          BlurRadius="10"/>
    </Window.Effect>

    <Window.Resources>
        <!-- 缓动函数 -->
        <QuadraticEase x:Key="QuadEaseOut" EasingMode="EaseOut"/>

        <!-- 动画 -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.95" To="1" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.95" To="1" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
        </Storyboard>

        <Storyboard x:Key="FadeOutAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="0.95" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="0.95" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
        </Storyboard>

        <!-- 通用样式 -->
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="WatermarkStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <!-- 输入内容与光标的颜色必须显式跟随主题：TextBox 默认前景是系统黑，
                 深色主题下「黑字 + 深底」等于什么都看不见。 -->
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <!-- 按钮样式 -->
        <!-- 主按钮：原为硬编码蓝色底白字。这些弹窗的内容底是固定白底（不跟随主题），
             所以这里用固定的中性灰底 + 深字，深浅主题下都协调。 -->
        <Style x:Key="CompactPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Gray400Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 元素筛选按钮（全部 + 七个元素）。单选；「全部」与元素互斥。 -->
        <Style x:Key="ElementFilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <!-- 「全部」按钮里的四个方块用它上色（模板触发器改这个值就能高亮） -->
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ring"
                                CornerRadius="16"
                                BorderThickness="1.5"
                                Background="{DynamicResource HoverBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 细滚动条（8px，半透明圆角）=====
             头像列表的滚动条放在**容器外面、右侧**（不在容器内部），
             于是「有滚动条 / 没滚动条」两种情况下 5 列头像的宽度和位置完全不变。 -->
        <Style x:Key="AvatarScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource Gray400Brush}" CornerRadius="3" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AvatarScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AvatarScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransparentIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="mainBorder"
            Background="{DynamicResource PopupBackgroundBrush}"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            Opacity="0"
            d:Opacity="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.95" ScaleY="0.95"
                            d:ScaleX="1" d:ScaleY="1"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource DialogHeaderBackgroundBrush}"
                    CornerRadius="10,10,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="windowTitle"
                               Text="添加账号"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                                    </Grid>
            </Border>

            <!-- 内容区域：左侧账号信息 + 右侧头像选择（窗口宽度是原来的两倍） -->
            <Grid Grid.Row="1" Margin="20,16,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <!-- 右栏固定 322：头像容器 311 → 5 格各 59、头像环 54 两侧留 2.5px。
                         再窄会把格子压到 56，环只剩 1px 间隙，太挤。 -->
                    <ColumnDefinition Width="322"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 左栏：UID / 冒险等级 / 昵称 / 账号 / 密码 ===== -->
                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <!-- UID -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="UID" Style="{StaticResource LabelTextStyle}"/>
                        <Border Style="{StaticResource InputBorderStyle}">
                            <Grid>
                                <TextBlock x:Name="uidWatermarkText" 
                                           Text="9位 UID: 155333279" 
                                           Style="{StaticResource WatermarkStyle}"/>
                                <TextBox x:Name="uidTextBox"
                                         Style="{StaticResource InputBoxStyle}"
                                         MaxLength="9"
                                         PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"
                                         TextChanged="UIDTextBox_TextChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 冒险等级 -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="冒险等级" Style="{StaticResource LabelTextStyle}"/>
                        <Border Style="{StaticResource InputBorderStyle}">
                            <Grid>
                                <TextBlock x:Name="levelWatermarkText" 
                                           Text="冒险等级1~60" 
                                           Style="{StaticResource WatermarkStyle}"/>
                                <TextBox x:Name="levelTextBox"
                                         Style="{StaticResource InputBoxStyle}"
                                         MaxLength="2"
                                         PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"
                                         TextChanged="LevelTextBox_TextChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 昵称 -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="昵称" Style="{StaticResource LabelTextStyle}"/>
                        <Border Style="{StaticResource InputBorderStyle}">
                            <Grid>
                                <TextBlock x:Name="nicknameWatermarkText" 
                                           Text="账号昵称: 伴生" 
                                           Style="{StaticResource WatermarkStyle}"/>
                                <TextBox x:Name="nicknameTextBox"
                                         Style="{StaticResource InputBoxStyle}"
                                         TextChanged="NicknameTextBox_TextChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 账号 -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="账号" Style="{StaticResource LabelTextStyle}"/>
                        <Border Style="{StaticResource InputBorderStyle}">
                            <Grid>
                                <TextBlock x:Name="usernameWatermarkText" 
                                           Text="手机号 / 邮箱 / 通行证账号名" 
                                           Style="{StaticResource WatermarkStyle}"/>
                                <TextBox x:Name="usernameTextBox"
                                         Style="{StaticResource InputBoxStyle}"
                                         MaxLength="64"
                                         TextChanged="UsernameTextBox_TextChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 密码 -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="密码" Style="{StaticResource LabelTextStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource InputBorderStyle}">
                                <Grid>
                                    <TextBlock x:Name="passwordWatermarkText" 
                                               Text="账号密码" 
                                               Style="{StaticResource WatermarkStyle}"
                                               Margin="8,0,36,0"/>
                                    <PasswordBox x:Name="passwordBox"
                                                 PasswordChanged="PasswordBox_PasswordChanged"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Height="32"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 Padding="8,6,36,6"
                                                 Visibility="Visible"/>
                                    <TextBox x:Name="passwordTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Height="32"
                                             FontSize="12"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             VerticalAlignment="Center"
                                             Padding="8,6,36,6"
                                             Visibility="Collapsed"
                                             TextChanged="PasswordTextBox_TextChanged"/>
                                </Grid>
                            </Border>

                            <Button x:Name="togglePasswordButton"
                                    Grid.Column="1"
                                    Style="{StaticResource TransparentIconButtonStyle}"
                                    Margin="-36,0,0,0"
                                    Height="32"
                                    Width="36"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="TogglePasswordButton_Click">
                                <Viewbox Width="18" Height="18">
                                    <Grid Width="18" Height="18">
                                        <Path x:Name="eyeOpenIcon"
                                              Visibility="Visible"
                                              Data="M9,3 C13.5,3 18,9 18,9 C18,9 13.5,15 9,15 C4.5,15 0,9 0,9 C0,9 4.5,3 9,3 Z M9,6 C6.75,6 6,7.5 6,9 C6,10.5 6.75,12 9,12 C11.25,12 12,10.5 12,9 C12,7.5 11.25,6 9,6 Z"
                                              Stroke="{DynamicResource TextDisabledBrush}" 
                                              StrokeThickness="1.5"
                                              Fill="Transparent"/>
                                        <Grid x:Name="eyeClosedIcon"
                                              Visibility="Collapsed">
                                            <Path Data="M9,3 C13.5,3 18,9 18,9 C18,9 13.5,15 9,15 C4.5,15 0,9 0,9 C0,9 4.5,3 9,3 Z M9,6 C6.75,6 6,7.5 6,9 C6,10.5 6.75,12 9,12 C11.25,12 12,10.5 12,9 C12,7.5 11.25,6 9,6 Z"
                                                  Stroke="{DynamicResource TextDisabledBrush}" 
                                                  StrokeThickness="1.5"
                                                  Fill="Transparent"/>
                                            <Line X1="3" Y1="3" X2="15" Y2="15"
                                                  Stroke="{DynamicResource TextDisabledBrush}"
                                                  StrokeThickness="1.5"/>
                                        </Grid>
                                    </Grid>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 密码强度 -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="passwordStrengthText"
                                       Text="密码强度："
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,6,0"
                                       Grid.Column="0"/>
                            <Border Height="3"
                                    Background="{DynamicResource BorderBrush}"
                                    CornerRadius="2"
                                    Grid.Column="1">
                                <Border x:Name="passwordStrengthBar"
                                        Width="0"
                                        Background="{DynamicResource DangerBrush}"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <!-- ===== 右栏：头像（必选，默认「空」）=====
                     图片来自共用资源包 LvchaxsBS_Resources.dll 的
                     Resources/Images/Pictures/角色头像/，一行 5 个、超出滚动。
                     资源包缺失时列表为空，保存时回落到默认头像，不会报错。 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 元素筛选：左边「四个方块」= 全部，后面依次是火/水/风/雷/草/冰/岩，
                         最后一个 = 「其他头像」（NPC / 任务类）。
                         单选；再点同一个 = 取消并回到「全部」。默认只选中「全部」。
                         9 个按钮宽 9×32 + 8×3 = 312，所以要跨到滚动条那一列（ColumnSpan=2）。 -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <ToggleButton x:Name="filterAllToggle"
                                      Style="{StaticResource ElementFilterToggleStyle}"
                                      IsChecked="True"
                                      Click="ElementFilter_Click">
                            <Viewbox Width="17" Height="17">
                                <Grid Width="15" Height="15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Margin="1" CornerRadius="1.5"
                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                    <Border Grid.Row="0" Grid.Column="1" Margin="1" CornerRadius="1.5"
                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                    <Border Grid.Row="1" Grid.Column="0" Margin="1" CornerRadius="1.5"
                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                    <Border Grid.Row="1" Grid.Column="1" Margin="1" CornerRadius="1.5"
                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                </Grid>
                            </Viewbox>
                        </ToggleButton>

                        <ToggleButton x:Name="filterFireToggle" Tag="火"
                                      Style="{StaticResource ElementFilterToggleStyle}" Click="ElementFilter_Click">
                            <Image Source="{ui:Asset Images/元素/火.png}" Width="21" Height="21" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="filterWaterToggle" Tag="水"
                                      Style="{StaticResource ElementFilterToggleStyle}" Click="ElementFilter_Click">
                            <Image Source="{ui:Asset Images/元素/水.png}" Width="21" Height="21" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="filterWindToggle" Tag="风"
                                      Style="{StaticResource ElementFilterToggleStyle}" Click="ElementFilter_Click">
                            <Image Source="{ui:Asset Images/元素/风.png}" Width="21" Height="21" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="filterThunderToggle" Tag="雷"
                                      Style="{StaticResource ElementFilterToggleStyle}" Click="ElementFilter_Click">
                            <Image Source="{ui:Asset Images/元素/雷.png}" Width="21" Height="21" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="filterGrassToggle" Tag="草"
                                      Style="{StaticResource ElementFilterToggleStyle}" Click="ElementFilter_Click">
                            <Image Source="{ui:Asset Images/元素/草.png}" Width="21" Height="21" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="filterIceToggle" Tag="冰"
                                      Style="{StaticResource ElementFilterToggleStyle}" Click="ElementFilter_Click">
                            <Image Source="{ui:Asset Images/元素/冰.png}" Width="21" Height="21" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="filterRockToggle" Tag="岩"
                                      Style="{StaticResource ElementFilterToggleStyle}" Click="ElementFilter_Click">
                            <Image Source="{ui:Asset Images/元素/岩.png}" Width="21" Height="21" Stretch="Uniform"/>
                        </ToggleButton>
                        <!-- 「其他头像」：NPC / 任务类，没有元素归属，图标取自其他头像里的「活力相谈」 -->
                        <ToggleButton x:Name="filterOtherToggle" Tag="其他"
                                      Style="{StaticResource ElementFilterToggleStyle}" Click="ElementFilter_Click">
                            <Image Source="{ui:Asset Images/Pictures/其他头像/活力相谈.png}" Width="21" Height="21" Stretch="Uniform"/>
                        </ToggleButton>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!-- 固定 11px（滚动条 8 + 间距 3）：无论滚动条显示与否，
                                 头像容器的宽度都完全一样，5 列的尺寸与位置不会变 -->
                            <ColumnDefinition Width="11"/>
                        </Grid.ColumnDefinitions>

                        <!-- 头像容器：内部不显示滚动条（Hidden = 仍可滚动），
                             所以它的宽度永远是固定的，5 列头像不会因为滚动条出现而挪位 -->
                        <Border x:Name="avatarContainer"
                                Grid.Column="0"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.2"
                                CornerRadius="6"
                                Padding="4">
                            <ListBox x:Name="avatarListBox"
                                     SelectionMode="Single"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{DynamicResource AccountAvatarListItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- 方格 5 列：实际格子边长由 code-behind 按容器宽度算
                                             （= 容器可用宽 / 5），保证一行永远 5 个；
                                             ListBoxItem 不写死尺寸，头像在里面居中，横竖间距一致。
                                             （以前用 UniformGrid：列宽均分、行高被拉伸，元素少时行距变大。） -->
                                        <WrapPanel ItemWidth="60" ItemHeight="60" Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Image}"
                                               Width="48" Height="48"
                                               Stretch="UniformToFill"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- 滚动条：在头像容器**外面**的右侧，与列表滚动位置同步（见 code-behind） -->
                        <ScrollBar x:Name="avatarScrollBar"
                                   Grid.Column="1"
                                   Style="{StaticResource AvatarScrollBarStyle}"
                                   Orientation="Vertical"
                                   Margin="3,0,0,0"
                                   VerticalAlignment="Stretch"
                                   Visibility="Collapsed"
                                   Scroll="AvatarScrollBar_Scroll"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 按钮区域 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource DialogHeaderBackgroundBrush}"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <!-- 按钮样式直接引用主程序的 SettingsButtonStyleRound6：
                     这样深浅主题配色、悬停换色、悬停放大 1.06 / 按下缩小 0.97
                     全部与主程序弹窗完全一致，不再各写一套。 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0">
                    <Button x:Name="saveButton"
                            Style="{DynamicResource SettingsButtonStyleRound6}"
                            Click="SaveButton_Click"
                            MinWidth="80"
                            Height="30"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓"
                                       Foreground="{DynamicResource TagGreenFgBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <TextBlock Text="保存" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="cancelButton"
                            Style="{DynamicResource SettingsButtonStyleRound6}"
                            Click="CancelButton_Click"
                            MinWidth="80"
                            Height="30">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕"
                                       Foreground="{DynamicResource TagRedFgBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <TextBlock Text="取消" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>