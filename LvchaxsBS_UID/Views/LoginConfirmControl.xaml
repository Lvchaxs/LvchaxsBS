<Window x:Class="LvchaxsBS_UID.Views.LoginConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="确认登录"
        Width="537"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Effect>
        <DropShadowEffect Color="#1F000000" 
                          Direction="315" 
                          ShadowDepth="3" 
                          Opacity="0.1" 
                          BlurRadius="10"/>
    </Window.Effect>

    <Window.Resources>
        <!-- 缓动函数 -->
        <ExponentialEase x:Key="ExponentialEaseOut" EasingMode="EaseOut" Exponent="2"/>
        <QuadraticEase x:Key="QuadEaseOut" EasingMode="EaseOut"/>

        <!-- 动画 -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.95" To="1" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.95" To="1" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
        </Storyboard>

        <Storyboard x:Key="FadeOutAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="0.95" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="0.95" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
        </Storyboard>

        <!-- 颜色：一律走宿主的 DynamicResource 主题键（插件编译期引用不到宿主的画刷，
             只能靠 DynamicResource 在运行时从 Application.Resources 里取），
             深浅色主题切换时这个窗口才会跟着变。
             对照（浅 / 深）：
               PrimaryBrush          主色蓝，用于 UID 文字、箭头描边
               PrimaryDarkBrush      深一档的蓝，用作按钮底色 / 复选框选中底
               PrimaryLightBrush     淡蓝底，用作悬停底色
               TextPrimaryBrush      主文字（黑 / 白）
               TextSecondaryBrush    次要文字（灰）
               Gray400Brush          分隔点、复制图标
               DialogHeaderBackgroundBrush  标题栏与底栏底色
               CardBackgroundBrush   卡片底（当前账号那一行）
               HoverBackgroundBrush  账号卡底
               Gray100Brush          选项区底
               BorderBrush / BorderStrongBrush  1px 描边
               TagAmberBg/FgBrush    警告条
        -->

        <!-- 基础复选框样式 -->
        <Style x:Key="BaseCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="checkBoxBorder"
                                    Width="14"
                                    Height="14"
                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    CornerRadius="3"
                                    Margin="0,0,6,0">
                                <TextBlock x:Name="checkMark"
                                           Text="✓"
                                           FontSize="10"
                                           Foreground="{DynamicResource CardBackgroundBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter x:Name="contentPresenter"
                                              VerticalAlignment="Center"
                                              Margin="2,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{DynamicResource PrimaryDarkBrush}"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{DynamicResource Gray400Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 边框按钮样式 -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Gray700Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Gray100Brush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Gray400Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 「确认登录」与「上一个 / 下一个」这两个按钮不再自己写样式 =====
             用户要求：用跟「添加账号」的保存/取消、主程序弹窗**完全同一套默认按钮配色**，
             深浅主题下都不再出现这片实色蓝。
             于是这里直接引用宿主的按钮样式（插件用 DynamicResource 即可）：
               SettingsButtonStyleRound6 —— 文字按钮（确认登录）：
                   底 CardBackgroundBrush + 1px BorderStrongBrush 边，
                   悬停 HoverBackgroundBrush + Gray400Brush 边 + Gray700Brush 字，
                   自带 InteractionScale 悬停 1.06 / 按下 0.97。
               ImageButtonStyleRound6     —— 图标按钮（上一个 / 下一个）：
                   同为有边框中性底，悬停亮边框；里面的箭头改画 TextSecondaryBrush（中性灰）。
             原来本地那份 BlueButtonStyle（实色 PrimaryDarkBrush 底）已删除。 -->

        <!-- X关闭按钮样式 -->
        <Style x:Key="XCloseButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <TextBlock x:Name="closeText" 
                                       Text="×" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform x:Name="closeScale" ScaleX="1" ScaleY="1"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeText" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="closeScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.3" Duration="0:0:0.1"
                                                             EasingFunction="{StaticResource ExponentialEaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="closeScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.3" Duration="0:0:0.1"
                                                             EasingFunction="{StaticResource ExponentialEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="closeScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.1"
                                                             EasingFunction="{StaticResource ExponentialEaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="closeScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.1"
                                                             EasingFunction="{StaticResource ExponentialEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="closeText" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="mainBorder"
            Background="{DynamicResource PopupBackgroundBrush}"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            Opacity="0"
            d:Opacity="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.95" ScaleY="0.95"
                            d:ScaleX="1" d:ScaleY="1"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>     <!-- 标题 -->
                <RowDefinition Height="Auto"/>   <!-- 警告提示 -->
                <RowDefinition Height="Auto"/>   <!-- 上一个 / 当前 / 下一个 账号 -->
                <RowDefinition Height="Auto"/>   <!-- 登录后的附加选项 -->
                <RowDefinition Height="*"/>      <!-- 弹性：把按钮区顶到底部 -->
                <RowDefinition Height="Auto"/>   <!-- 按钮区 -->
            </Grid.RowDefinitions>

            <!-- 标题区：以前左边有个 🎮 方形小图标，用户要求去掉 —— 现在标题左对齐到 24px，
                 右侧只留关闭按钮。 -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource DialogHeaderBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" 
                    CornerRadius="10,10,0,0" 
                    Padding="24,0">
                <Grid>
                    <TextBlock x:Name="LoginModalTitle" 
                               Text="确认登录" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    <Button x:Name="CloseLoginModalButton" 
                            Style="{StaticResource XCloseButtonStyle}" 
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right" 
                            Click="CloseButton_Click">
                        <TextBlock Text="×" FontSize="20"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 警告提示 -->
            <Border Grid.Row="1" 
                    Margin="24,12,24,0" 
                    Background="{DynamicResource TagAmberBgBrush}" 
                    BorderBrush="{DynamicResource WarningBrush}" 
                    BorderThickness="1"
                    CornerRadius="6" 
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" 
                               VerticalAlignment="Top" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" 
                               Text="登录过程中尽量不要操作鼠标或键盘，等待进入游戏并结束" 
                               FontSize="13"
                               Foreground="{DynamicResource TagAmberFgBrush}" 
                               FontWeight="SemiBold" 
                               TextWrapping="Wrap" 
                               LineHeight="18"/>
                </Grid>
            </Border>

            <!-- 账号信息：上一个 / 当前 / 下一个 收进同一张卡片，三行 + 两条分隔线。
                 以前这三块全挂在 Grid.Row=6/7，靠 Margin 的 Top（116 / 160 / 206）硬定位，
                 只要有一行高度变了就会互相压住 —— 现在改成正常的 Grid 行，高度自适应。
                 「当前账号」这行刻意做得更高、底色更亮：它是这一次真正要登录的账号。 -->
            <Border Grid.Row="2"
                    Margin="24,12,24,0"
                    Background="{DynamicResource HoverBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" x:Name="PrevAccountBorder" Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="上一个账号："
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="PrevAccountNameText"
                                       Text=""
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Gray700Brush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" · "
                                       FontSize="12.5"
                                       Foreground="{DynamicResource Gray400Brush}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       x:Name="PrevAccountSeparator"/>
                            <TextBlock x:Name="PrevAccountUidText"
                                       Text=""
                                       FontSize="12.5"
                                       FontFamily="Consolas, 'Courier New', monospace"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       MouseLeftButtonDown="PrevAccountUidText_MouseLeftButtonDown"
                                       ToolTip="点击复制 UID"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                x:Name="CopyPrevUidButton"
                                Style="{DynamicResource IconCopyButtonStyle}"
                                Click="CopyPrevUidButton_Click"
                                ToolTip="复制 UID"
                                Margin="8,0,0,0"
                                Visibility="Collapsed">
                            <Path Data="{DynamicResource CopyIconGeometry}"
                                  Stroke="{DynamicResource Gray400Brush}"
                                  StrokeThickness="1.15"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"/>
                        </Button>
                    </Grid>

                    <Rectangle Grid.Row="1" Fill="{DynamicResource BorderBrush}" Height="1"/>

                    <!-- 当前账号 -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="当前账号："
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Gray700Brush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentAccountNameText"
                                           Text=""
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" · "
                                           FontSize="14"
                                           Foreground="{DynamicResource Gray400Brush}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           x:Name="CurrentAccountSeparator"/>
                                <TextBlock x:Name="AccountUidText"
                                           Text=""
                                           FontSize="13"
                                           FontFamily="Consolas, 'Courier New', monospace"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="AccountUidText_MouseLeftButtonDown"
                                           ToolTip="点击复制 UID"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    x:Name="CopyUidButton"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Click="CopyUidButton_Click"
                                    ToolTip="复制 UID"
                                    Margin="8,0,0,0"
                                    Visibility="Collapsed">
                                <Path Data="{DynamicResource CopyIconGeometry}"
                                      Stroke="{DynamicResource Gray400Brush}"
                                      StrokeThickness="1.15"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Rectangle Grid.Row="3" Fill="{DynamicResource BorderBrush}" Height="1"/>

                    <Grid Grid.Row="4" x:Name="NextAccountBorder" Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="下一个账号："
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="NextAccountNameText"
                                       Text=""
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Gray700Brush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" · "
                                       FontSize="12.5"
                                       Foreground="{DynamicResource Gray400Brush}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       x:Name="NextAccountSeparator"/>
                            <TextBlock x:Name="NextAccountUidText"
                                       Text=""
                                       FontSize="12.5"
                                       FontFamily="Consolas, 'Courier New', monospace"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       MouseLeftButtonDown="NextAccountUidText_MouseLeftButtonDown"
                                       ToolTip="点击复制 UID"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                x:Name="CopyNextUidButton"
                                Style="{DynamicResource IconCopyButtonStyle}"
                                Click="CopyNextUidButton_Click"
                                ToolTip="复制 UID"
                                Margin="8,0,0,0"
                                Visibility="Collapsed">
                            <Path Data="{DynamicResource CopyIconGeometry}"
                                  Stroke="{DynamicResource Gray400Brush}"
                                  StrokeThickness="1.15"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>


            <!-- 登录后的附加选项：4 列 x 3 行。
                 原来是 Canvas + Canvas.Left/Top 手填坐标（10/170/269/377），
                 列宽全靠数字凑，改一个文案就会撞车；换成 Grid 后自动排。 -->
            <Border Grid.Row="3"
                    Margin="24,12,24,0"
                    Background="{DynamicResource Gray100Brush}"
                    CornerRadius="6"
                    Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="152"/>
                        <ColumnDefinition Width="104"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                        <CheckBox x:Name="ExtraCheckBox1"
                                  Content="登录后打开派蒙界面"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  Grid.Row="0" Grid.Column="0"
                                  HorizontalAlignment="Left"
                                  Checked="ExtraCheckBox_Checked"
                                  Unchecked="ExtraCheckBox_Unchecked"/>
                        <CheckBox x:Name="ExtraCheckBox2"
                                  Content="登录后打开聊天界面"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  Grid.Row="1" Grid.Column="0"
                                  HorizontalAlignment="Left"
                                  Checked="ExtraCheckBox_Checked"
                                  Unchecked="ExtraCheckBox_Unchecked"/>
                        <CheckBox x:Name="ExtraCheckBox3"
                                  Content="登录后打开联机界面"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  Grid.Row="2" Grid.Column="0"
                                  HorizontalAlignment="Left"
                                  Checked="ExtraCheckBox_Checked"
                                  Unchecked="ExtraCheckBox_Unchecked"/>
                        <CheckBox x:Name="ExtraCheckBox6"
                                  Content="双人联机"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  Grid.Row="0" Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  Checked="ExtraCheckBox_Checked"
                                  Unchecked="ExtraCheckBox_Unchecked"/>
                        <CheckBox x:Name="ExtraCheckBox5"
                                  Content="三人联机"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  Grid.Row="1" Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  Checked="ExtraCheckBox_Checked"
                                  Unchecked="ExtraCheckBox_Unchecked"/>
                        <CheckBox x:Name="ExtraCheckBox4"
                                  Content="四人联机"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  Grid.Row="2" Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  Checked="ExtraCheckBox_Checked"
                                  Unchecked="ExtraCheckBox_Unchecked"/>
                        <CheckBox x:Name="ExtraCheckBox7"
                                  Content="2P指令权限"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  Grid.Row="0" Grid.Column="2"
                                  HorizontalAlignment="Left"
                                  Checked="ExtraCheckBox_Checked"
                                  Unchecked="ExtraCheckBox_Unchecked"/>
                        <CheckBox x:Name="ExtraCheckBox8"
                                  Content="3P指令权限"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  Grid.Row="1" Grid.Column="2"
                                  HorizontalAlignment="Left"
                                  Checked="ExtraCheckBox_Checked"
                                  Unchecked="ExtraCheckBox_Unchecked"/>
                        <CheckBox x:Name="ExtraCheckBox9"
                                  Content="4P指令权限"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  Grid.Row="2" Grid.Column="2"
                                  HorizontalAlignment="Left"
                                  Checked="ExtraCheckBox_Checked"
                                  Unchecked="ExtraCheckBox_Unchecked"/>
                        <CheckBox x:Name="ExtraCheckBox10"
                                  Content="不允许加入"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  Grid.Row="0" Grid.Column="3"
                                  HorizontalAlignment="Left"
                                  Checked="ExtraCheckBox_Checked"
                                  Unchecked="ExtraCheckBox_Unchecked"/>
                        <CheckBox x:Name="ExtraCheckBox11"
                                  Content="直接加入"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  Grid.Row="1" Grid.Column="3"
                                  HorizontalAlignment="Left"
                                  Checked="ExtraCheckBox_Checked"
                                  Unchecked="ExtraCheckBox_Unchecked"/>
                        <CheckBox x:Name="ExtraCheckBox12"
                                  Content="确认后可加入"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  Grid.Row="2" Grid.Column="3"
                                  HorizontalAlignment="Left"
                                  Checked="ExtraCheckBox_Checked"
                                  Unchecked="ExtraCheckBox_Unchecked"/>
                </Grid>
            </Border>

            <!-- 按钮区 -->
            <Border Grid.Row="5" 
                    Background="{DynamicResource DialogHeaderBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10" Height="92" VerticalAlignment="Bottom">
                <Grid Margin="24,12,24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：状态提示 / 登录完成并标记 / 置底控件（三者各占一行，
                         复选框那一行只有复选框本身，不掺状态文字） -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                        <!-- 状态提示：单独一行 -->
                        <TextBlock x:Name="LoginStatusHint"
                                   Text=""
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,4"/>

                        <!-- 第一行复选框：登录完成并标记 -->
                        <CheckBox x:Name="MarkAfterLoginCheckBox"
                                  Content="登录完成并标记账号"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"
                                  Checked="MarkAfterLoginCheckBox_Checked"
                                  Unchecked="MarkAfterLoginCheckBox_Unchecked"/>

                        <!-- 置底控件：和上面的复选框同款（方形选框 + 右侧两行文本），
                             登录界面里手动置底 / 取消置底（仅分组内显示）。
                             未置底：置底后/代表已登录；已置底：已置底/取消置底后恢复登录。 -->
                        <CheckBox x:Name="MarkToggleCheckBox"
                                  Style="{StaticResource BaseCheckBoxStyle}"
                                  VerticalAlignment="Center"
                                  Margin="0,6,0,0"
                                  Visibility="Collapsed"
                                  Click="MarkToggleCheckBox_Click">
                            <TextBlock x:Name="MarkToggleText"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center">
                                <Run Text="置底后"/><LineBreak/><Run Text="代表已登录"/>
                            </TextBlock>
                        </CheckBox>
                    </StackPanel>

                    <!-- 右侧：操作按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="LoginPrevButton" 
                                Style="{DynamicResource ImageButtonStyleRound6}" 
                                Click="LoginPrevButton_Click"
                                ToolTip="上一个账号"
                                Margin="0,0,6,0">
                            <Path Data="M 8,3 L 2,8 L 8,13" 
                                  Stroke="{DynamicResource TextSecondaryBrush}" 
                                  StrokeThickness="2.5" 
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Width="14" 
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"/>
                        </Button>

                        <Button x:Name="ConfirmLoginButton" 
                                Content="确认登录" 
                                Style="{DynamicResource SettingsButtonStyleRound6}" 
                                Height="32"
                                Padding="16,0" 
                                MinWidth="88" 
                                Click="ConfirmButton_Click"/>

                        <Button x:Name="LoginNextButton" 
                                Style="{DynamicResource ImageButtonStyleRound6}" 
                                Click="LoginNextButton_Click"
                                ToolTip="下一个账号"
                                Margin="6,0,0,0">
                            <Path Data="M 2,3 L 8,8 L 2,13" 
                                  Stroke="{DynamicResource TextSecondaryBrush}" 
                                  StrokeThickness="2.5" 
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Width="14" 
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>