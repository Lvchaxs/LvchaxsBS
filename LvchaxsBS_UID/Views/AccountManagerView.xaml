<UserControl x:Class="LvchaxsBS_UID.Views.AccountManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:LvchaxsBS_UID.Views"
             xmlns:ui="clr-namespace:LvchaxsBS_UID.Utils.UI"
             xmlns:converters="clr-namespace:LvchaxsBS_UID.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 头像：把账号的 Avatar（角色名）转成资源包里的图片，取不到时回落到「空」 -->
        <converters:AvatarConverter x:Key="AvatarConverter"/>

        <!-- 细滚动条（6px）：与主程序 CustomScrollBar 同规格。
             模块没有编译期引用，不能直接用宿主的样式，这里自带一份；
             颜色走 DynamicResource 宿主题键，深浅主题自动跟随。
             列宽必须是 6，账号卡片的右边界才会和主程序卡片一样停在"距右边 6px"处。 -->
        <Style x:Key="ThinScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource Gray300Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Margin="0,2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Gray400Brush}"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Gray500Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="-3,10,-5,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Width="6">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条容器：照主程序 CustomScrollViewer 的结构（内容列 + 6px 滚动条列），
             分组列表用它，滚动条宽度才会和账号列表、主程序页面一致。 -->
        <Style x:Key="ThinScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter Grid.Column="0" Margin="0"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource ThinScrollBar}"
                                       Orientation="Vertical"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Margin="-3,10,-5,10"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 缓动函数 -->
        <ExponentialEase x:Key="ExponentialEaseOut" EasingMode="EaseOut" Exponent="2"/>
        <QuadraticEase x:Key="QuadEaseOut" EasingMode="EaseOut"/>
        <CubicEase x:Key="CubicEaseOut" EasingMode="EaseOut"/>

        <!-- 颜色定义 -->
        <Color x:Key="PrimaryBlueColor">#FF1A56DB</Color>
        <Color x:Key="PrimaryBlueHoverColor">#FF4D8DF0</Color>
        <Color x:Key="PrimaryGreenColor">#10B981</Color>
        <Color x:Key="PrimaryGreenHoverColor">#059669</Color>
        <Color x:Key="DangerRedColor">#EF4444</Color>
        <Color x:Key="DangerRedHoverColor">#DC2626</Color>
        <Color x:Key="DangerRedPressedColor">#B91C1C</Color>
        <Color x:Key="GrayTextColor">#374151</Color>
        <Color x:Key="LightGrayTextColor">#6B7280</Color>
        <Color x:Key="BorderGrayColor">#E5E7EB</Color>
        <Color x:Key="BackgroundGrayColor">#F9FAFB</Color>
        <Color x:Key="WarningOrangeColor">#F97316</Color>
        <Color x:Key="PurpleColor">#7C3AED</Color>
        <Color x:Key="SearchBorderColor">#FFDDDDDD</Color>
        <Color x:Key="WarningYellowColor">#D97706</Color>
        <Color x:Key="LightPurpleColor">#F3E8FF</Color>
        <Color x:Key="LightGrayColor">#64748B</Color>

        <!-- 画笔定义 -->
        <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlueColor}"/>
        <SolidColorBrush x:Key="PrimaryBlueHoverBrush" Color="{StaticResource PrimaryBlueHoverColor}"/>
        <SolidColorBrush x:Key="PrimaryGreenBrush" Color="{StaticResource PrimaryGreenColor}"/>
        <SolidColorBrush x:Key="PrimaryGreenHoverBrush" Color="{StaticResource PrimaryGreenHoverColor}"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRedColor}"/>
        <SolidColorBrush x:Key="DangerRedHoverBrush" Color="{StaticResource DangerRedHoverColor}"/>
        <SolidColorBrush x:Key="DangerRedPressedBrush" Color="{StaticResource DangerRedPressedColor}"/>
        <SolidColorBrush x:Key="GrayTextBrush" Color="{StaticResource GrayTextColor}"/>
        <SolidColorBrush x:Key="LightGrayTextBrush" Color="{StaticResource LightGrayTextColor}"/>
        <SolidColorBrush x:Key="BorderGrayBrush" Color="{StaticResource BorderGrayColor}"/>
        <SolidColorBrush x:Key="BackgroundGrayBrush" Color="{StaticResource BackgroundGrayColor}"/>
        <SolidColorBrush x:Key="WarningOrangeBrush" Color="{StaticResource WarningOrangeColor}"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>
        <SolidColorBrush x:Key="SearchBorderBrush" Color="{StaticResource SearchBorderColor}"/>
        <SolidColorBrush x:Key="WarningYellowBrush" Color="{StaticResource WarningYellowColor}"/>
        <SolidColorBrush x:Key="LightPurpleBrush" Color="{StaticResource LightPurpleColor}"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGrayColor}"/>

        <!-- 转换器 -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />

        <!-- 基础复选框样式 -->
        <Style x:Key="BaseCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- 按钮基础样式 -->
        <Style x:Key="ButtonBaseStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 中性按钮样式（原「蓝色按钮」）。
             原来硬编码蓝色底 + 白字，浅色下太跳、深色下更刺眼，
             改成和主程序普通按钮一致的观感：卡片底 + 细边框 + 主题文字色，
             全部走 DynamicResource，深浅主题自动跟随。 -->
        <Style x:Key="NeutralButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="33"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Gray400Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PressedBackgroundBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Gray400Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 绿色按钮样式 -->
        <Style x:Key="GreenButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}"/>
            <!-- 彩色底上必须是白字：基础样式已改成主题文字色，这里显式覆盖 -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryGreenHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 删除移出按钮样式 -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerRedBrush}"/>
            <!-- 同上：红色底上必须白字 -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}"
                        BorderThickness="1" 
                        BorderBrush="Transparent"
                        CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource DangerRedHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DangerRedHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource DangerRedPressedBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DangerRedPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 边框按钮样式 -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Gray100Brush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TextDisabledBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 编辑按钮样式 -->
        <Style x:Key="EditButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <!-- 紧凑操作按钮样式 -->
        <Style x:Key="CompactActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Gray100Brush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TextDisabledBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 紧凑危险按钮样式 -->
        <Style x:Key="CompactDangerButtonStyle" TargetType="Button" 
               BasedOn="{StaticResource CompactActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerRedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerRedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource DangerRedHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DangerRedHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource DangerRedPressedBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DangerRedPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 清除按钮样式 -->
        <Style x:Key="ClearButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <TextBlock x:Name="clearText" 
                                       Text="×" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform x:Name="clearScale" ScaleX="1" ScaleY="1"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="clearText" Property="Foreground" Value="{StaticResource DangerRedBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="clearScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.3" Duration="0:0:0.1"
                                                             EasingFunction="{StaticResource ExponentialEaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="clearScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.3" Duration="0:0:0.1"
                                                             EasingFunction="{StaticResource ExponentialEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="clearScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.1"
                                                             EasingFunction="{StaticResource ExponentialEaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="clearScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.1"
                                                             EasingFunction="{StaticResource ExponentialEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="clearText" Property="Foreground" Value="{StaticResource DangerRedHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- X按钮样式 -->
        <Style x:Key="XCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ClearButtonStyle}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerRedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 世界等级徽章样式 -->
        <Style x:Key="WorldLevelBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LightPurpleBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid 样式 -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- 68 + 卡片自身 1px 上下边框 = 70，与主程序功能卡片（ModuleFunctionCardStyle）一致 -->
            <Setter Property="RowHeight" Value="68"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="None"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <!-- 卡片行带 1px 边框会多出 2px 期望宽度，Auto 会常驻一条隐形横向滚动条，
                 列宽本身是自适应缩放，这里直接禁用横向滚动 -->
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGrid">
                        <!-- 外层不再画大圆角边框：每行账号自己就是一张卡片。
                             结构照 WPF 原生 DataGrid：表头与内容放同一列、纵向滚动条单独占一列，
                             这样表头会随滚动条自动让出宽度，和卡片内容永远对齐。 -->
                        <Border Background="Transparent" BorderThickness="0">
                            <ScrollViewer x:Name="DG_ScrollViewer"
                                          Focusable="false"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <!-- 6px：与主程序 CustomScrollViewer 的滚动条列同宽，
                                                     卡片右边界才会和主程序卡片一样停在"距右边 6px"处 -->
                                                <ColumnDefinition Width="6"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- 表头已取消：保留 presenter 但折叠（DataGrid 内部会按名字找它） -->
                                            <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                                                                            Grid.Row="0" Grid.Column="0"
                                                                            Visibility="Collapsed"/>

                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                    Grid.Row="1" Grid.Column="0"
                                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>

                                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                                       Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                       Style="{StaticResource ThinScrollBar}"
                                                       Orientation="Vertical"
                                                       Value="{TemplateBinding VerticalOffset}"
                                                       Maximum="{TemplateBinding ScrollableHeight}"
                                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                                       Grid.Row="2" Grid.Column="0"
                                                       Orientation="Horizontal"
                                                       Value="{TemplateBinding HorizontalOffset}"
                                                       Maximum="{TemplateBinding ScrollableWidth}"
                                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid 行样式：每行账号就是一张卡片（圆角 8 + 1px 边框 + 行间距 8，对齐主程序卡片） -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowCard"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 悬停与选中用同一个中性底色（RowHighlightBrush，宿主主题里定义）：
                     浅色 #F2F2F2 / 深色 #313336，不要主题蓝 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHighlightBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHighlightBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsMarked}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Gray100Brush}"/>
                    <Setter Property="Opacity" Value="0.8"/>
                </DataTrigger>
                <!-- 移入模式：鼠标变成手型（提示「点卡片任意处即选中」） -->
                <DataTrigger Binding="{Binding Path=IsMoveMode, RelativeSource={RelativeSource AncestorType={x:Type local:AccountManagerView}}}" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                </DataTrigger>
                <!-- 移入模式：已勾选的卡片整行高亮（和悬停同一个中性底色） -->
                <DataTrigger Binding="{Binding IsSelectedForMove}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHighlightBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 单元格内容样式 -->
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 模态框动画 -->
        <Storyboard x:Shared="false" x:Key="ModalFadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.95" To="1" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.95" To="1" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
        </Storyboard>

        <Storyboard x:Shared="false" x:Key="ModalFadeOutAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="0.95" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="0.95" Duration="0:0:0.15"
                             EasingFunction="{StaticResource QuadEaseOut}"/>
        </Storyboard>
        <!-- 图标按钮（编辑 / 删除 / 登录 / 置顶 / 置底）已移到宿主
             UI/Styles/IconButtonStyles.xaml —— 主程序与插件共用同一份，改宿主一处两边生效。
             下面统一用 {DynamicResource IconXxxButtonStyle} 引用。 -->



        <!-- ============ 账号卡片：照主程序功能卡片的规格 ============
             图标位（头像 60x60 圆角 6，左边距 5、右边距 12）与两个等级标签。
             模块没有编译期引用，样式在本文件自带；颜色走宿主题键，深浅主题自动跟随。 -->
        <!-- 与「字幕设置」里的角色头像同规格：48x48、圆角 24（圆形）、剪裁、灰底 -->
        <Style x:Key="AccountIconBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Margin" Value="5,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource Gray100Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 头像按钮（AccountAvatarButtonStyle）已移到宿主 UI/Styles/IconButtonStyles.xaml：
             悬停放大 1.06 / 按下 0.97 与首页顶栏「设置」按钮同规格，用的是宿主的
             helpers:InteractionScale —— 插件编译期引用不到宿主类型，只能走 DynamicResource。 -->

        <Style x:Key="AccountTagStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AccountTagBlueStyle" TargetType="Border" BasedOn="{StaticResource AccountTagStyle}">
            <Setter Property="Background" Value="{DynamicResource TagBlueBgBrush}"/>
        </Style>

        <Style x:Key="AccountTagPurpleStyle" TargetType="Border" BasedOn="{StaticResource AccountTagStyle}">
            <Setter Property="Background" Value="{DynamicResource TagPurpleBgBrush}"/>
        </Style>

        <!-- 服务器标签（亚服/美服/欧服/港澳台服/渠道服）：中性灰，**不用蓝色** -->
        <Style x:Key="AccountTagServerStyle" TargetType="Border" BasedOn="{StaticResource AccountTagStyle}">
            <Setter Property="Background" Value="{DynamicResource Gray100Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 置顶按钮：圆角方块边框（18x18、圆角 2、1px）+ **向上箭头**（代表置顶）：
             未置顶 = 灰色箭头，已置顶 = 橙色箭头（形状完全不动，只换颜色）。
             账号卡片和分组卡片都用这一套。 -->
        <!-- 移入模式：卡片右侧的「选择框」按钮。
             未选中 = 空心方框（中性描边）；选中 = 方框 + 勾（跟随主题的前景色，不用蓝色）。
             点卡片任意处与点这个方框等效（见 AccountsDataGrid_PreviewMouseLeftButtonDown）。 -->
        <Style x:Key="MoveSelectBoxStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="4"
                                BorderThickness="1.5" BorderBrush="{DynamicResource BorderStrongBrush}"
                                Background="Transparent">
                            <Path x:Name="tick" Visibility="Collapsed"
                                  Data="M3,9 L7,13 L15,4" Stretch="Uniform"
                                  Width="12" Height="12"
                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelectedForMove}" Value="True">
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <!-- 主内容区 -->
        <!-- 左右边距对齐主程序卡片：左 5 与主页卡片左边界一致；右边 0，
             右侧的留白由滚动条列（6px）自然给出，与主程序 CustomScrollViewer 同机制 -->
        <Grid Margin="5,-4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 第 0 行已清空（原来这里是标题区和模块自带的提示条）。
                 提示条已改用主程序标题栏的，见 Utils/UI/ToastManager.cs -->
            <!-- 搜索和按钮区 -->
            <Grid Grid.Row="1" Margin="0,13,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 搜索框 -->
                <Border x:Name="searchBox" Grid.Column="0" Height="34" VerticalAlignment="Center" CornerRadius="5" 
                        Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
                    <Grid HorizontalAlignment="Right" Width="187">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 放大镜图标 -->
                        <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,8,0">
                            <Path Data="M6.5,11 C8.7,11 10.5,9.2 10.5,7 C10.5,4.8 8.7,3 6.5,3 C4.3,3 2.5,4.8 2.5,7 C2.5,9.2 4.3,11 6.5,11 Z M9.5,9.5 L12.5,12.5"
                                  Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1" Fill="Transparent"/>
                        </Viewbox>

                        <!-- 搜索输入框 -->
                        <Grid Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock x:Name="watermarkText" Text="输入 UID,昵称,账号 搜索..." VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextDisabledBrush}" Visibility="Visible"/>
                            <TextBox x:Name="searchTextBox" VerticalAlignment="Center" BorderThickness="0" Background="Transparent"
                                     FontSize="14" Padding="0" Foreground="{DynamicResource TextPrimaryBrush}" TextChanged="SearchTextBox_TextChanged" 
                                     GotFocus="SearchTextBox_GotFocus" LostFocus="SearchTextBox_LostFocus" Margin="-5,0,0,0" 
                                     HorizontalAlignment="Left" Width="147"/>
                        </Grid>

                        <!-- 清除按钮 -->
                        <Button x:Name="clearSearchButton" Grid.Column="2" Style="{StaticResource ClearButtonStyle}"
                                Margin="0,0,10,0" Click="ClearSearchButton_Click" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- 当前分组名称标签 -->
                <Border x:Name="currentGroupLabel" Grid.Column="1" Background="{DynamicResource HoverBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="5" Padding="12,6" Margin="8,0,0,0" Visibility="Visible" VerticalAlignment="Center"
                        HorizontalAlignment="Left" ToolTipService.ShowDuration="10000">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 文件夹图标 -->
                        <TextBlock Grid.Column="0" Text="📂" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <!-- 左侧：分组名 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="leftText" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center"/>
                            <TextBlock x:Name="groupSeparator" Text="" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,4,0"
                                       Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="rightText" Text="" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 按钮区域 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- 添加分组按钮 -->
                    <Button x:Name="addGroupButton" Style="{StaticResource NeutralButtonStyle}" HorizontalAlignment="Left" 
        Width="110" Margin="0,0,10,0" Click="CreateGroupButton_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="+" FontSize="20" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                            <TextBlock Text="添加分组" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 移入账号按钮（新增） -->
                    <Button x:Name="addAccountsToGroupButton" Style="{StaticResource NeutralButtonStyle}" HorizontalAlignment="Left" 
        Width="110" Margin="0,0,10,0" Click="OnAddGroupButtonClick" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="+" FontSize="20" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                            <TextBlock Text="移入账号" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 分组管理按钮 -->
                    <Button x:Name="groupManagementButton" Style="{StaticResource NeutralButtonStyle}" HorizontalAlignment="Left" 
        Width="110" Margin="0,0,10,0" Click="GroupManagementButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="分组管理" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 添加账号按钮 -->
                    <Button x:Name="addAccountButton" Style="{StaticResource NeutralButtonStyle}" HorizontalAlignment="Left" 
            Width="110" Margin="0,0,0,0" Click="AddAccountButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="+" FontSize="20" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                            <TextBlock Text="添加账号" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 返回账号列表按钮 -->
                    <Button x:Name="backToAccountListButton" Style="{StaticResource NeutralButtonStyle}" HorizontalAlignment="Left" 
            Width="110" Margin="0,0,0,0" Click="BackToAccountListButton_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="返回账号列表" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 「移入账号」模式专用：只留这两个按钮，其它全部隐藏 -->
                    <Button x:Name="moveConfirmButton" Style="{StaticResource NeutralButtonStyle}" HorizontalAlignment="Left"
            Width="110" Margin="0,0,10,0" Click="MoveConfirmButton_Click" Visibility="Collapsed">
                        <TextBlock Text="移入" FontSize="14" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="moveCancelButton" Style="{StaticResource NeutralButtonStyle}" HorizontalAlignment="Left"
            Width="110" Margin="0,0,0,0" Click="MoveCancelButton_Click" Visibility="Collapsed">
                        <TextBlock Text="取消" FontSize="14" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 账号列表容器：由「一整张大卡片包住表格」改为「顶部表头 + 每行一张卡片」，
                 外层退成透明留白（Padding 让卡片与表头左右对齐、四周有呼吸感） -->
            <Border Grid.Row="2" Background="Transparent" BorderThickness="0"
                    Padding="0,6,0,10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                <Grid>

                    <!-- 无数据提示 -->
                    <Border x:Name="noDataMessage" Visibility="Visible" Background="{DynamicResource CardBackgroundBrush}" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Padding="40" Panel.ZIndex="1">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock x:Name="noDataIcon" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,15"/>
                            <TextBlock x:Name="noDataText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock x:Name="noDataSubText" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,5,0,15" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="noDataBackButton" Style="{StaticResource NeutralButtonStyle}" Width="110" Margin="0,5,0,0"
                                    Click="NoDataBackButton_Click" Visibility="Collapsed">
                                <TextBlock Text="返回账号列表" FontSize="14" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 分组管理界面 -->
                    <!-- 分组管理：不再用一张大卡片包住分组卡片（那层边框会露出一条多余的方框），
                     改成与账号列表一致的透明留白，分组项自己就是卡片 -->
                    <Border x:Name="groupManagementMessage" Visibility="Collapsed" Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="2">
                        <Grid>
                            <Border x:Name="noGroupMessage" Visibility="Visible" Background="{DynamicResource CardBackgroundBrush}" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Padding="40">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="📂" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,15"/>
                                    <TextBlock Text="当前没有分组" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="伴生Lvchaxs&#10;点击右上角'添加分组'按钮创建第一个分组" FontSize="14" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,15"
                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Style="{StaticResource ThinScrollViewer}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="groupsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="70" Margin="0,0,0,8" Padding="16,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 置顶：和账号卡片同一套（方块边框 + 五角星，未置顶灰描边 / 已置顶橙实心） -->
                                                    <Button Grid.Column="0" Style="{DynamicResource IconPinButtonStyle}"
                                                            Tag="{Binding Id}" Click="GroupPinButton_Click"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,0"/>
                                                            <TextBlock Text="{Binding TagNote}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,0"
                                                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasAccounts}" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasMarks}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource PurpleBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button x:Name="clearMarksButton" Content="清除置底" Style="{StaticResource OutlineButtonStyle}"
                                                                Height="28" Padding="10,0" MinWidth="60" Margin="0,0,5,0" Tag="{Binding Id}"
                                                                Click="ClearMarksButton_Click" Visibility="Collapsed"/>
                                                        <Button Content="打开" Style="{StaticResource OutlineButtonStyle}" Height="28" Padding="10,0"
                                                                MinWidth="60" Margin="0,0,5,0" Tag="{Binding Id}" Click="OpenGroupButton_Click"/>
                                                        <!-- 编辑：改用主程序那套图标按钮（悬停显示「编辑」） -->
                                                        <Button Style="{DynamicResource IconEditButtonStyle}"
                                                                Margin="0,0,5,0" Tag="{Binding Id}" Click="EditGroupButton_Click"/>
                                                        <!-- 删除：红色垃圾桶图标（悬停显示「删除」） -->
                                                        <Button Style="{DynamicResource IconDeleteButtonStyle}"
                                                                Tag="{Binding Id}" Click="DeleteGroupButton_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- DataGrid 表格 -->
                    <DataGrid x:Name="accountsDataGrid" PreviewMouseWheel="DataGrid_PreviewMouseWheel" Visibility="Collapsed"
                              PreviewMouseLeftButtonDown="AccountsDataGrid_PreviewMouseLeftButtonDown"
                              Style="{StaticResource ModernDataGridStyle}"
                              RowStyle="{StaticResource DataGridRowStyle}" CellStyle="{StaticResource DataGridCellStyle}"
                              ItemsSource="{Binding}" AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                              SelectionChanged="DataGrid_SelectionChanged" AutoGenerateColumns="False"
                              HeadersVisibility="None"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="0">
                        <!-- 账号列表已改成「每行一张卡片」，布局照主程序的功能卡片：
                             头像（图标位） + 昵称（标题） + 冒险等级/世界等级两个标签
                             + UID/账号/密码（描述行，三项都可复制） + 右侧操作按钮 -->
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="账号" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                        <!-- 卡片自己控制间距，单元格不再额外留白（也避免撑出横向滚动条） -->
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>   <!-- 头像 -->
                                                <ColumnDefinition Width="*"/>      <!-- 标题 + 描述 -->
                                                <ColumnDefinition Width="Auto"/>   <!-- 右侧操作 -->
                                            </Grid.ColumnDefinitions>

                                            <!-- ③ 头像（图标位，可点击）：显示账号自己选的 Avatar（角色名），
                                                 在「添加/编辑账号」窗口里选，图片来自共用资源包。
                                                 账号没设头像、或资源包里没有这张图时回落到「空」。
                                                 点它：主列表 = 置顶/取消置顶；分组内 = 标记/取消标记；
                                                 移入模式 = 选中/取消选中。头像上不弹悬停提示。 -->
                                            <Button Grid.Column="0" Style="{DynamicResource AccountAvatarButtonStyle}"
                                                    Tag="{Binding Id}" Click="AccountAvatarButton_Click">
                                                <Border Style="{StaticResource AccountIconBorderStyle}">
                                                    <Image Source="{Binding Avatar, Converter={StaticResource AvatarConverter}}"
                                                           Width="48" Height="48" Stretch="UniformToFill"/>
                                                </Border>
                                            </Button>

                                            <!-- ④ 标题（昵称 + 两个等级标签）与描述（UID / 账号 / 密码） -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Nickname}" FontSize="16" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <!-- 冒险等级 -->
                                                    <Border Style="{StaticResource AccountTagBlueStyle}">
                                                        <TextBlock FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TagBlueFgBrush}" VerticalAlignment="Center">
                                                            <Run Text="冒险等级 "/><Run Text="{Binding Level, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <!-- 世界等级 -->
                                                    <Border Style="{StaticResource AccountTagPurpleStyle}">
                                                        <TextBlock FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TagPurpleFgBrush}" VerticalAlignment="Center">
                                                            <Run Text="世界等级 "/><Run Text="{Binding WorldLevel, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- 服务器标签：非官服才显示（官服返回空串，见 Account.ServerTag）。
                                                         位置在世界等级右侧、置顶按钮左侧。 -->
                                                    <Border x:Name="serverTagBorder" Style="{StaticResource AccountTagServerStyle}">
                                                        <TextBlock Text="{Binding ServerTag, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- 置顶：世界等级右侧、编辑左侧；只在主列表显示。
                                                         用 AccountPinButtonStyle（宿主提供的变体）：
                                                         外观同 IconPinButtonStyle，提示是「置顶/可点头像」。
                                                         这里**不能**再写 ui:ButtonTip.Text —— 那是插件自己的 ButtonTip，
                                                         和样式里用的宿主 ButtonTip 是两个不同的附加属性，
                                                         两处都设会同时弹出两个气泡。分组卡片那边仍用 IconPinButtonStyle。 -->
                                                    <Button Style="{DynamicResource AccountPinButtonStyle}" Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Tag="{Binding Id}" Click="PinButton_Click"
                                                            Visibility="{Binding ShowPinButton,
                                                                RelativeSource={RelativeSource AncestorType={x:Type local:AccountManagerView}},
                                                                Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                    <!-- 置底（分组内的「标记」）：向下箭头，紧跟在置顶右侧、编辑左侧；
                                                         只在分组内显示（主列表里这一位留给置顶）。 -->
                                                    <Button x:Name="markButton" Style="{DynamicResource IconMarkButtonStyle}" Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Tag="{Binding Id}" Click="MarkButton_Click"
                                                            Visibility="{Binding ShowMarkButton,
                                                                RelativeSource={RelativeSource AncestorType={x:Type local:AccountManagerView}},
                                                                Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                    <!-- 编辑 / 删除：紧跟在置顶/置底右侧，
                                                         大小与字幕设置的编辑按钮一致（16x16） -->
                                                    <Button x:Name="editAccountButton" Style="{DynamicResource IconEditButtonStyle}" Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Tag="{Binding Id}" Click="EditAccountButton_Click"/>
                                                    <Button x:Name="deleteAccountButton" Style="{DynamicResource IconDeleteButtonStyle}"
                                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Tag="{Binding Id}" Click="DeleteAccountButton_Click"/>
                                                </StackPanel>

                                                <!-- 描述行：UID / 账号 / 密码，三项都可一键复制 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                        <TextBlock Text="UID " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Uid}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <Button x:Name="copyUidButton" Style="{DynamicResource IconCopyButtonStyle}" Margin="4,0,0,0"
                                                                Tag="{Binding Uid}" Click="CopyButton_Click"
                                                                ui:ButtonTip.Text="复制">
                                                            <Path Data="{DynamicResource CopyIconGeometry}"
                                                                  Stroke="{DynamicResource TextDisabledBrush}"
                                                                  StrokeThickness="1.15"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  Fill="Transparent"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                        <TextBlock Text="账号 " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <!-- 完整账号（点了显示才出现） -->
                                                        <TextBlock x:Name="usernameText" Text="{Binding Username}" FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsUsernameVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <!-- 隐藏态：9 个黑点 -->
                                                        <TextBlock x:Name="maskedUsernameText" Text="{Binding MaskedUsername}" FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsUsernameVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                        <!-- 显示/隐藏（只管账号那一列，和密码是两个独立开关） -->
                                                        <Button Style="{DynamicResource IconCopyButtonStyle}" Margin="4,0,0,0" Tag="{Binding Id}"
                                                                Click="ToggleUsernameButton_Click" ui:ButtonTip.Text="显示/隐藏">
                                                            <Viewbox Width="12" Height="12">
                                                                <Grid Width="12" Height="12">
                                                                    <!-- 睁眼：账号/密码可见。图标反映的是「当前状态」，不是点击动作 -->
                                                                    <Path Visibility="{Binding IsUsernameVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                          Data="{DynamicResource EyeVisibleGeometry}"
                                                                          Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="1" Fill="Transparent"/>
                                                                    <!-- 睁眼 + 斜线：账号/密码隐藏 -->
                                                                    <Path Visibility="{Binding IsUsernameVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                                          Data="{DynamicResource EyeHiddenGeometry}"
                                                                          Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="1" Fill="Transparent"/>
                                                                </Grid>
                                                            </Viewbox>
                                                        </Button>
                                                        <Button x:Name="copyUsernameButton" Style="{DynamicResource IconCopyButtonStyle}" Margin="4,0,0,0"
                                                                Tag="{Binding Username}" Click="CopyButton_Click"
                                                                ui:ButtonTip.Text="复制">
                                                            <Path Data="{DynamicResource CopyIconGeometry}"
                                                                  Stroke="{DynamicResource TextDisabledBrush}"
                                                                  StrokeThickness="1.15"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  Fill="Transparent"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="密码 " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="passwordText" Text="{Binding Password}" FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock x:Name="maskedPasswordText" Text="{Binding MaskedPassword}" FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                        <!-- 显示/隐藏（只管密码那一列） -->
                                                        <Button Style="{DynamicResource IconCopyButtonStyle}" Margin="4,0,0,0" Tag="{Binding Id}"
                                                                Click="TogglePasswordButton_Click" ui:ButtonTip.Text="显示/隐藏">
                                                            <Viewbox Width="12" Height="12">
                                                                <Grid Width="12" Height="12">
                                                                    <!-- 睁眼：账号/密码可见。图标反映的是「当前状态」，不是点击动作 -->
                                                                    <Path Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                          Data="{DynamicResource EyeVisibleGeometry}"
                                                                          Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="1" Fill="Transparent"/>
                                                                    <!-- 睁眼 + 斜线：账号/密码隐藏 -->
                                                                    <Path Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                                          Data="{DynamicResource EyeHiddenGeometry}"
                                                                          Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="1" Fill="Transparent"/>
                                                                </Grid>
                                                            </Viewbox>
                                                        </Button>
                                                        <Button x:Name="copyPasswordButton" Style="{DynamicResource IconCopyButtonStyle}" Margin="4,0,0,0"
                                                                Tag="{Binding Password}" Click="CopyButton_Click"
                                                                ui:ButtonTip.Text="复制">
                                                            <Path Data="{DynamicResource CopyIconGeometry}"
                                                                  Stroke="{DynamicResource TextDisabledBrush}"
                                                                  StrokeThickness="1.15"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  Fill="Transparent"/>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- ⑤ 操作按钮（外层 Grid 用来叠「右侧灰色区」这张底图） -->
                                            <Grid Grid.Column="2">
                                                <!-- 底层：从四角星右尖开始铺到卡片最右边的灰色区。
                                                     左端是一段弧（上下两端向右收、中间向左凸出，凸出点与星尖相接），
                                                     弧右侧是一块矩形，两块拼起来把卡片右侧整片铺满（上下也铺满卡片高度）。
                                                     它不占布局空间 —— 按钮们叠在它上面。 -->
                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      Margin="34,-10,-10,-10"
                                                      x:Name="pinnedMarkArcLayer">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="19.3"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Path x:Name="pinnedMarkArc"
                                                          Grid.Column="0"
                                                          Stretch="Fill"
                                                          Fill="{DynamicResource TextPrimaryBrush}"
                                                          Opacity="0.06"
                                                          Data="M 19.3,0 C 17.5,7.1 14.8,17.8 12.5,21.3 C 8.9,24.9 5.9,28.2 0,28.5 C 5.9,28.8 8.9,32 12.5,35.6 C 14.8,39.1 17.5,49.8 19,56.9 Z">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>

                                                    <Rectangle x:Name="pinnedMarkFill"
                                                               Grid.Column="1"
                                                               Fill="{DynamicResource TextPrimaryBrush}"
                                                               Opacity="0.06">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                </Grid>

                                                <!-- 按钮层：自己带 10px 右边距（原来在外层 Grid 上，
                                                     现在让给灰区撑到卡片边） -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <!-- 置顶 / 置底的标识：四角星 —— 上下左右四个尖角，
                                                     尖角之间是往内凹的弧线（不是直线连接）。
                                                     只在置顶或置底时显示；位置在登录按钮左侧、距它 100px。 -->
                                                <Path x:Name="pinnedMarkStar"
                                                      Width="32" Height="32"
                                                      Stretch="Uniform"
                                                      Fill="{DynamicResource TextPrimaryBrush}"
                                                      Opacity="0.06"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,100,0"
                                                      Data="M12 2 C12.5 7 17 11.5 22 12 C17 12.5 12.5 17 12 22 C11.5 17 7 12.5 2 12 C7 11.5 11.5 7 12 2 Z">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <Button x:Name="loginAccountButton" Style="{DynamicResource IconLoginButtonStyle}"
                                                        Margin="5,0,0,0" Tag="{Binding Id}" Click="LoginAccountButton_Click"/>
                                                <Button x:Name="removeFromGroupButton" Content="移出"
                                                        Style="{StaticResource CompactDangerButtonStyle}"
                                                        Margin="5,0,0,0" Tag="{Binding Id}" Click="RemoveFromGroupButton_Click"
                                                        Visibility="Collapsed"/>
                                                <!-- 移入模式：登录按钮换成选择框（点卡片任意处等效） -->
                                                <Button x:Name="moveSelectBoxButton" Style="{StaticResource MoveSelectBoxStyle}"
                                                        Margin="5,0,0,0" Tag="{Binding Id}" Click="MoveSelectBoxButton_Click"
                                                        Visibility="Collapsed"/>
                                                <!-- 移入模式：已经在目标分组里的账号，不给勾选框，明确标一下 -->
                                                <TextBlock x:Name="alreadyInGroupText" Text="已在分组" FontSize="12"
                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                           VerticalAlignment="Center" Margin="5,0,0,0"
                                                           Visibility="Collapsed"/>
                                            </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Path=IsInGroupMode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:AccountManagerView}}}" Value="False">
                                                <Setter TargetName="deleteAccountButton" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="removeFromGroupButton" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="loginAccountButton" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=IsInGroupMode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:AccountManagerView}}}" Value="True">
                                                <Setter TargetName="deleteAccountButton" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="removeFromGroupButton" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="loginAccountButton" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>

                                            <!-- 官服不显示服务器标签（ServerTag 返回空串，默认就是官服没必要标） -->
                                            <DataTrigger Binding="{Binding ServerTag}" Value="">
                                                <Setter TargetName="serverTagBorder" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <!-- 非官服（国际服 / 渠道服）没有一键登录，只能手动复制。
                                                 声明在 IsInGroupMode 之后 → 主列表与分组内都生效。 -->
                                            <DataTrigger Binding="{Binding CanLogin}" Value="False">
                                                <Setter TargetName="loginAccountButton" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <!-- 移入模式：常规操作全部收起，右侧只留「选择框」。
                                                 声明在 IsInGroupMode 之后，所以优先级更高。 -->
                                            <DataTrigger Binding="{Binding Path=IsMoveMode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:AccountManagerView}}}" Value="True">
                                                <Setter TargetName="deleteAccountButton" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="removeFromGroupButton" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="loginAccountButton" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="editAccountButton" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="moveSelectBoxButton" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>

                                            <!-- 已经在目标分组里的账号：不给选择框，改显示「已在分组」 -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=IsMoveMode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:AccountManagerView}}}" Value="True"/>
                                                    <Condition Binding="{Binding IsMoveable}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="moveSelectBoxButton" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="alreadyInGroupText" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 模态框遮罩层 -->
        <Border x:Name="modalOverlay" Background="#000000" Opacity="0.5" Visibility="Collapsed" Panel.ZIndex="1000"/>

        <!-- 账号删除确认模态框 -->
        <Border x:Name="deleteModal" Width="340" Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="10" Panel.ZIndex="1001"
                Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="3" Direction="315" Color="#1A000000" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>
            <Border.Resources>
                <Storyboard x:Key="FadeInAnimation">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.95" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                </Storyboard>
                <Storyboard x:Key="FadeOutAnimation">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="0.95" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="0.95" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                </Storyboard>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <!-- Auto：高度跟着内容走。原来弹窗是固定 220 高，内容只有两行字，
                         下面空出一大片，看着比编辑窗口还大。 -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource DialogHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                    <TextBlock Text="确认删除账号" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Row="1" Margin="20,16,20,14">
                    <TextBlock x:Name="deleteConfirmText" Text="确定要删除此账号吗？此操作无法撤销。" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,10"/>
                    <TextBlock Text="删除后，账号将被永久删除，无法恢复。" FontSize="12" Foreground="{DynamicResource TextDisabledBrush}"
                               TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
                <Border Grid.Row="2" Background="{DynamicResource DialogHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="confirmDeleteButton" MinWidth="80" Height="30" Margin="0,0,8,0" Padding="10,0"
                                    Style="{DynamicResource SettingsButtonStyleRound6}" Click="ConfirmDeleteButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" Foreground="{DynamicResource TagGreenFgBrush}" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="确认删除" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="cancelDeleteButton" MinWidth="80" Height="30" Padding="10,0"
                                    Style="{DynamicResource SettingsButtonStyleRound6}" Click="CancelDeleteButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕" Foreground="{DynamicResource TagRedFgBrush}" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="取消" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 移出分组确认模态框 -->
        <Border x:Name="removeFromGroupModal" Width="340" Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="10" Panel.ZIndex="1002"
                Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="3" Direction="315" Color="#1A000000" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>
            <Border.Resources>
                <Storyboard x:Key="FadeInAnimation">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.95" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                </Storyboard>
                <Storyboard x:Key="FadeOutAnimation">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="0.95" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="0.95" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                </Storyboard>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <!-- Auto：高度跟着内容走。原来弹窗是固定 220 高，内容只有两行字，
                         下面空出一大片，看着比编辑窗口还大。 -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource DialogHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                    <TextBlock x:Name="removeFromGroupModalTitle" Text="确认移出账号" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Row="1" Margin="20,16,20,14">
                    <TextBlock x:Name="removeFromGroupConfirmText" Text="确定要将账号移出此分组吗？" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,10"/>
                    <TextBlock x:Name="removeFromGroupExtraText" Text="移出后，账号仍会保留在账号列表中，但不再属于此分组。"
                               FontSize="12" Foreground="{DynamicResource TextDisabledBrush}" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
                <Border Grid.Row="2" Background="{DynamicResource DialogHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="confirmRemoveFromGroupButton" MinWidth="80" Height="30" Margin="0,0,8,0" Padding="10,0"
                                    Style="{DynamicResource SettingsButtonStyleRound6}" Click="ConfirmRemoveFromGroupButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" Foreground="{DynamicResource TagGreenFgBrush}" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="确认移出" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="cancelRemoveFromGroupButton" MinWidth="80" Height="30" Padding="10,0"
                                    Style="{DynamicResource SettingsButtonStyleRound6}" Click="CancelRemoveFromGroupButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕" Foreground="{DynamicResource TagRedFgBrush}" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="取消" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 分组删除确认模态框 -->
        <Border x:Name="deleteGroupModal" Width="340" Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="10" Panel.ZIndex="1003"
                Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="3" Direction="315" Color="#1A000000" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>
            <Border.Resources>
                <Storyboard x:Key="FadeInAnimation">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.95" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                </Storyboard>
                <Storyboard x:Key="FadeOutAnimation">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="0.95" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="0.95" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                </Storyboard>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <!-- Auto：高度跟着内容走。原来弹窗是固定 220 高，内容只有两行字，
                         下面空出一大片，看着比编辑窗口还大。 -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource DialogHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                    <TextBlock Text="确认删除分组" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Row="1" Margin="20,16,20,14">
                    <TextBlock x:Name="deleteGroupConfirmText" Text="确定要删除此分组吗？此操作无法撤销。" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,10"/>
                    <TextBlock Text="删除后，分组将被永久删除，但分组内的账号不会被删除。" FontSize="12" Foreground="{DynamicResource TextDisabledBrush}"
                               TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
                <Border Grid.Row="2" Background="{DynamicResource DialogHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="confirmDeleteGroupButton" MinWidth="80" Height="30" Margin="0,0,8,0" Padding="10,0"
                                    Style="{DynamicResource SettingsButtonStyleRound6}" Click="ConfirmDeleteGroupButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" Foreground="{DynamicResource TagGreenFgBrush}" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="确认删除" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="cancelDeleteGroupButton" MinWidth="80" Height="30" Padding="10,0"
                                    Style="{DynamicResource SettingsButtonStyleRound6}" Click="CancelDeleteGroupButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕" Foreground="{DynamicResource TagRedFgBrush}" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="取消" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 清除置底确认模态框 -->
        <Border x:Name="clearMarksModal" Width="340" Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="10" Panel.ZIndex="1004"
                Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="3" Direction="315" Color="#1A000000" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>
            <Border.Resources>
                <Storyboard x:Key="FadeInAnimation">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.95" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                </Storyboard>
                <Storyboard x:Key="FadeOutAnimation">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="0.95" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="0.95" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                </Storyboard>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <!-- Auto：高度跟着内容走。原来弹窗是固定 220 高，内容只有两行字，
                         下面空出一大片，看着比编辑窗口还大。 -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource DialogHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                    <TextBlock Text="确认清除置底" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Row="1" Margin="20,16,20,14">
                    <TextBlock x:Name="clearMarksConfirmText" Text="确定要清除此分组中的所有置底吗？" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,10"/>
                    <TextBlock x:Name="clearMarksExtraText" Text="清除后，该分组中所有已置底的账号将恢复为未置底状态。"
                               FontSize="12" Foreground="{DynamicResource TextDisabledBrush}" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
                <Border Grid.Row="2" Background="{DynamicResource DialogHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="confirmClearMarksButton" MinWidth="80" Height="30" Margin="0,0,8,0" Padding="10,0"
                                    Style="{DynamicResource SettingsButtonStyleRound6}" Click="ConfirmClearMarksButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" Foreground="{DynamicResource TagGreenFgBrush}" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="确认清除" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="cancelClearMarksButton" MinWidth="80" Height="30" Padding="10,0"
                                    Style="{DynamicResource SettingsButtonStyleRound6}" Click="CancelClearMarksButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕" Foreground="{DynamicResource TagRedFgBrush}" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="取消" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 登录确认模态框容器（仅保留界面，实际登录窗口以对话框形式弹出） -->
        <Border x:Name="loginModalContainer" 
        Background="{DynamicResource CardBackgroundBrush}" 
        CornerRadius="8" 
        Panel.ZIndex="1005"
        Visibility="Collapsed" 
        HorizontalAlignment="Center" 
        VerticalAlignment="Center" 
        Opacity="0"
        RenderTransformOrigin="0.5,0.5" Cursor="Hand">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="3" Direction="315" Color="#1A000000" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>
            <Border.Resources>
                <Storyboard x:Key="FadeInAnimation">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.95" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                </Storyboard>
                <Storyboard x:Key="FadeOutAnimation">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="0.95" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="0.95" Duration="0:0:0.15" EasingFunction="{StaticResource QuadEaseOut}"/>
                </Storyboard>
            </Border.Resources>

            <!-- 在此处动态添加 LoginConfirmControl -->
            <ContentControl x:Name="loginModalContent"/>
        </Border>
    </Grid>
</UserControl>
