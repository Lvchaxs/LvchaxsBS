<Page x:Class="LvchaxsBS_Macro.Views.MacroScriptEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent"
      Tag="FullScreen">

    <!--
        ★ Tag="FullScreen" 是给**宿主**配置容器页看的信号（字符串约定，不引用宿主类型）：
          容器页收到后会把顶部那张 70 高的功能信息卡 Collapse、内容区边距归零
          ⇒ 本页直接顶到标题栏下面、占满整个窗口剩余空间。
    -->

    <!--
        宏指令编辑页（照 D:\C#\LvchaxsBS_MacroEditor_WebSim\index.html 的「行号代码页」做的）：
        顶栏（返回列表 / 宏名 / 保存）+ 下面一整块「行号列 + 代码编辑区」。
        ★ 等宽字体、行号与代码同字体同字号 ⇒ 自然行高一致；滚动时行号列用 TranslateTransform 跟着走。
        ★ 行号列装在 Canvas 里（Canvas 不压子元素高度），否则只画得出可视的 21 行。
        ★ 语法高亮（WebSim 里的 tok-*）这轮先不做，纯文本编辑。
    -->
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶栏 ============ -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Content="返回列表"
                        Style="{DynamicResource FlatButtonStyleRound6}"
                        Height="28" Padding="12,0"
                        FontSize="12"
                        ToolTip="回到宏列表"
                        Click="BackButton_Click"/>

                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Text="指令编辑"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Content="保存"
                        Style="{DynamicResource SettingsButtonStyleRound6}"
                        Height="28" MinWidth="64"
                        FontSize="12"
                        ToolTip="保存指令（Ctrl+S）"
                        Click="SaveButton_Click"/>
            </Grid>
        </Border>

        <!-- ============ 代码区：行号列 + 编辑框（撑满剩余全部高度） ============ -->
        <Border Grid.Row="1"
                Margin="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ 编辑区（行号 | 灰线 | 代码） ============ -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <!-- ★ 三列必须全定义：行号列 / 1px 灰线 / 代码区（漏一列元素就会被挤到错误位置） -->
                        <ColumnDefinition Width="Auto"/>   <!-- 行号列 -->
                        <ColumnDefinition Width="1"/>      <!-- 灰线 -->
                        <ColumnDefinition Width="*"/>      <!-- 代码区 -->
                    </Grid.ColumnDefinitions>

                    <!-- 行号列（min-width 46、右对齐、随编辑区竖向滚动平移 —— 同 WebSim 的 sticky ln）
                     ★★ 必须放在 Canvas 里：Canvas 用子元素 DesiredSize 排列（不约束高度），
                        TextBlock 才能拿到**全部行的高度**；直接放 Border/Grid 里会被压成可视高度
                        （只画出 21 行，往下滚也出不来 22、23…）。 -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            MinWidth="46"
                            ClipToBounds="True">
                        <Canvas x:Name="LineNumbersCanvas">
                            <!-- Canvas.Top=8 与编辑区 Padding 的上边 8 对齐（两边行高才同起点） -->
                            <TextBlock x:Name="LineNumbers"
                                       Canvas.Top="8"
                                       Canvas.Right="10"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       TextAlignment="Right"
                                       Foreground="{DynamicResource TextDisabledBrush}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="LineNumbersShift" Y="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </Border>

                    <!-- 分隔线：行号列与代码区之间的一条灰线（1px 竖线，通到顶/底） -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource BorderBrush}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <!-- 代码区：高亮层（下） + 编辑层（上，文字透明） -->
                    <Grid Grid.Column="2">

                        <!-- ① 高亮层：显示**着色**后的文本，不接收输入。
                             ★ 放在 Canvas 里（不压高度）⇒ 行数再多也画得出来；
                             ★ Canvas.Left/Top = 12/8，与编辑层 Padding 完全对齐（否则文字会重影）。 -->
                        <Canvas x:Name="HighlightCanvas" IsHitTestVisible="False">
                            <TextBlock x:Name="Highlight"
                                       Canvas.Left="12"
                                       Canvas.Top="8"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       TextWrapping="NoWrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="HighlightShift" X="0" Y="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>

                        <!-- ② 编辑层：文字设成透明（颜色交给高亮层），只留光标与选区。
                             ★ 行高不用显式设 —— TextBox 不支持 LineHeight，让行号列和它一样
                               用 Consolas 13 的**自然行高**（同字体同字号 ⇒ 行高必然一致）。 -->
                        <TextBox x:Name="Editor"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 Padding="12,8,16,8"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="Transparent"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextChanged="Editor_TextChanged"
                                 KeyDown="Editor_KeyDown"
                                 SelectionChanged="Editor_SelectionChanged"/>
                        </Grid>
                    </Grid>

                    <!-- ============ 底部状态条：左边报错、右边行列与指令数 ============ -->
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="10,5"
                            Background="Transparent">
                        <Grid>
                            <TextBlock x:Name="ErrorText"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left"
                                       Margin="0,0,12,0"/>

                            <TextBlock x:Name="StatusText"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
</Page>
