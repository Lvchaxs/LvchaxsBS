<Page x:Class="LvchaxsBS_Macro.Views.MacroKeyPickerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="触发键"
      Background="Transparent">

    <!--
        ★ 给**一条宏**绑触发键的页面。
          载体是宿主那张键盘网格（TriggerKeyPage），由 HostKeyPicker 反射借来 ——
          所以观感和「快速切图给地区绑键」完全一样：点一下某个键就选中、自动返回。
        ★ 已被**别的宏**占用的键在宿主那边是「灰底 + 红字 + 按钮底部写占用者名字」——
          2026-10-22 起宏之间允许共用同一个触发键，所以这些键**可点**（不再禁选）。
    -->
    <Grid Margin="5,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶行：左边胶囊（宏名 + 当前键）+ 提示，右边「返回」 -->
        <Grid Grid.Row="0" Margin="0,9,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="8,0,0,0">
                <!-- 胶囊：和宏列表顶部统计条同一套（Hover 底 + 细边 + 圆角 5） -->
                <Border Background="{DynamicResource HoverBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 胶囊里只放「宏名 + 当前键」，不再带「触发键」字样 -->
                        <TextBlock x:Name="MacroNameText"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="　当前："
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CurrentKeyText"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="HintText"
                           Text="点一下要用的键，选好自动返回（红色键已被其他宏占用，可以共用）"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{DynamicResource FlatButtonStyleRound6}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    Height="28" Padding="12,0" MinWidth="64" FontSize="11"
                    Margin="0,0,8,0"
                    Click="BackButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 14,6 L 6,12 L 14,18"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="14" Height="14" Stretch="Uniform"
                          Margin="0,0,4,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="返回" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 键盘网格：宿主的 TriggerKeyPage 挂在这里 -->
        <Frame x:Name="PickerHost"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               BorderThickness="0"
               Background="Transparent"
               Focusable="False"/>
    </Grid>
</Page>
