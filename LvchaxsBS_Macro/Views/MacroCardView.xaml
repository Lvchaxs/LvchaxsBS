<UserControl x:Class="LvchaxsBS_Macro.Views.MacroCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:LvchaxsBS_Macro.Controls"
             mc:Ignorable="d"
             d:DesignHeight="22" d:DesignWidth="320">

    <!--
        ★★ 这个控件是**首页卡片的第二行**，不是整张卡片：
           卡片外框、图标、标题「自定义宏」、右侧的触发键/配置/胶囊开关，全部由**宿主**卡片模板提供
           （这样它才能像其它功能一样拖动排序、走同一套触发键和配置页）。
        这里只放两个下拉：宏名称 / 触发方式。
    -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

        <!-- 第一个列表：自定义宏名称 -->
        <controls:MacroDropDown x:Name="MacroNameSelect"
                                Width="112" Height="22"
                                SelectedIndex="0"
                                ToolTip="自定义宏名称"
                                SelectionChanged="MacroNameSelect_SelectionChanged"/>

        <!-- 第二个列表：触发方式 -->
        <controls:MacroDropDown x:Name="TriggerModeSelect"
                                Width="176" Height="22" Margin="6,0,0,0"
                                SelectedIndex="0"
                                ToolTip="触发方式"
                                SelectionChanged="TriggerModeSelect_SelectionChanged"/>

        <!-- 第三个列表：生效范围 -->
        <controls:MacroDropDown x:Name="ScopeSelect"
                                Width="104" Height="22" Margin="6,0,0,0"
                                SelectedIndex="0"
                                ToolTip="生效范围"
                                SelectionChanged="ScopeSelect_SelectionChanged"/>
    </StackPanel>
</UserControl>
