<Window x:Class="LvchaxsBS_Macro.Views.MacroEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:LvchaxsBS_Macro.Controls"
        mc:Ignorable="d"
        Title="自定义宏"
        Width="337" Height="268"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">

    <!--
        ★ 样式和 UID 的「新建/编辑分组」窗口一个路子（无边框 + 圆角 + 阴影 + 标题条 + 底部按钮条），
          但控件一律用**宿主**的 keyed 样式 / 主题画刷（DynamicResource），深浅主题自动跟随。
    -->
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="#1F000000" Direction="315" ShadowDepth="3" Opacity="0.1" BlurRadius="10"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- 标题条（按住可拖动窗口） -->
            <Border Grid.Row="0"
                    Background="{DynamicResource DialogHeaderBackgroundBrush}"
                    CornerRadius="10,10,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 标题前的矢量 </> 图标 -->
                        <controls:MacroGlyph Width="18" Height="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="WindowTitle" Text="新建宏"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Width="262">

                    <TextBlock Text="宏名称" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4"/>

                    <Grid>
                        <TextBox x:Name="NameTextBox"
                                 Style="{DynamicResource PublicTextBoxStyle}"
                                 Height="32" Padding="8,0"
                                 TextChanged="Input_TextChanged"/>
                        <TextBlock x:Name="NameWatermark" Text="请输入宏名称"
                                   VerticalAlignment="Center" Margin="9,0"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <TextBlock Text="宏描述" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,10,0,4"/>

                    <Grid>
                        <TextBox x:Name="DescTextBox"
                                 Style="{DynamicResource PublicTextBoxStyle}"
                                 Height="32" Padding="8,0"
                                 TextChanged="Input_TextChanged"/>
                        <TextBlock x:Name="DescWatermark" Text="可填可不填"
                                   VerticalAlignment="Center" Margin="9,0"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <TextBlock x:Name="ErrorText" Text=""
                               FontSize="11"
                               Foreground="{DynamicResource DangerBrush}"
                               Margin="0,6,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- 按钮条 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource DialogHeaderBackgroundBrush}"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="SaveButton"
                            Style="{DynamicResource SettingsButtonStyleRound6}"
                            MinWidth="80" Height="30" Margin="0,0,8,0"
                            Click="SaveButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TagGreenFgBrush}"
                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="保存" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton"
                            Style="{DynamicResource SettingsButtonStyleRound6}"
                            MinWidth="80" Height="30"
                            Content="取消"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
