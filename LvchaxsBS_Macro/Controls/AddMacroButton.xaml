<UserControl x:Class="LvchaxsBS_Macro.Controls.AddMacroButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:LvchaxsBS_Macro.Controls"
             mc:Ignorable="d"
             d:DesignHeight="28" d:DesignWidth="86">

    <!--
        ★ 宿主配置容器页底部按钮条的**第一个**按钮：
          「添加宏 / 触发键 / 配置 / 返回 / 开关」
        ★ 外观照抄旁边那几个按钮（FlatButtonStyleRound6 + 28 高 + 11 号字），
          只是内容多了个矢量 </> 图标，所以用 MinWidth 而不是固定 50。
    -->
    <Button x:Name="AddButton"
            MinWidth="78" Height="28" Padding="10,0"
            Style="{DynamicResource FlatButtonStyleRound6}"
            Background="{DynamicResource CardBackgroundBrush}"
            Foreground="{DynamicResource TextSecondaryBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            ToolTip="新建一个自定义宏"
            Click="AddButton_Click">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <controls:MacroGlyph Width="16" Height="11"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="添加宏" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
</UserControl>
