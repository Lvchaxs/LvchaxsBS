<UserControl x:Class="LvchaxsBS_Macro.Controls.MacroDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="22" d:DesignWidth="130"
             x:Name="RootControl">

    <!--
        ★ 主程序里**没有** ComboBox 样式：所有下拉都是「按钮 + Popup」这套（DropDownSelect）。
          本 dll 不引用宿主（铁律），所以在这里做一份等价实现，
          但样式直接复用宿主的 keyed 样式 —— DynamicResource 运行期会查到 App.Resources。
    -->
    <Button x:Name="PART_MainButton"
            Style="{DynamicResource SimpleDropDownButtonStyle}"
            Click="MainButton_Click">
        <TextBlock x:Name="PART_SelectedText" VerticalAlignment="Center"/>
    </Button>
</UserControl>
