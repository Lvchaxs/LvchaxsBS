<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			共享基础库：既把 Resources 下的图片打包进 dll（g.resources），也承载"图像识别能力"代码
			（坐标管理 / 模板加载 / 截图 / 匹配 / 模拟输入 / 窗口跟踪 / 资源定位）。
			宿主 LvchaxsBS.exe 与 UID 模块都**编译期引用**本工程，用同一套 API：

			    图片：pack://application:,,,/LvchaxsBS_Resources;component/Resources/Images/图标/xxx.png
			          或者用 AssetLocator.Pack / Load / ListFileNames
			    识别：CoordinateFormats / TemplateManager / ImageRecognition / SimulationService

			★ 自 2026-10-12 起它**不再是可以随便删掉的可选组件**：宿主编译期引用了这里的类型，
			  dll 缺失会导致主程序启动即崩（原先"删掉 dll 也能跑、只是图空白"的特性已取消）。
		-->
		<OutputType>Library</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<AssemblyName>LvchaxsBS_Resources</AssemblyName>
		<RootNamespace>LvchaxsBS_Resources</RootNamespace>

		<!-- 与宿主 LvchaxsBS.csproj 保持一致，免得同一份代码在两个工程里报不同的警告 -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- ImageRecognition 的像素处理里有 unsafe 块 -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<Version>1.0.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

		<!-- 与仓库根目录的 LICENSE 保持一致 -->
		<Copyright>Copyright (C) 2026 Lvchaxs</Copyright>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<!-- 图像识别 / 模板加载用 System.Drawing 的 Bitmap（与宿主同版本） -->
		<PackageReference Include="System.Drawing.Common" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!--
			全部用通配符包含：往 Resources 下新增图片（无论是 UI 图标还是识别模板）
			直接放进去即可，不需要改这个工程文件，也不需要重新分类。

			★ 注意：增量构建是按"输入文件时间 vs 上次输出时间"判断的。
			  如果新加进来的是修改时间较早的老文件（比如从别处剪切过来的），
			  构建会认为"没变化"而跳过打包，表现为运行时图还是旧的。
			  遇到这种情况执行一次 Rebuild：
			      dotnet build LvchaxsBS_Resources.csproj -t:Rebuild
		-->
		<None Remove="Resources\**" />
		<Resource Include="Resources\**\*.png" />
		<Resource Include="Resources\**\*.ico" />
		<Resource Include="Resources\**\*.jpg" />
		<Resource Include="Resources\**\*.jpeg" />
		<Resource Include="Resources\**\*.bmp" />
		<Resource Include="Resources\**\*.gif" />
		<!-- 数据文件（角色→元素对照表等）也一起打包 -->
		<Resource Include="Resources\**\*.json" />
		<Resource Include="Resources\**\*.txt" />
	</ItemGroup>

	<!--
		编译完成后把 dll 复制到宿主 LvchaxsBS 的输出目录（宿主已通过 ProjectReference 引用本工程，
		正常情况下 MSBuild 自己就会复制；这里再兜一次，方便单独 build 本工程时也把文件送过去）。
	-->
	<Target Name="CopyToHost" AfterTargets="Build">
		<PropertyGroup>
			<HostBinDir>$(MSBuildThisFileDirectory)..\LvchaxsBS\bin\$(Configuration)\net8.0-windows\</HostBinDir>
		</PropertyGroup>
		<ItemGroup>
			<PluginArtifacts Include="$(TargetPath)" />
			<PluginArtifacts Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
		</ItemGroup>
		<Copy SourceFiles="@(PluginArtifacts)"
		      DestinationFolder="$(HostBinDir)"
		      SkipUnchangedFiles="true"
		      Condition="Exists('$(HostBinDir)')" />
	</Target>

</Project>
